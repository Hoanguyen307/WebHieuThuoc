@{
    ViewBag.Title = "Kết quả thanh toán";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">

<style>
    /* Card kết quả thanh toán */
    .payment-result-card {
        border-radius: 15px;
        padding: 40px 30px;
        box-shadow: 0 8px 25px rgba(0,0,0,0.08);
        background: #f0fcff; /* xanh nhạt thanh khiết cho web hiệu thuốc */
        transition: transform 0.3s;
    }

        .payment-result-card:hover {
            transform: translateY(-5px);
        }

        .payment-result-card.success {
            border-left: 6px solid #28a745; /* xanh lá thành công */
        }

        .payment-result-card.failed {
            border-left: 6px solid #dc3545; /* đỏ thất bại */
        }

        .payment-result-card .icon {
            font-size: 60px;
            margin-bottom: 20px;
        }

        .payment-result-card h2 {
            font-weight: 600;
        }

        .payment-result-card p {
            font-size: 1.1rem;
        }

    .breadcrumb a {
        text-decoration: none;
    }

    .btn-primary {
        background-color: #17a2b8; /* xanh dược phẩm */
        border-color: #17a2b8;
    }

        .btn-primary:hover {
            background-color: #138496;
            border-color: #117a8b;
        }
</style>

<div class="container my-5">
    <!-- Breadcrumbs -->
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb bg-light p-2 rounded">
            <li class="breadcrumb-item"><a href="/">Home</a></li>
            <li class="breadcrumb-item active" aria-current="page">Kết quả thanh toán</li>
        </ol>
    </nav>

    <div class="row justify-content-center">
        <div class="col-md-7">
            <div class="payment-result-card @(ViewBag.IsSuccess ? "success" : "failed") text-center">

                <div class="icon">
                    @(ViewBag.IsSuccess ? "💊" : "⚠️")
                </div>

                <h2 class="mb-3">Kết quả thanh toán</h2>

                <p class="fw-semibold mb-3">@ViewBag.Message</p>

                @if (ViewBag.IsSuccess == true)
                {
                    <p class="fw-bold">Số tiền: <span class="text-primary">@ViewBag.Amount</span></p>
                    <p class="fw-bold">Mã đơn hàng: <span class="text-primary">@ViewBag.OrderCode</span></p>
                }

                <p class="text-muted mt-4">
                    Bạn sẽ được chuyển về <a href="/" class="text-decoration-underline">trang chủ</a> sau <span id="seconds">5</span> giây...
                </p>

                <a href="/" class="btn btn-primary btn-lg mt-3 px-5">Quay lại trang chủ ngay</a>
            </div>
        </div>
    </div>
</div>

<script>
    let seconds = 5;
    const countdownEl = document.getElementById("seconds");

    const interval = setInterval(() => {
        seconds--;
        countdownEl.textContent = seconds;
        if (seconds <= 0) {
            clearInterval(interval);
            window.location.href = "/";
        }
    }, 1000);
</script>
