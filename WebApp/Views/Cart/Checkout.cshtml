@model Models.CheckoutViewModel
@{
    ViewBag.Title = "Thanh toán";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container my-5">
    <h2 class="mb-4">Thanh toán</h2>
    <form id="checkoutForm" method="post" action="/Cart/Checkout">
        <div class="row">
            <!-- BÊN TRÁI: Danh sách sản phẩm -->
            <div class="col-md-8">
                <div class="card shadow-sm mb-3">
                    <div class="card-header bg-light">
                        <h5 class="mb-0">Sản phẩm trong giỏ</h5>
                    </div>
                    <div class="card-body">
                        @foreach (var item in Model.CartItems)
                        {
                            <div class="d-flex justify-content-between align-items-center border-bottom py-2">
                                <div class="d-flex align-items-center">
                                    <img src="@item.ProductImage"
                                         class="me-3"
                                         width="125" />
                                    <div style="width: 550px; padding-right: 25px;">
                                        <strong>@item.ProductName</strong><br />
                                        SL: @item.Quantity

                                    </div>
                                </div>
                                <div style="width: 120px;">
                                    <strong>
                                        @string.Format(System.Globalization.CultureInfo.GetCultureInfo("vi-VN"), "{0:N0} đ", item.Quantity * item.UnitPrice)
                                    </strong>

                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- BÊN PHẢI: Thông tin đơn hàng -->
            <div class="col-md-4">
                <!-- Địa chỉ giao hàng -->
                <div class="card shadow-sm mb-3">
                    <div class="card-header bg-light d-flex justify-content-between align-items-center">
                        <h5 class="mb-0">Chọn địa chỉ nhận hàng</h5>
                        <button type="button" class="btn btn-outline-primary btn-sm" onclick="LoadForm()">
                            <i class="fas fa-plus"></i>
                            Thêm địa chỉ
                        </button>
                    </div>
                    <div class="list-group list-group-flush">
                        @foreach (var addr in Model.Addresses)
                        {
                            <label class="list-group-item d-flex align-items-start">
                                <input class="form-check-input me-2 mt-1" type="radio" name="SelectedAddressId"
                                       value="@addr.DiaChiId" @(addr.MacDinh ? "checked" : "") />

                                <div class="flex-grow-1">
                                    <div class="d-flex justify-content-between">
                                        <div>
                                            <strong>@addr.TenNguoiNhan</strong>
                                            <span class="text-muted ms-2">(@addr.SoDienThoai)</span>
                                        </div>
                                        <div class="btn-group">
                                            <button type="button"
                                                    onclick="handleFormUpdateDanhMuc(@addr.DiaChiId)"
                                                    class="btn btn-sm btn-link text-primary">
                                                <i class="fas fa-edit"></i>
                                            </button>
                                            <button type="button"
                                                    onclick="handleDelete(@addr.DiaChiId)"
                                                    class="btn btn-sm btn-link text-danger">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        </div>
                                    </div>
                                    <div>@addr.DiaChiChiTiet</div>
                                    @if (addr.MacDinh)
                                    {
                                        <span class="badge bg-danger mt-1">Mặc định</span>
                                    }
                                </div>
                            </label>
                        }
                    </div>
                </div>


                <input type="hidden" name="VnPayType" value="0" />
                <!-- Phương thức thanh toán -->
                <div class="card shadow-sm mb-3">
                    <div class="card-header bg-light">
                        <h5 class="mb-0">Phương thức thanh toán</h5>
                    </div>
                    <div class="card-body">
                        @foreach (var pm in Model.PaymentMethods)
                        {
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="SelectedPaymentMethod" value="@pm.Code" @(pm.Code == Model.SelectedPaymentMethod ? "checked" : "") />
                                <label class="form-check-label">@pm.Name</label>
                            </div>
                        }
                    </div>
                </div>

                <!-- Sử dụng điểm thưởng -->
                <div class="card shadow-sm mb-3">
                    <div class="card-header bg-light">
                        <h5 class="mb-0">Điểm thưởng</h5>
                    </div>
                    <div class="card-body">
                        <p>Bạn hiện có: <strong id="availablePoints">@(Model.CurrentPoints > 0 ? Model.CurrentPoints : 0)</strong> điểm</p>
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" name="UsePoints" value="true" id="chkUsePoints" />
                            <label class="form-check-label" for="chkUsePoints">Sử dụng điểm để giảm giá</label>
                        </div>
                        <!-- Ẩn input, chỉ dùng để submit về server -->
                        <input type="hidden" name="PointsToUse" id="PointsToUse" value="0" />
                    </div>
                </div>
                <!-- Ghi chú đơn hàng -->
                <div class="card shadow-sm mb-3">
                    <div class="card-header bg-light">
                        <h5 class="mb-0">Ghi chú</h5>
                    </div>
                    <div class="card-body">
                        <textarea name="Note" class="form-control" placeholder="Nhập ghi chú nếu có">@Model.Note</textarea>
                    </div>
                </div>

                <!-- Voucher + Tổng tiền -->
                <div class="card shadow-sm">
                    <div class="card-header bg-light">
                        <h5 class="mb-0">Tóm tắt đơn hàng</h5>
                    </div>
                    <div class="card-body">
                        <div class="mb-3">
                            <label class="form-label">Mã giảm giá</label>
                            <select id="voucherSelect" name="SelectedVoucherId" class="form-select">
                                <option value="">-- Chọn voucher --</option>
                                @foreach (var voucher in Model.Vouchers)
                                {
                                    <option value="@voucher.VoucherCustomerId"
                                            data-discount-type="@voucher.Percentage"
                                            data-discount-value="@voucher.DiscountValue">

                                        @voucher.Code -
                                        @if (voucher.Percentage.Equals("Percentage", StringComparison.OrdinalIgnoreCase))
                                        {
                                            <text>Giảm @(string.Format("{0:N0}", voucher.DiscountValue))%</text>
                                        }
                                        else
                                        {
                                            <text>Giảm @(string.Format("{0:N0}", voucher.DiscountValue))₫</text>
                                        }
                                    </option>
                                }
                            </select>

                        </div>
                        <hr />
                        <div class="d-flex justify-content-between mb-2">
                            <span>Tạm tính:</span>
                            <span class="tam-tinh" data-subtotal="@Model.SubTotal">@Model.SubTotal.ToString("N0") ₫</span>
                        </div>
                        <div class="d-flex justify-content-between mb-2">
                            <span>Giảm giá:</span>
                            <span class="giam-gia">0 ₫</span>
                        </div>
                        <div class="d-flex justify-content-between font-weight-bold">
                            <span>Tổng tiền:</span>
                            <span class="tong-tien">@Model.SubTotal.ToString("N0") ₫</span>
                        </div>
                        <input type="hidden" name="FinalTotal" id="hiddenFinalTotal" value="0" />
                        <button id="btnPlaceOrder" type="submit" class="btn w-100 mt-3" style="background-color: #a1efab">
                            <span class="spinner-border spinner-border-sm me-2 d-none" role="status" aria-hidden="true"></span>
                            <span class="btn-text">Đặt hàng</span>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

<!-- Modal thêm địa chỉ -->
<div class="modal fade" id="modalDiaChi" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalDiaChiTitle">Thêm/Sửa địa chỉ</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" style="color: black">
                <!-- Nội dung form sẽ load ở đây -->
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
    var timer = 0;
    function formatCurrency(value) {
        return Math.round(value).toLocaleString("vi-VN") + " ₫";
    }

    document.addEventListener("DOMContentLoaded", function () {
        var orderSuccess = '@(ViewBag.OrderSuccess != null && (bool)ViewBag.OrderSuccess == true ? "true" : "false")';

        if (orderSuccess === "true") {
            Swal.fire({
                title: "🎉 Đặt hàng thành công!",
                text: "Cảm ơn bạn đã mua sắm 💖",
                icon: "success",
                showConfirmButton: false,
                timer: 3000
            }).then(function() {
                window.location.href = '@Url.Action("Index", "Home1")';
            });
        }

        const chkUsePoints = document.getElementById("chkUsePoints");
        const pointsHiddenInput = document.getElementById("PointsToUse");
        const voucherSelect = document.getElementById("voucherSelect");
        const subtotalElem = document.querySelector(".tam-tinh");
        const discountElem = document.querySelector(".giam-gia");
        const totalElem = document.querySelector(".tong-tien");

        if (subtotalElem) {
            const subtotalBase = parseInt(subtotalElem.getAttribute("data-subtotal")) || 0;
            const availablePoints = parseInt(document.getElementById("availablePoints")?.textContent) || 0;

            function calculateTotal() {
                let totalDiscount = 0;

                // Điểm thưởng
                if (chkUsePoints && chkUsePoints.checked) {
                    let maxPointsUsable = Math.min(availablePoints, subtotalBase);
                    pointsHiddenInput.value = maxPointsUsable;
                    totalDiscount += maxPointsUsable;
                } else if (pointsHiddenInput) {
                    pointsHiddenInput.value = 0;
                }

                // Voucher
                let selectedOption = voucherSelect.options[voucherSelect.selectedIndex];
                if (selectedOption && selectedOption.value) {
                    let discountType = selectedOption.dataset.discountType;
                    let discountValue = parseFloat(selectedOption.dataset.discountValue) || 0;

                    if (discountType === 'Percentage') {
                        totalDiscount += (subtotalBase * discountValue) / 100;
                    } else {
                        totalDiscount += discountValue;
                    }
                }

                if (totalDiscount > subtotalBase) totalDiscount = subtotalBase;
                let finalTotal = subtotalBase - totalDiscount;

                discountElem.textContent = "-" + formatCurrency(totalDiscount);
                totalElem.textContent = formatCurrency(finalTotal);
                document.getElementById("hiddenFinalTotal").value = finalTotal;
            }

            if (chkUsePoints) chkUsePoints.addEventListener("change", calculateTotal);
            if (voucherSelect) voucherSelect.addEventListener("change", calculateTotal);
            calculateTotal();
        }

        // --- PHẦN 4: HIỆU ỨNG NÚT ĐẶT HÀNG ---
        const form = document.getElementById("checkoutForm");
        const btnPlaceOrder = document.getElementById("btnPlaceOrder");
        if (form && btnPlaceOrder) {
            form.addEventListener("submit", function () {
                btnPlaceOrder.disabled = true;
                btnPlaceOrder.querySelector(".spinner-border")?.classList.remove("d-none");
                const btnText = btnPlaceOrder.querySelector(".btn-text");
                if (btnText) btnText.textContent = "Đang xử lý...";
            });
        }
    });

    // --- PHẦN 5: CÁC HÀM AJAX ĐỊA CHỈ (Nằm ngoài DOMContentLoaded) ---
    function LoadForm() {
        $.get('/DiaChiGiaoHang/Create', function (res) {
            $('#modalDiaChi .modal-body').html(res);
            $('#modalDiaChi').modal('show');
        });
    }

    function handleFormUpdateDanhMuc(id) {
        $.get('/DiaChiGiaoHang/Edit', { DiaChiId: id }, function (res) {
            $('#modalDiaChi .modal-body').html(res);
            $('#modalDiaChi').modal('show');
        });
    }

    function SaveDiaChi() {
        var form = $('#form-addDiaChi')[0];
        var formData = new FormData(form);
        var id = $('#DiaChiId').val();
        var url = (id && parseInt(id) > 0) ? '/DiaChiGiaoHang/Edit' : '/DiaChiGiaoHang/Create';

        $.ajax({
            url: url,
            type: 'POST',
            data: formData,
            processData: false,
            contentType: false,
            success: function (res) {
                if (res.code === 200) {
                    $('#modalDiaChi').modal('hide');
                    Swal.fire("Thành công", res.msg, "success").then(() => location.reload());
                } else {
                    Swal.fire("Lỗi", res.msg || "Cập nhật thất bại", "error");
                }
            }
        });
    }

    function handleDelete(id) {
        Swal.fire({
            title: 'Bạn có chắc chắn?',
            text: "Địa chỉ này sẽ bị xóa!",
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#d33',
            confirmButtonText: 'Xóa ngay'
        }).then((result) => {
            if (result.isConfirmed) {
                $.post('/DiaChiGiaoHang/Delete', { DiaChiId: id }, function (res) {
                    if (res.code === 200) {
                        location.reload();
                    } else {
                        Swal.fire("Lỗi", res.msg, "error");
                    }
                });
            }
        });
    }
</script>