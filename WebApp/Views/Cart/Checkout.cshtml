@model Models.CheckoutViewModel
@{
    ViewBag.Title = "Thanh toán";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container my-5">
    <h2 class="mb-4">Thanh toán</h2>
    <form id="checkoutForm" method="post" action="/Cart/Checkout">
        <div class="row">
            <!-- BÊN TRÁI: Danh sách sản phẩm -->
            <div class="col-md-8">
                <div class="card shadow-sm mb-3">
                    <div class="card-header bg-light">
                        <h5 class="mb-0">Sản phẩm trong giỏ</h5>
                    </div>
                    <div class="card-body">
                        @foreach (var item in Model.CartItems)
                        {
                            <div class="d-flex justify-content-between align-items-center border-bottom py-2">
                                <div class="d-flex align-items-center">
                                    <img src="https://localhost:44310/@item.ProductImage" width="125" class="me-3" />
                                    <div style="width: 550px; padding-right: 25px;">
                                        <strong>@item.ProductName</strong><br />
                                        SL: @item.Quantity 

                                    </div>
                                </div>
                                <div style="width: 120px;">
                                    <strong>
                                        @string.Format(System.Globalization.CultureInfo.GetCultureInfo("vi-VN"), "{0:N0} đ", item.Quantity * item.UnitPrice)
                                    </strong>

                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- BÊN PHẢI: Thông tin đơn hàng -->
            <div class="col-md-4">
                <!-- Địa chỉ giao hàng -->
                <div class="card shadow-sm mb-3">
                    <div class="card-header bg-light d-flex justify-content-between align-items-center">
                        <h5 class="mb-0">Chọn địa chỉ nhận hàng</h5>
                        <button type="button" class="btn btn-outline-primary btn-sm" onclick="LoadForm()">
                            <i class="fas fa-plus"></i>
                            Thêm địa chỉ
                        </button>
                    </div>
                    <div class="list-group list-group-flush">
                        @foreach (var addr in Model.Addresses)
                        {
                            <label class="list-group-item d-flex align-items-start">
                                <input class="form-check-input me-2 mt-1" type="radio" name="SelectedAddressId"
                                       value="@addr.DiaChiId" @(addr.MacDinh ? "checked" : "") />

                                <div class="flex-grow-1">
                                    <div class="d-flex justify-content-between">
                                        <div>
                                            <strong>@addr.TenNguoiNhan</strong>
                                            <span class="text-muted ms-2">(@addr.SoDienThoai)</span>
                                        </div>
                                        <div class="btn-group">
                                            <button type="button"
                                                    onclick="handleFormUpdateDanhMuc(@addr.DiaChiId)"
                                                    class="btn btn-sm btn-link text-primary">
                                                <i class="fas fa-edit"></i>
                                            </button>
                                            <button type="button"
                                                    onclick="handleDelete(@addr.DiaChiId)"
                                                    class="btn btn-sm btn-link text-danger">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        </div>
                                    </div>
                                    <div>@addr.DiaChiChiTiet</div>
                                    @if (addr.MacDinh)
                                    {
                                        <span class="badge bg-danger mt-1">Mặc định</span>
                                    }
                                </div>
                            </label>
                        }
                    </div>
                </div>



                <!-- Phương thức thanh toán -->
                <div class="card shadow-sm mb-3">
                    <div class="card-header bg-light">
                        <h5 class="mb-0">Phương thức thanh toán</h5>
                    </div>
                    <div class="card-body">
                        @foreach (var pm in Model.PaymentMethods)
                        {
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="PaymentMethod" value="@pm.Code" @(pm.Code == Model.SelectedPaymentMethod ? "checked" : "") />
                                <label class="form-check-label">@pm.Name</label>
                            </div>
                        }
                    </div>
                </div>

                <!-- Sử dụng điểm thưởng -->
                <div class="card shadow-sm mb-3">
                    <div class="card-header bg-light">
                        <h5 class="mb-0">Điểm thưởng</h5>
                    </div>
                    <div class="card-body">
                        <p>Bạn hiện có: <strong id="availablePoints">@(Model.CurrentPoints > 0 ? Model.CurrentPoints : 0)</strong> điểm</p>
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" name="UsePoints" value="true" id="chkUsePoints" />
                            <label class="form-check-label" for="chkUsePoints">Sử dụng điểm để giảm giá</label>
                        </div>
                        <!-- Ẩn input, chỉ dùng để submit về server -->
                        <input type="hidden" name="PointsToUse" id="PointsToUse" value="0" />
                    </div>
                </div>

                <!-- Voucher + Tổng tiền -->
                <div class="card shadow-sm">
                    <div class="card-header bg-light">
                        <h5 class="mb-0">Tóm tắt đơn hàng</h5>
                    </div>
                    <div class="card-body">
                        <div class="mb-3">
                            <label class="form-label">Mã giảm giá</label>
                            <select id="voucherSelect" name="VoucherId" class="form-select">
                                <option value="">-- Chọn voucher --</option>
                                @foreach (var voucher in Model.Vouchers)
                                {
                                    <option value="@voucher.VoucherId" data-discount-value="@voucher.DiscountValue">
                                        @voucher.Code - Giảm @voucher.DiscountValue.ToString("N0")
                                    </option>
                                }
                            </select>

                        </div>
                        <hr />
                        <div class="d-flex justify-content-between mb-2">
                            <span>Tạm tính:</span>
                            <span class="tam-tinh" data-subtotal="@Model.SubTotal">@Model.SubTotal.ToString("N0") ₫</span>
                        </div>
                        <div class="d-flex justify-content-between mb-2">
                            <span>Giảm giá:</span>
                            <span class="giam-gia">0 ₫</span>
                        </div>
                        <div class="d-flex justify-content-between font-weight-bold">
                            <span>Tổng tiền:</span>
                            <span class="tong-tien">@Model.SubTotal.ToString("N0") ₫</span>
                        </div>

                        <button type="submit" class="btn btn-danger w-100 mt-3">Đặt hàng</button>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

<!-- Modal thêm địa chỉ -->
<div class="modal fade" id="modalDiaChi" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalDiaChiTitle">Thêm/Sửa địa chỉ</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" style="color: black">
                <!-- Nội dung form sẽ load ở đây -->
            </div>
        </div>
    </div>
</div>

<script>
function handleDelete(id) {
    if (confirm('Bạn có chắc chắn muốn xóa tài khoản này không?')) {
        $.ajax({
            url: '/DiaChiGiaoHang/Delete',
            type: 'POST',
            data: { DiaChiId: id },
            success: function (res) {
                if (res.code === 200) {
                    alert(res.msg);
                    location.reload();
                    //loadKhachHang();
                } else {
                    alert(res.msg);
                }
            }
        });
    }
}
// Khi chọn radio, gọi AJAX set mặc định
$(document).on("change", "input[name='SelectedAddressId']", function () {
    let id = $(this).val();

    $.post("@Url.Action("SetDefault", "DiaChiGiaoHang")", { DiaChiId: id }, function (res) {
        toastr[res.code === 200 ? "success" : "error"](res.msg);

        if (res.code === 200) {
            // Cập nhật lại UI mà không cần reload
            $(".badge.bg-danger").remove(); // xóa badge cũ
            $("input[name='SelectedAddressId']:checked")
                .closest("label")
                .find(".flex-grow-1")
                .append('<span class="badge bg-danger mt-1">Mặc định</span>');
        }
    });
});

    function LoadForm() {
        $.ajax({
            url: '/DiaChiGiaoHang/Create',
            type: 'Get',
            success: function (res) {
                if ($('#formAdd').length > 0) {
                    $('#formAdd')[0].reset();
                }
                $('#DiaChiId').val('');
                $('#modalDiaChi .modal-body').html(res);
                $('#modalDiaChi').modal('show');
            }
        })
    }

    function handleFormUpdateDanhMuc(id) {
        debugger
        if (!id || parseInt(id) <= 0) {
            toastr.error("ID không hợp lệ");
            return;
        }

        $.ajax({
            url: '/DiaChiGiaoHang/Edit',
            type: 'GET',
            data: { DiaChiId: id },
            success: function (res) {
                $('#modalDiaChi .modal-body').html(res);
                $('#modalDiaChi').modal('show');
            },
            error: function (xhr, status, error) {
                console.error('Lỗi khi load form:', error);
                alert('Có lỗi xảy ra khi tải form. Vui lòng thử lại!');
            }
        });
    }
    function SaveDiaChi() {
        debugger
        var form = $('#form-addDiaChi')[0];
        var formData = new FormData(form);
        var id = $('#DiaChiId').val();
        formData.append("MacDinh", $('#MacDinh').is(':checked'));

        var url = (id != null && parseInt(id) > 0) ? '/DiaChiGiaoHang/Edit' : '/DiaChiGiaoHang/Create';
        console.log([...formData.entries()]);

        $.ajax({
            url: url,
            type: 'POST',
            data: formData,
            processData: false,
            contentType: false,
            success: function (res) {
                if (res.code === 200) {
                    toastr.success(res.msg || "Cập nhật thành công");
                    $('#modalDiaChi').modal('hide');
                    setTimeout(function () {
                        location.reload();
                    }, 1500);
                    //loadDanhMuc();
                } else if (typeof res === 'string') {
                    $('#modalDiaChi .modal-body').html(res);
                } else {
                    toastr.error(res.msg || "Cập nhật thất bại");
                }
            }
        });
    }
    document.addEventListener("DOMContentLoaded", function () {
        const chkUsePoints = document.getElementById("chkUsePoints");
        const pointsHiddenInput = document.getElementById("PointsToUse");
        const voucherSelect = document.getElementById("voucherSelect");
        const subtotalElem = document.querySelector(".tam-tinh");
        const discountElem = document.querySelector(".giam-gia");
        const totalElem = document.querySelector(".tong-tien");

        const subtotal = parseInt(subtotalElem.dataset.subtotal);
        const availablePoints = parseInt(document.getElementById("availablePoints").textContent) || 0;

        // giả sử 1 điểm = 1đ (nếu khác thì sửa ở đây)
        const pointValue = 1;

        function formatCurrency(value) {
            return value.toLocaleString("vi-VN") + " ₫";
        }

        function calculateTotal() {
            let discount = 0;

            // Tính giảm giá từ điểm thưởng
            if (chkUsePoints.checked) {
                // Tối đa số điểm có thể dùng = min(điểm hiện có, subtotal/pointValue)
                let maxPointsUsable = Math.min(availablePoints, Math.floor(subtotal / pointValue));
                pointsHiddenInput.value = maxPointsUsable;
                discount += maxPointsUsable * pointValue;
            } else {
                pointsHiddenInput.value = 0;
            }

            // Tính giảm giá từ voucher
            let selectedOption = voucherSelect.options[voucherSelect.selectedIndex];
            if (selectedOption && selectedOption.dataset.discountValue) {
                discount += parseInt(selectedOption.dataset.discountValue);
            }

            // Không cho vượt quá subtotal
            if (discount > subtotal) discount = subtotal;

            let finalTotal = subtotal - discount;

            discountElem.textContent = "-" + formatCurrency(discount);
            totalElem.textContent = formatCurrency(finalTotal);
        }

        chkUsePoints.addEventListener("change", calculateTotal);
        voucherSelect.addEventListener("change", calculateTotal);

        // gọi 1 lần ban đầu để sync giá trị
        calculateTotal();
    });
