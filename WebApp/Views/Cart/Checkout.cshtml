@model Models.CheckoutViewModel
@{
    ViewBag.Title = "Thanh toán";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container my-5">
    <h2 class="mb-4">Thanh toán</h2>
    <form id="checkoutForm" method="post" action="/Checkout/PlaceOrder">
        <div class="row">
            <!-- BÊN TRÁI: Danh sách sản phẩm -->
            <div class="col-md-7">
                <div class="card shadow-sm mb-3">
                    <div class="card-header bg-light">
                        <h5 class="mb-0">Sản phẩm trong giỏ</h5>
                    </div>
                    <div class="card-body">
                        @foreach (var item in Model.CartItems)
                        {
                            <div class="d-flex justify-content-between align-items-center border-bottom py-2">
                                <div class="d-flex align-items-center">
                                    <img src="@item.ProductImage" width="60" class="me-3" />
                                    <div>
                                        <strong>@item.ProductName</strong><br />
                                        SL: @item.Quantity x @item.UnitPrice.ToString("N0") đ
                                    </div>
                                </div>
                                <div>
                                    <strong>@(item.Quantity * item.UnitPrice).ToString("N0") đ</strong>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- BÊN PHẢI: Thông tin đơn hàng -->
            <div class="col-md-5">
                <!-- Địa chỉ giao hàng -->
                <div class="card shadow-sm mb-3">
                    <div class="card-header bg-light">
                        <h5 class="mb-0">Địa chỉ giao hàng</h5>
                    </div>
                    <div class="card-body">
                        @if (Model.Addresses != null && Model.Addresses.Any())
                        {
                            foreach (var addr in Model.Addresses)
                            {
                                <div class="form-check mb-2">
                                    <input class="form-check-input" type="radio" name="ShippingAddressId"
                                           value="@addr.Id" @(addr.MacDinh ? "checked" : "") />
                                    <label class="form-check-label">
                                        <strong>@addr.TenNguoiNhan</strong> - @addr.DiaChiChiTiet <br />
                                    </label>
                                </div>
                            }
                        }
                        <div class="mt-3">
                            <button type="button" class="btn btn-outline-primary btn-sm" data-bs-toggle="modal" data-bs-target="#addAddressModal">
                                + Thêm địa chỉ mới
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Phương thức thanh toán -->
                <div class="card shadow-sm mb-3">
                    <div class="card-header bg-light">
                        <h5 class="mb-0">Phương thức thanh toán</h5>
                    </div>
                    <div class="card-body">
                        @foreach (var pm in Model.PaymentMethods)
                        {
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="PaymentMethod" value="@pm.Code" @(pm.Code == Model.SelectedPaymentMethod ? "checked" : "") />
                                <label class="form-check-label">@pm.Name</label>
                            </div>
                        }
                    </div>
                </div>

                <!-- Sử dụng điểm thưởng -->
                <div class="card shadow-sm mb-3">
                    <div class="card-header bg-light">
                        <h5 class="mb-0">Điểm thưởng</h5>
                    </div>
                    <div class="card-body">
                        <p>Bạn hiện có: <strong>@Model.CurrentPoints</strong> điểm</p>
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" name="UsePoints" value="true" id="chkUsePoints" />
                            <label class="form-check-label" for="chkUsePoints">Sử dụng điểm để giảm giá</label>
                        </div>
                        <input type="number" name="PointsToUse" class="form-control mt-2" placeholder="Nhập số điểm muốn dùng" min="0" max="@Model.CurrentPoints" />
                    </div>
                </div>

                <!-- Voucher + Tổng tiền -->
                <div class="card shadow-sm">
                    <div class="card-header bg-light">
                        <h5 class="mb-0">Tóm tắt đơn hàng</h5>
                    </div>
                    <div class="card-body">
                        <div class="mb-3">
                            <label class="form-label">Mã giảm giá</label>
                            <select name="VoucherId" class="form-select">
                                <option value="">-- Chọn voucher --</option>
                                @foreach (var voucher in Model.Vouchers)
                                {
                                    <option value="@voucher.VoucherId">@voucher.Code - Giảm @voucher.DiscountValue.ToString("N0")</option>
                                }
                            </select>
                        </div>
                        <hr />
                        <p>Tạm tính: <span class="float-end">@Model.SubTotal.ToString("N0") đ</span></p>
                        <p>Giảm giá: <span class="float-end text-danger">-@Model.Discount.ToString("N0") đ</span></p>
                        <h5>Tổng tiền: <span class="float-end text-primary">@Model.FinalTotal.ToString("N0") đ</span></h5>
                        <button type="submit" class="btn btn-danger w-100 mt-3">Đặt hàng</button>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

<!-- Modal thêm địa chỉ -->
<div class="modal fade" id="addAddressModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Thêm địa chỉ mới</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="mb-2">
                    <label>Họ tên</label>
                    <input type="text" name="NewAddress.FullName" class="form-control" />
                </div>
                <div class="mb-2">
                    <label>Số điện thoại</label>
                    <input type="text" name="NewAddress.Phone" class="form-control" />
                </div>
                <div class="mb-2">
                    <label>Địa chỉ chi tiết</label>
                    <textarea name="NewAddress.Detail" class="form-control"></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                <button type="button" class="btn btn-primary">Lưu</button>
            </div>
        </div>
    </div>
</div>
