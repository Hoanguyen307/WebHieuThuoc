@model List<Models.CartItemModel>
@{
    ViewBag.Title = "Giỏ hàng";
    Layout = "~/Views/Shared/_Layout.cshtml";
    decimal totalAmount = Model.Sum(x => x.LineTotal);
}

<link rel="stylesheet" href="~/Content/assets/css/cart.css" />

<div class="container py-5">
    <h2 class="mb-4 fw-bold">🛒 Giỏ hàng của bạn</h2>

    @if (Model != null && Model.Any())
    {
        foreach (var item in Model)
        {
            <div class="cart-item d-flex align-items-center border-bottom py-3" data-id="@item.Id">
                <!-- Ảnh -->
                <div style="width: 100px;">
                    <img src="https://localhost:44310/@item.ProductImage" alt="@item.ProductName"
                         class="rounded" style="width: 80px; height: 80px; object-fit: cover;">
                </div>

                <!-- Tên sản phẩm + giá -->
                <div class="flex-grow-1">
                    <div class="fw-bold">@item.ProductName</div>

                </div>
                <div class="text-danger fw-bold">@item.UnitPrice.ToString("N0") đ</div>
                <!-- Số lượng -->
                <div style="width: 150px;" class="d-flex align-items-center">
                    <button class="btn btn-outline-secondary btn-sm btn-minus">-</button>
                    <input type="number" class="form-control text-center mx-2 quantity"
                           value="@item.Quantity" min="1" style="width: 60px;">
                    <button class="btn btn-outline-secondary btn-sm btn-plus">+</button>
                </div>

                <!-- Tổng -->
                <div style="width: 120px;" class="fw-bold text-primary item-total">
                    @item.LineTotal.ToString("N0") đ
                </div>

                <!-- Xóa -->
                <div style="width: 80px;">
                    <button class="btn btn-outline-danger btn-sm btn-remove">
                        <i class="fas fa-trash-alt"></i>
                    </button>
                </div>
            </div>
        }

        <!-- Tổng cộng -->
        <div class="cart-summary mt-4 p-4 bg-light rounded shadow-sm d-flex justify-content-between align-items-center">
            <h4 class="m-0">Tổng cộng: <span id="cart-total" class="text-danger fw-bold">@totalAmount.ToString("N0") đ</span></h4>
            <a href="@Url.Action("Checkout", "Cart")" class="btn btn-success btn-lg">Thanh toán</a>
        </div>
    }
    else
    {
        <div class="alert alert-warning text-center">
            Giỏ hàng của bạn đang trống.
        </div>
    }
</div>
