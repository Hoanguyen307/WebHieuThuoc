@model Models.Product

<div class="col">
    <div class="card product-card h-100 position-relative">
        <!-- Ảnh sản phẩm -->
        <div class="position-relative">
            <img src="@Model.ImageUrl" class="card-img-top img-fluid" alt="@Model.ProductName" />

            @if (!string.IsNullOrEmpty(Model.PromotionText))
            {
                <div class="badge bg-dark position-absolute top-0 start-0 m-2">@Model.PromotionText</div>
            }
            <div class="freeship-badge">FREESHIP</div>
            <button class="btn position-absolute top-0 end-0 m-2"><i class="far fa-heart"></i></button>
        </div>

        <!-- Nội dung -->
        <div class="card-body text-center px-2 py-3">
            <div class="text-uppercase fw-bold small text-secondary">@Model.BrandName</div>
            <div class="product-name text-truncate fw-semibold">@Model.ProductName</div>
            <div class="fw-bold text-danger">@Model.Price.ToString("N0")đ</div>
            @if (Model.OldPrice > Model.Price)
            {
                <div class="text-muted text-decoration-line-through small">@Model.OldPrice.ToString("N0")đ</div>
            }
            <div class="star-rating small">
                @for (int i = 1; i <= 5; i++)
                {
                    if (i <= Model.Rating)
                    {
                        <i class="fas fa-star text-warning"></i>
                    }
                    else
                    {
                        <i class="far fa-star text-muted"></i>
                    }
                }
                <span> (@Model.TotalReviews)</span>
            </div>
        </div>
    </div>
</div>
