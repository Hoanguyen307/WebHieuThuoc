<style>
    .nav-container {
        background: #ffffff;
        margin-top: -24px !important;
    }

    .btn-nav-custom {
        background-color: transparent;
        border: 1px solid transparent;
        color: #333;
        font-weight: 600;
        padding: 10px 20px;
        border-radius: 8px; 
        transition: all 0.3s ease;
    }

    .mega-dropdown-menu {
        display: none;
        position: absolute;
        z-index: 1000;
        top: 100%;
        left: 50%;
        transform: translateX(-50%);
        width: 1000px;
        background: #fff;
        box-shadow: 0 10px 40px rgba(0,0,0,0.12);
        border-radius: 15px;
        border: 1px solid #f1f1f1;
        padding: 25px;
        margin-top: 10px;
        pointer-events: auto;
    }

    .mega-grid-container {
        display: grid;
        grid-template-columns: repeat(4, 1fr); 
        gap: 20px;
    }

    .category-group {
        display: flex;
        flex-direction: column;
    }

    .category-title {
        font-size: 14px;
        font-weight: 700;
        color: #222;
        text-transform: uppercase;
        margin-bottom: 12px;
        border-bottom: 1px solid #f5f5f5;
        padding-bottom: 8px;
        display: block;
        text-decoration: none;
    }

    .sub-item-list {
        list-style: none;
        padding: 0;
        margin: 0;
    }

    .sub-item-link {
        display: block;
        padding: 4px 0;
        color: #555;
        font-size: 14px;
        text-decoration: none;
        transition: all 0.2s;
    }

        .sub-item-link:hover {
            color: #28a745;
            padding-left: 5px;
        }

</style>﻿

<nav class="nav-container d-flex justify-content-center gap-2">
    @foreach (var menu in ViewBag.Menus)
    {
        <div class="menu-wrapper position-relative">
            <button type="button"
                    class="btn btn-nav-custom menu-link"
                    data-id="@menu.Id">
                @menu.MenuName
            </button>
            <div id="mega-menu-@menu.Id" class="mega-dropdown-menu"></div>
        </div>
    }
</nav>

<script>
    $(document).ready(function () {
        $('.menu-wrapper').hover(function () {
            const $wrapper = $(this);
            const $btn = $wrapper.find('.menu-link');
            const menuId = $btn.data('id');
            const $megaMenu = $('#mega-menu-' + menuId);

            // Load Ajax nếu chưa có dữ liệu
            if ($megaMenu.is(':empty')) {
                $.ajax({
                    url: '@Url.Action("GetCategoriesByMenuId", "Home1")',
                    type: 'GET',
                    data: { menuId: menuId },
                    success: function (result) {
                        $megaMenu.html(result);
                        $megaMenu.stop(true, true).fadeIn(200);
                        showMenu($megaMenu);
                    }
                });
            } else {
                $megaMenu.stop(true, true).fadeIn(200);
                showMenu($megaMenu);
            }
        }, function () {
            // Khi chuột ra ngoài, ẩn ngay lập tức
            $(this).find('.mega-dropdown-menu').stop(true, true).fadeOut(100);
        });

        function showMenu($menu) {
            $menu.stop(true, true).fadeIn(200);

            // Xử lý chống tràn màn hình
            const rect = $menu[0].getBoundingClientRect();
            const winW = $(window).width();

            if (rect.right > winW) {
                $menu.css({ 'left': 'auto', 'right': '0', 'transform': 'none' });
            }
            if (rect.left < 0) {
                $menu.css({ 'left': '0', 'transform': 'none' });
            }
        }
    });
</script>