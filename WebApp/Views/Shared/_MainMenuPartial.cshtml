<ul class="main-menu d-flex justify-content-center">
    @foreach (var menu in ViewBag.Menus)
    {
        <li class="menu-item position-relative">
            <a href="#" class="menu-link" data-id="@menu.Id">@menu.MenuName</a>
            <div id="mega-menu-@menu.Id" class="mega-dropdown-menu"></div>
        </li>
    }
</ul>

<script>
    $(document).ready(function () {
        $('.menu-item').hover(function () {
            const $menu = $(this);
            const menuId = $menu.find('.menu-link').data('id');
            const $megaMenu = $('#mega-menu-' + menuId);

            if ($megaMenu.is(':empty')) {
                $.ajax({
                    url: '@Url.Action("GetCategoriesByMenuId", "Home1")',
                    type: 'GET',
                    data: { menuId: menuId },
                    success: function (result) {
                        $megaMenu.html(result);
                        $megaMenu.stop(true, true).fadeIn(200); // hiện ngay
                        setupSubCategoryHover($megaMenu);
                    }
                });
            } else {
                $megaMenu.stop(true, true).fadeIn(200);
            }
        }, function () {
            $(this).find('.mega-dropdown-menu').stop(true, true).fadeOut(200);
        });

        function setupSubCategoryHover($context) {
            const $main = $context.find('.main-category');
            const $subs = $context.find('.sub-category-content');

            function showFirst() {
                $main.removeClass('active').first().addClass('active');
                $subs.hide().removeClass('active').first().addClass('active').show();
            }

            $main.on('mouseenter', function () {
                const id = $(this).data('target');
                $main.removeClass('active');
                $(this).addClass('active');
                $subs.hide().removeClass('active');
                $context.find('#' + id).addClass('active').show();
            });

            showFirst();
        }
        $('.menu-item').on('mouseenter', function () {
            const $menu = $(this).find('.mega-dropdown-menu');
            if ($menu.length) {
                const rect = $menu[0].getBoundingClientRect();
                const windowWidth = window.innerWidth;

                if (rect.right > windowWidth) {
                    $menu.addClass('mega-left');
                } else {
                    $menu.removeClass('mega-left');
                }
            }
        });
    });
</script>
