 
<div class="mega-grid-container">
    @foreach (var parentCategory in ViewBag.Categories)
    {
        <div class="category-group">
            <a href="#" class="category-title">@parentCategory.Name</a>

            <ul class="sub-item-list">
                @foreach (var productCategory in ((List<Models.ProductCategory>)ViewBag.ProductCategories)
                    .Where(pc => pc.Category_ID == parentCategory.ID))
                {
                    <li>
                        <a class="sub-item-link" href="@Url.Action("Index", "Products", new { ProductCategoryId = productCategory.DanhMucId })">
                            @productCategory.TenDanhMuc
                        </a>
                    </li>
                }
            </ul>
        </div>
    }

    @if (ViewBag.Categories.Count < 4)
    {
        <div class="category-promo">
            <img src="/Content/images/banner-promo.jpg" class="img-fluid rounded-3" alt="Promotion">
        </div>
    }
</div>


