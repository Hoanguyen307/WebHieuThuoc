<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <title>@ViewBag.Title - Hiệu thuốc</title>
    <link rel="shortcut icon" href="~/Content/assets/images/Logo/Logo2.png">
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@600&display=swap" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" rel="stylesheet" />
    <link href="~/Content/assets/css/GiaoDien.css" rel="stylesheet" />

    @RenderSection("Styles", required: false)

    <!-- JS -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    
</head>
<body>

    <header class="header">
        <div class="container-fluid">
            <div class="d-flex justify-content-between align-items-center">
                <a href="@Url.Action("Index", "Home1")" class="logo logo-dark" >
                    <span class="logo-sm">
                        <img src="~/Content/assets/images/Logo/Logo4.png" alt="" height="80">
                    </span>
                    @*<span class="logo-lg">
                            <img src="~/Content/assets/images/Logo/Logo2.png" alt="" height="70">
                        </span>*@
                </a>
                @*<a href="/" class="text-decoration-none fs-3">
                        <img src="~/Content/assets/images/Logo/Logo2.png" alt="" height="70" />
                        <span class="logo-text">Hoà <span class="text-pink">Đại</span> <span class="text-gradient">Nhân</span></span>
                    </a>*@

                <div class="header-right d-flex align-items-center gap-4">
                    @* Tìm đến div có class "search-box" *@
                    <div class="search-box">
                        @using (Html.BeginForm("Search", "Products", FormMethod.Get))
                        {
                            <input type="text" name="searchString" placeholder="Bạn đang tìm gì hôm nay..." value="@ViewBag.SearchString" />
                            <button type="submit" class="btn btn-link p-0"><i class="fas fa-search"></i></button>
                        }
                    </div>

                    <div class="header-item">
                        <i class="fas fa-ellipsis-h"></i>
                    </div>
                    <div class="divider"></div>
                    @if (Session["Login"] != null)
                    {
                        var kh = Session["Login"] as Models.KhachHang;
                        <div class="dropdown header-item">
                            <a class="d-flex align-items-center text-decoration-none dropdown-toggle text-white"
                               href="#" id="userDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="fas fa-user-circle me-2 fs-5 text-white"></i>
                                <span>@kh.FullName</span>
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end shadow" aria-labelledby="userDropdown">
                                <li>
                                    <a class="dropdown-item" href="@Url.Action("UpdateInfo", "KhachHang")">
                                        <i class="fas fa-id-card me-2"></i> Tài khoản của bạn
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item" href="@Url.Action("DonHang", "KhachHang")">
                                        <i class="fas fa-box me-2"></i> Quản lý đơn hàng
                                    </a>
                                </li>
                                @*<li>
                                    <a class="dropdown-item" href="@Url.Action("Wishlist", "KhachHang")">
                                        <i class="fas fa-heart me-2"></i> Sản phẩm yêu thích
                                    </a>
                                </li>*@
                                <li>
                                    <a class="dropdown-item" href="@Url.Action("Index", "DiaChiGiaoHang")">
                                        <i class="fas fa-map-marker-alt me-2"></i> Địa chỉ giao hàng
                                    </a>
                                </li>
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <a class="dropdown-item text-danger" href="@Url.Action("LogOff", "Account")">
                                        <i class="fas fa-sign-out-alt me-2"></i> Thoát
                                    </a>
                                </li>
                            </ul>
                        </div>
                    }
                    else
                    {
                        <a href="@Url.Action("Login", "Account")" class="header-item d-flex align-items-center text-decoration-none text-white">
                            <i class="fas fa-user me-2"></i>
                            <span>Đăng nhập</span>
                        </a>
                    }


                    <a id="cart-toggle" href="javascript:void(0)" class="header-icon position-relative">
                        <i class="fas fa-shopping-cart"></i>
                        <span id="cart-count" class="cart-badge position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
                            0
                        </span>
                    </a>

                </div>
            </div>
        </div>
    </header>

    <div id="mini-cart" class="mini-cart shadow">
        <div class="mini-cart-header d-flex justify-content-between align-items-center">
            <div>
                <h5 class="mb-0">Giỏ hàng</h5>
                <small class="text-muted">Sản phẩm của bạn</small>
            </div>
            <div>
                <button id="close-mini-cart" class="btn btn-sm btn-outline-secondary" title="Đóng">&times;</button>
            </div>
        </div>

        <div class="mini-cart-body">
            <div class="mini-cart-empty">Đang tải...</div>
        </div>

        <div class="mini-cart-footer">
            <div class="d-flex justify-content-between align-items-center mb-1">
                <strong>Tổng cộng:</strong>
                <span id="mini-cart-total" class="text-danger fw-bold">0 đ</span>
            </div>
            @*<a href="@Url.Action("Index","Cart")" class="btn btn-outline-primary w-100 mb-2">Xem giỏ hàng</a>*@
            <a href="@Url.Action("Checkout","Cart")" class="btn btn-success w-100">Thanh toán</a>
        </div>
    </div>
    <div id="mini-cart-overlay" class="mini-cart-overlay"></div>

    @Html.Action("MainMenu", "Home1")

    <div class="container mt-3">
        @RenderBody()
    </div>

    <footer class="footer-custom mt-auto py-5">
        <div class="container">
            <div class="row footer-links">
                <div class="col-md-6 col-lg-3 mb-4">
                    <h5 style="font-size:22px;">HỖ TRỢ KHÁCH HÀNG</h5>
                    <ul class="list-unstyled">
                        <li><a href="tel:0979310351">📞 Hotline tư vấn: 0979.310.351</a></li>
                        <li><a href="/Page/FAQ">Các câu hỏi thường gặp</a></li>
                        <li><a href="/Page/OrderGuide">Hướng dẫn mua thuốc</a></li>
                        <li><a href="/Page/Shipping">Phương thức giao hàng</a></li>
                        <li><a href="/Page/ReturnPolicy">Chính sách đổi trả thuốc</a></li>
                    </ul>
                </div>
                <div class="col-md-6 col-lg-3 mb-4">
                    <h5 style="font-size:20px;">VỀ NHÀ THUỐC THANH TỨ</h5>
                    <ul class="list-unstyled">
                        <li><a href="/Page/About">Giới thiệu Nhà thuốc Thanh Tứ</a></li>
                        <li><a href="/Page/License">Giấy phép kinh doanh</a></li>
                        <li><a href="/Page/Privacy">Chính sách bảo mật</a></li>
                        <li><a href="/Page/Terms">Điều khoản sử dụng</a></li>
                        <li><a href="/Page/Contact">Liên hệ & phản hồi</a></li>
                    </ul>
                </div>
                <div class="col-md-6 col-lg-3 mb-4">
                    <h5 style="font-size:20px;">KẾT NỐI VỚI CHÚNG TÔI</h5>
                    <p class="small">Theo dõi để nhận tin tức y tế & tư vấn sức khỏe miễn phí:</p>
                    <div class="social-icons-wrapper mt-2">
                        <a href="#" class="social-icon facebook"><i class="fab fa-facebook-f"></i></a>
                        <a href="#" class="social-icon tiktok"><i class="fab fa-tiktok"></i></a>
                        <a href="#" class="social-icon instagram"><i class="fab fa-instagram"></i></a>
                    </div>
                </div>
                <div class="col-md-6 col-lg-3 mb-4">
                    <h5 style="font-size:20px;">ĐĂNG KÝ NHẬN TIN</h5>
                    <div class="input-group mb-3">
                        <input type="email" class="form-control" placeholder="Email của bạn">
                        <button class="btn btn-success" type="button">Đăng ký</button>
                    </div>
                    <p class="small">Nhận thông tin sức khỏe & khuyến mãi thuốc mới nhất.</p>

                    <div class="map-container rounded overflow-hidden shadow-sm mt-3">
                        <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d30009.61100722849!2d105.8447923743164!3d19.915917099999994!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x31365d6637530b1d%3A0xcfe4bdc4853b5df8!2zTmjDoCB0aHXhu5FjIFRoYW5oIFThu6k!5e0!3m2!1svi!2s!4v1758128831257!5m2!1svi!2s" width="100%" height="250" style="border:0;" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
                    </div>
                </div>
            </div>
        </div>
    </footer>

    <!-- Chatbox Floating Button -->
    <div id="chatbox-btn" class="chatbox-btn">
        <i class="fas fa-comment-dots"></i>
        <span id="chatbox-badge" class="chatbox-badge" style="display: none;">1</span>
    </div>
    <!-- Modal Chat Hỗ Trợ -->
    <div class="hieuThuoc-chatbox-container" id="hieuThuocChatboxContainer">
        <!-- Header -->
        <div class="hieuThuoc-chat-header">
            <div class="hieuThuoc-chat-header-left">
                <div class="hieuThuoc-chat-avatar">
                    <i class="fas fa-robot"></i>
                    <div class="hieuThuoc-status-indicator"></div>
                </div>
                <div class="hieuThuoc-chat-info">
                    <h6>Tư vấn</h6>
                    <p>Hỗ trợ 24/7</p>
                </div>
            </div>
            <button class="hieuThuoc-close-btn" id="hieuThuocCloseChatBtn">
                <i class="fas fa-times"></i>
            </button>
        </div>

        <!-- Chat Body -->
        <div class="hieuThuoc-chat-body" id="hieuThuocChatBody">
            <div class="hieuThuoc-welcome-message">
                <i class="fas fa-comments"></i>
                <h5>Chào bạn!</h5>
                <p>Tôi là trợ lý ảo. Hãy nhập tin nhắn để bắt đầu trò chuyện!</p>
            </div>
        </div>

        <!-- Chat Input -->
        <div class="hieuThuoc-chat-input">
            <div class="hieuThuoc-input-group">
                <input type="text" class="hieuThuoc-chat-input-field" id="hieuThuocMessageInput" placeholder="Nhập nội dung tin nhắn...">
                <button class="hieuThuoc-send-btn" id="hieuThuocSendBtn">
                    <i class="fas fa-paper-plane"></i>
                </button>
            </div>
        </div>
    </div>

    @RenderSection("Scripts", required: false)
    <script>
    var currentUserName = "@(Session["CustomerName"] ?? "Khách")";
    let hieuThuocSessionId = 0;
    let hieuThuocLastMessageCount = 0;
    let hieuThuocIsOpen = false;
    let isMessageSending = false;
    let messagePollingInterval = null;

    $(document).ready(function () {
        function updateCartCount() {
            $.get("/Cart/GetCartCount", function (res) {
                $("#cart-count").text(res.count); // đúng ID
            });
        }

        updateCartCount();

        // ========== CHATBOX FUNCTIONALITY ==========
        const $chatboxBtn = $('#chatbox-btn');
        const $chatboxContainer = $('#hieuThuocChatboxContainer');
        const $closeChatBtn = $('#hieuThuocCloseChatBtn');
        const $chatBody = $('#hieuThuocChatBody');
        const $messageInput = $('#hieuThuocMessageInput');
        const $sendBtn = $('#hieuThuocSendBtn');
        const $chatboxBadge = $('#chatbox-badge');

        // Toggle chatbox
        $chatboxBtn.on('click', function() {
            if (hieuThuocIsOpen) {
                closehieuThuocChatbox();
            } else {
                openhieuThuocChatbox();
            }
        });

        $closeChatBtn.on('click', closehieuThuocChatbox);

        function openhieuThuocChatbox() {
            $chatboxContainer.show();
            $chatboxBtn.addClass('active');
            $chatboxBtn.find('i').removeClass('fa-comments').addClass('fa-times');
            $chatboxBadge.hide();
            $chatboxBtn.removeClass('new-message');
            hieuThuocIsOpen = true;
            $messageInput.focus();

            // Clear welcome message and show initial greeting
            if (hieuThuocSessionId === 0) {
                $chatBody.empty();
                addhieuThuocMessage('Xin chào! Tôi là dược sĩ AI của Hiệu Thuốc. Tôi có thể giúp bạn tìm thuốc hoặc tư vấn các vấn đề sức khỏe đơn giản.', 'bot');
                addHieuThuocQuickReplies(['Tìm thuốc', 'Tư vấn theo triệu chứng', 'Khuyến mãi']);

                // Initialize session
                $.post("/Chat/StartSession", {}, function (res) {
                    if (res && res.success) {
                        hieuThuocSessionId = res.sessionId;
                        // Start polling for new messages every 5 seconds (reduced frequency)
                        if (messagePollingInterval) {
                            clearInterval(messagePollingInterval);
                        }
                        messagePollingInterval = setInterval(loadhieuThuocMessages, 5000);
                    }
                }).fail(function () {
                    console.log('Failed to start chat session');
                });
            }
        }

        function closehieuThuocChatbox() {
            $chatboxContainer.hide();
            $chatboxBtn.removeClass('active');
            $chatboxBtn.find('i').removeClass('fa-times').addClass('fa-comments');
            hieuThuocIsOpen = false;

            if (messagePollingInterval) {
                clearInterval(messagePollingInterval);
                messagePollingInterval = null;
            }
        }

        // Send message function
        function sendhieuThuocMessage() {
        const message = $messageInput.val().trim();
        if (!message || isMessageSending) return;

        // Prevent duplicate sends
        isMessageSending = true;

        // Disable input and button
        $messageInput.prop('disabled', true);
        $sendBtn.prop('disabled', true);

        // Add user message
        addhieuThuocMessage(message, 'user');
        $messageInput.val('');

        // Show typing indicator
        showhieuThuocTypingIndicator();

        // Send to server
        $.post('@Url.Action("SendMessage", "Chat")', {
            sessionId: hieuThuocSessionId,
            message: message
        })
        .done(function(res) {
            hidehieuThuocTypingIndicator();

            if (res) {
                if (res.requiresLogin) {
                    window.location.href = res.loginUrl;
                    return;
                }

                if (res.success) {
                    // Add bot reply (with HTML support)
                    if (res.botReply) {
                        addhieuThuocMessage(res.botReply, 'bot');
                    }

                    // Add products if any
                    if (res.products && res.products.length > 0) {
                        res.products.forEach(function (product) {
                            addhieuThuocProduct(product);
                        });
                    }
                } else {
                    addhieuThuocMessage('Xin lỗi, có lỗi xảy ra. Vui lòng thử lại sau.', 'bot');
                }
            } else {
                addhieuThuocMessage('Xin lỗi, có lỗi xảy ra. Vui lòng thử lại sau.', 'bot');
            }
        })
        .fail(function(xhr, status, error) {
            hidehieuThuocTypingIndicator();
            console.log('Chat error:', error);
            addhieuThuocMessage('Không thể kết nối đến server. Vui lòng kiểm tra kết nối mạng hoặc thử lại sau.', 'bot');
        })
        .always(function() {
            // Re-enable input and button
            $messageInput.prop('disabled', false);
            $sendBtn.prop('disabled', false);
            $messageInput.focus();
            isMessageSending = false; // Reset flag
        });
    }

        // Event handlers for sending messages
        $sendBtn.off('click').on('click', function (e) {
            e.preventDefault();
            e.stopPropagation();
            sendhieuThuocMessage();
        });
        $messageInput.off('keypress').on('keypress', function (e) {
            if (e.which === 13 && !e.shiftKey) { // Enter key
                e.preventDefault();
                e.stopPropagation();
                sendhieuThuocMessage();
            }
        });

        // Load messages from server
        function loadhieuThuocMessages() {
            if (hieuThuocSessionId === 0 || !hieuThuocIsOpen) return;

            $.get("/Chat/GetMessages", { sessionId: hieuThuocSessionId })
                .done(function (data) {
                    if (data && data.length > hieuThuocLastMessageCount) {
                        // Only show notification if there are new bot messages
                        let hasNewBotMessage = false;

                        for (let i = hieuThuocLastMessageCount; i < data.length; i++) {
                            let m = data[i];
                            if (m && m.Message && m.SenderType !== 'Khách') {
                                hasNewBotMessage = true;
                                break;
                            }
                        }

                        // Show notification if chat is closed and there's a new bot message
                        if (hasNewBotMessage && !hieuThuocIsOpen) {
                            showhieuThuocBadge();
                        }

                        hieuThuocLastMessageCount = data.length;
                    }
                })
                .fail(function () {
                    console.log('Failed to load messages');
                });
        }

        // Add message to chat
        function addhieuThuocMessage(text, sender) {
            const now = new Date();
            const timeString = now.toLocaleTimeString('vi-VN', { hour: '2-digit', minute: '2-digit' });

            const messageHtml = `
                <div class="hieuThuoc-message ${sender}">
                    <div class="hieuThuoc-message-content">
                        ${text}
                    </div>
                    ${sender === 'user' ? `<div class="hieuThuoc-message-time">${timeString}</div>` : ''}
                </div>
            `;

            $chatBody.append(messageHtml);
            scrollhieuThuocToBottom();
        }
        function addHieuThuocQuickReplies(replies) {
            if (!replies || !Array.isArray(replies)) return;
            const quickRepliesHtml = replies.map(reply =>
                `<button class="hieuThuoc-quick-reply-btn" data-reply="${reply}">${reply}</button>`
            ).join('');
            const messageHtml = `
                <div class="hieuThuoc-message bot">
                    <div class="hieuThuoc-quick-replies">
                        ${quickRepliesHtml}
                    </div>
                </div>`;
            $chatBody.append(messageHtml);
            scrollhieuThuocToBottom();
        }
        // Add product suggestion
        function addhieuThuocProduct(product) {
            if (!product || !product.TenThuoc) return;

            const imageUrl = product.HinhAnh && product.HinhAnh.trim() !== ''
                ? product.HinhAnh
                : 'https://via.placeholder.com/60x60?text=No+Image';

            const price = product.GiaBan || 0;
            const ThuocId = product.ThuocId || '#';

            const productHtml = `
                <div class="hieuThuoc-message bot">
                    <div class="hieuThuoc-product-suggestion" onclick="window.location.href='/Products/Details/${ThuocId}'">
                        <img src="${imageUrl}" alt="${product.TenThuoc}" class="hieuThuoc-product-image" onerror="this.src='https://via.placeholder.com/60x60?text=No+Image'">
                        <div class="hieuThuoc-product-info">
                            <h6>${product.TenThuoc}</h6>
                            <div class="hieuThuoc-product-price">${Number(price).toLocaleString('vi-VN')} đ</div>
                            <a href="/Products/Details/${ThuocId}" class="hieuThuoc-product-link" onclick="event.stopPropagation()">Xem chi tiết →</a>
                        </div>
                    </div>
                </div>
            `;
            $chatBody.append(productHtml);
            scrollhieuThuocToBottom();
        }

        // Typing indicator
        function showhieuThuocTypingIndicator() {
            // Remove existing typing indicator
            $('#hieuThuocTypingIndicator').remove();

            const typingHtml = `
                <div class="hieuThuoc-message bot hieuThuoc-typing-indicator" id="hieuThuocTypingIndicator">
                    <div class="hieuThuoc-message-content">
                        <div class="hieuThuoc-typing-dots">
                            <span></span>
                            <span></span>
                            <span></span>
                        </div>
                    </div>
                </div>
            `;
            $chatBody.append(typingHtml);
            scrollhieuThuocToBottom();
        }

        function hidehieuThuocTypingIndicator() {
            $('#hieuThuocTypingIndicator').remove();
        }

        // Handle quick reply clicks
        $(document).off('click', '.hieuThuoc-quick-reply-btn').on('click', '.hieuThuoc-quick-reply-btn', function (e) {
            e.preventDefault();
            e.stopPropagation();

            if (isMessageSending) return; // Prevent if already sending

            const reply = $(this).data('reply');
            if (!reply) return;

            // Remove quick replies after click
            $(this).closest('.hieuThuoc-message').fadeOut(200, function () {
                $(this).remove();
            });

            // Set the message and send
            $messageInput.val(reply);
            sendhieuThuocMessage();
        });

        // Show badge notification
        function showhieuThuocBadge() {
            if (!hieuThuocIsOpen) {
                $chatboxBadge.show().text('1');
                $chatboxBtn.addClass('new-message');
            }
        }

        // Scroll to bottom
        function scrollhieuThuocToBottom() {
            setTimeout(function () {
                const chatBodyElement = $chatBody[0];
                if (chatBodyElement) {
                    chatBodyElement.scrollTop = chatBodyElement.scrollHeight;
                }
            }, 100);
        }

        // Click outside to close chatbox
        $(document).off('click.chatbox').on('click.chatbox', function (event) {
            if (!hieuThuocIsOpen) return;

            const clickedInsideChat = $(event.target).closest('#hieuThuocChatboxContainer, #chatbox-btn').length > 0;

            if (!clickedInsideChat) {
                closehieuThuocChatbox();
            }
        });

        // Show initial badge after 5 seconds (demo purpose)
        setTimeout(function() {
            if (!hieuThuocIsOpen) {
                showhieuThuocBadge();
            }
        }, 5000);
        $(window).on('beforeunload', function () {
            if (messagePollingInterval) {
                clearInterval(messagePollingInterval);
            }
        });

        const $miniCart = $('#mini-cart');
        const $overlay = $('#mini-cart-overlay');
        const $cartBody = $miniCart.find('.mini-cart-body');
        const $cartTotal = $('#mini-cart-total');
        const $cartCount = $('#cart-count');

        // Hàm tiện ích: format tiền
        function fmt(n) {
            return Number(n || 0).toLocaleString('vi-VN') + ' đ';
        }

        // Mở giỏ hàng mini
        function openMiniCart() {
            $miniCart.addClass('open');
            $overlay.addClass('show');
        }

        // Đóng giỏ hàng mini
        function closeMiniCart() {
            $miniCart.removeClass('open');
            $overlay.removeClass('show');
        }

        // Tải nội dung giỏ hàng mini
        function loadMiniCart() {
            $cartBody.html('<div class="mini-cart-empty text-center">Đang tải...</div>');
            $.ajax({
                url: '@Url.Action("GetMiniCart", "Cart")',
                type: 'GET',
                dataType: 'json',
                success: function (res) {
                    if (!res || !res.items || res.items.length === 0) {
                        $cartBody.html('<div class="mini-cart-empty text-center">Giỏ hàng trống</div>');
                        updateCartDisplay();
                        return;
                    }
                    renderMiniCart(res.items);
                },
                error: function () {
                    $cartBody.html('<div class="mini-cart-empty text-danger text-center">Lỗi tải giỏ hàng</div>');
                    updateCartDisplay(0, 0);
                    toastr.error('Lỗi: Không thể tải giỏ hàng.');
                }
            });
        }

        function updateCartDisplay() {
            let total = 0;
            let countSelected = 0;
            let countAll = 0;

            $('.mini-cart-item').each(function () {
                const $item = $(this);

                const qty = parseInt($item.find('.quantity').val(), 10) || 0;
                const price = parseFloat($item.data('unitPrice')) || 0;
                countAll += qty;

                if ($item.find('.cart-select').is(':checked')) {
                    total += qty * price;
                    countSelected += qty;
                }
            });
            $cartTotal.text(fmt(total));
            $cartCount.text(countAll);
        }

        // Tạo HTML cho giỏ hàng mini
        function renderMiniCart(items) {
            $cartBody.empty();
            let html = '';
            let total = 0;
            let count = 0;

            items.forEach(function (it) {
                const cartItemId = it.CartItemId;
                const image = it.ProductImage || 'https://localhost:44310/images/no-image.png';
                const name = it.ProductName || it.Name || '';
                const price = Number(it.UnitPrice || it.Price || 0);
                const qty = Number(it.Quantity || 0);

                // Căn cứ vào trạng thái từ server để đặt thuộc tính "checked"
                const isChecked = it.Status === true ? "checked" : "";

                if (it.Status === 1) {
                    total += price * qty;
                    count += qty;
                }

                html += `
                    <div class="mini-cart-item" data-cart-item-id="${cartItemId}" data-unit-price="${price}">
                        <input type="checkbox" class="cart-select me-2" ${isChecked} />
                        <img src="${image}" alt="${name}" />
                        <div class="mini-cart-item-details">
                            <h6>${name}</h6>
                            <div class="price">${fmt(price)}</div>
                            <div class="mini-qty">
                                <button type="button" class="btn btn-outline-secondary btn-sm btn-minus">-</button>
                                <input type="number" min="1" class="quantity form-control" value="${qty}">
                                <button type="button" class="btn btn-outline-secondary btn-sm btn-plus">+</button>
                            </div>
                        </div>
                        <button type="button" class="btn btn-sm btn-outline-danger btn-remove" title="Xóa">
                            <i class="fas fa-trash"></i>
                        </button>
                    </div>
                `;
            });

            // Gán toàn bộ chuỗi HTML vào body một lần duy nhất
            $cartBody.html(html);
            // Cập nhật hiển thị sau khi đã render xong
            updateCartDisplay();
        }

        // Tải lại giỏ hàng khi người dùng mở lần đầu
        $('#cart-toggle').on('click', function (e) {
            e.preventDefault();
            loadMiniCart();
            openMiniCart();
        });

        // Đóng giỏ hàng
        $('#close-mini-cart, #mini-cart-overlay').on('click', function () {
            closeMiniCart();
        });

        // Xử lý sự kiện cập nhật số lượng
        $miniCart.on('click', '.btn-plus, .btn-minus', function () {
            const $item = $(this).closest('.mini-cart-item');
            const cartItemId = $item.attr('data-cart-item-id');
            const $input = $item.find('.quantity');
            let qty = parseInt($input.val() || 0, 10);

            if ($(this).hasClass('btn-plus')) {
                qty++;
            } else if (qty > 1) {
                qty--;
            }

            $input.val(qty);

            $.ajax({
                url: '@Url.Action("UpdateQuantity", "Cart")',
                type: 'POST',
                data: { cartItemId: cartItemId, quantity: qty },
                dataType: 'json',
                success: function (res) {
                    if (res?.success) {
                        toastr.success('Cập nhật giỏ hàng thành công!');
                        loadMiniCart(); // Tải lại giỏ hàng để cập nhật tổng tiền
                        updateCartCount();
                    } else {
                        toastr.error(res?.message || 'Cập nhật thất bại.');
                        loadMiniCart();
                    }
                },
                error: function () {
                    toastr.error('Lỗi: Không kết nối được server.');
                    loadMiniCart();
                }
            });
        });

        // Xử lý sự kiện xóa sản phẩm
        $miniCart.on('click', '.btn-remove', function () {
            if (!confirm('Bạn có chắc chắn muốn xóa sản phẩm này không?')) {
                return;
            }

            const $item = $(this).closest('.mini-cart-item');
            const cartItemId = $item.attr('data-cart-item-id');

            $.ajax({
                url: '@Url.Action("RemoveItem", "Cart")',
                type: 'POST',
                data: { cartItemId: cartItemId },
                dataType: 'json',
                success: function (res) {
                    if (res?.success) {
                        $item.fadeOut(300, function () {
                            $(this).remove();
                            loadMiniCart(); // Tải lại giỏ hàng để cập nhật tổng tiền và số lượng
                            updateCartCount();
                        });
                        toastr.success('Sản phẩm đã được xóa khỏi giỏ hàng.');
                    } else {
                        toastr.error(res?.message || 'Xóa sản phẩm thất bại.');
                        loadMiniCart();
                    }
                },
                error: function () {
                    toastr.error('Lỗi: Có lỗi khi kết nối đến server.');
                }
            });
        });

        // Xử lý cập nhật trạng thái
        $miniCart.on('change', '.cart-select', function () {
            const $item = $(this).closest('.mini-cart-item');
            const cartItemId = $item.data('cart-item-id');
            const isChecked = $(this).is(':checked');

            $.ajax({
                url: '/Cart/UpdateStatus',
                type: 'POST',
                data: { cartItemId: cartItemId, status: isChecked },
                dataType: 'json',
                success: function (res) {
                    if (res?.success) {
                        toastr.success('Cập nhật trạng thái sản phẩm thành công');
                        //loadMiniCart(); // Tải lại giỏ hàng để cập nhật tổng tiền
                        updateCartDisplay()
                    } else {
                        toastr.error(res?.message || 'Cập nhật trạng thái thất bại.');
                        // Khôi phục trạng thái checkbox nếu cập nhật thất bại
                        $item.find('.cart-select').prop('checked', !isChecked);
                    }
                },
                error: function () {
                    toastr.error('Lỗi: Không kết nối được server.');
                }
            });
        });
    });
    </script>

</body>
</html>