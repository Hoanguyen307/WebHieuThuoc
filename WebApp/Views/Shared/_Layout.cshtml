<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <title>@ViewBag.Title - Mỹ phẩm chính hãng</title>
    <link rel="shortcut icon" href="~/Content/assets/images/Logo/Logo2.png">
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@600&display=swap" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" rel="stylesheet" />
    <link href="~/Content/assets/css/GiaoDien.css" rel="stylesheet" />

    @RenderSection("Styles", required: false)

    <!-- JS -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>

</head>
<body>
    <div class="bg-pink text-white text-center py-1 small">
        Freeship 15K mọi đơn hàng &nbsp; • &nbsp; Quà tặng cho đơn từ 499K &nbsp; • &nbsp; Giao hàng 24H
    </div>

    <header class="header">
        <div class="container-fluid">
            <div class="d-flex justify-content-between align-items-center">
                <a href="@Url.Action("Index", "Home1")" class="logo logo-dark" style="margin-left: 190px;">
                    <span class="logo-sm">
                        <img src="~/Content/assets/images/Logo/Logo3.png" alt="" height="100">
                    </span>
                    @*<span class="logo-lg">
                            <img src="~/Content/assets/images/Logo/Logo2.png" alt="" height="70">
                        </span>*@
                </a>
                @*<a href="/" class="text-decoration-none fs-3">
                        <img src="~/Content/assets/images/Logo/Logo2.png" alt="" height="70" />
                        <span class="logo-text">Hoà <span class="text-pink">Đại</span> <span class="text-gradient">Nhân</span></span>
                    </a>*@

                <div class="header-right d-flex align-items-center gap-4">
                    @* Tìm đến div có class "search-box" *@
                    <div class="search-box">
                        @using (Html.BeginForm("Search", "Products", FormMethod.Get))
                        {
                            <input type="text" name="searchString" placeholder="Mua 1 Tặng 1 Kem Chống Nắng" value="@ViewBag.SearchString" />
                            <button type="submit" class="btn btn-link p-0"><i class="fas fa-search"></i></button>
                        }
                    </div>

                    <div class="header-item">
                        <i class="fas fa-newspaper"></i>
                        <span>Tạp chí làm đẹp</span>
                    </div>
                    <div class="header-item">
                        <i class="fas fa-ellipsis-h"></i>
                    </div>
                    <div class="divider"></div>
                    @if (Session["Login"] != null)
                    {
                        var kh = Session["Login"] as Models.KhachHang;
                        <div class="dropdown header-item">
                            <button class="btn btn-link nav-link dropdown-toggle d-flex align-items-center text-decoration-none text-dark"
                                    id="userDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="fas fa-user me-2"></i>
                                <span>@kh.FullName</span>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="userDropdown">
                                <li>
                                    <a class="dropdown-item" href="@Url.Action("UpdateInfo", "KhachHang")">
                                        <i class="fas fa-id-card me-2"></i> Thông tin cá nhân
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item" href="/Order/History">
                                        <i class="fa fa-box"></i> Đơn hàng của tôi
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item" href="@Url.Action("LogOff", "Account")">
                                        <i class="fas fa-sign-out-alt me-2"></i> Đăng xuất
                                    </a>
                                </li>
                            </ul>
                        </div>
                    }
                    else
                    {
                        <a href="@Url.Action("Login", "Account")" class="header-item">
                            <i class="fas fa-user"></i>
                            <span>Đăng nhập</span>
                        </a>
                    }


                    <div class="header-icon"><i class="far fa-heart"></i></div>
                    <a id="cart-toggle" href="javascript:void(0)" class="header-icon position-relative">
                        <i class="fas fa-shopping-cart"></i>
                        <span id="cart-count" class="cart-badge position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
                            @(ViewBag.CartCount ?? 0)
                        </span>
                    </a>


                </div>
            </div>
        </div>
    </header>

    <div id="mini-cart" class="mini-cart shadow">
        <div class="mini-cart-header d-flex justify-content-between align-items-center">
            <div>
                <h5 class="mb-0">Giỏ hàng</h5>
                <small class="text-muted">Sản phẩm của bạn</small>
            </div>
            <div>
                <button id="close-mini-cart" class="btn btn-sm btn-outline-secondary" title="Đóng">&times;</button>
            </div>
        </div>

        <div class="mini-cart-body">
            <div class="mini-cart-empty">Đang tải...</div>
        </div>

        <div class="mini-cart-footer">
            <div class="d-flex justify-content-between align-items-center mb-1">
                <strong>Tổng cộng:</strong>
                <span id="mini-cart-total" class="text-danger fw-bold">0 đ</span>
            </div>
            @*<a href="@Url.Action("Index","Cart")" class="btn btn-outline-primary w-100 mb-2">Xem giỏ hàng</a>*@
            <a href="@Url.Action("Checkout","Cart")" class="btn btn-success w-100">Thanh toán</a>
        </div>
    </div>
    <div id="mini-cart-overlay" class="mini-cart-overlay"></div>

    <div class="container mb-2">
        <div class="d-flex flex-wrap gap-2">
            <button class="btn btn-outline-secondary rounded-pill">Thương hiệu</button>
            <button class="btn btn-outline-secondary rounded-pill">Khuyến mãi hot</button>
            <button class="btn btn-outline-secondary rounded-pill">Sản phẩm cao cấp</button>
            <button class="btn btn-outline-secondary rounded-pill">Trang điểm</button>
            <button class="btn btn-outline-secondary rounded-pill">Chăm sóc da</button>
            <button class="btn btn-outline-secondary rounded-pill">Chăm sóc cá nhân</button>
            <button class="btn btn-outline-secondary rounded-pill">Chăm sóc cơ thể</button>
            <button class="btn btn-outline-secondary rounded-pill">Sản phẩm mới</button>
        </div>
    </div>

    <div class="container mt-3">
        @RenderBody()
    </div>

    <footer class="footer">
        <div class="container">
            <div class="row text-center text-md-left">
                <div class="col-md-4 mb-4">
                    <h4>Thông Tin Liên Hệ</h4>
                    <p><strong>Địa chỉ:</strong> Ngô Phần, Bình Định, Lương Tài, Bắc Ninh</p>
                    <p><strong>Điện thoại:</strong> 0979 310 351</p>
                    <p><strong>Email:</strong> hoanguyen3072003@gmail.com</p>
                </div>
            </div>
        </div>
    </footer>

    @RenderSection("Scripts", required: false)
<script>
        $(document).ready(function () {
    const $miniCart = $('#mini-cart');
    const $overlay = $('#mini-cart-overlay');
    const $cartBody = $miniCart.find('.mini-cart-body');
    const $cartTotal = $('#mini-cart-total');
    const $cartCount = $('#cart-count');

    // Hàm tiện ích: format tiền
    function fmt(n) {
        return Number(n || 0).toLocaleString('vi-VN') + ' đ';
    }

    // Mở giỏ hàng mini
    function openMiniCart() {
        $miniCart.addClass('open');
        $overlay.addClass('show');
    }

    // Đóng giỏ hàng mini
    function closeMiniCart() {
        $miniCart.removeClass('open');
        $overlay.removeClass('show');
    }

    // Tải nội dung giỏ hàng mini
    function loadMiniCart() {
        $cartBody.html('<div class="mini-cart-empty text-center">Đang tải...</div>');
        $.ajax({
            url: '@Url.Action("GetMiniCart", "Cart")',
            type: 'GET',
            dataType: 'json',
            success: function (res) {
                if (!res || !res.items || res.items.length === 0) {
                    $cartBody.html('<div class="mini-cart-empty text-center">Giỏ hàng trống</div>');
                    updateCartDisplay(0, 0);
                    return;
                }
                renderMiniCart(res.items);
                const total = res.items.reduce((s, it) => s + (it.UnitPrice * it.Quantity), 0);
                const count = res.items.reduce((s, it) => s + it.Quantity, 0);
                updateCartDisplay(total, count);
            },
            error: function () {
                $cartBody.html('<div class="mini-cart-empty text-danger text-center">Lỗi tải giỏ hàng</div>');
                updateCartDisplay(0, 0);
                toastr.error('Lỗi: Không thể tải giỏ hàng.');
            }
        });
    }

    // Cập nhật hiển thị tổng tiền và số lượng sản phẩm
    function updateCartDisplay(total, count) {
        $cartTotal.text(fmt(total));
        $cartCount.text(count);
    }

    // Tạo HTML cho giỏ hàng mini
    function renderMiniCart(items) {
                debugger
        $cartBody.empty();
        items.forEach(function (it) {
            const cartItemId = it.CartItemId;
            const image = it.ProductImage || 'https://localhost:44310/images/no-image.png';
            const name = it.ProductName || it.Name || '';
            const price = Number(it.UnitPrice || it.Price || 0);
            const qty = Number(it.Quantity || 0);

            const $item = $(`
                <div class="mini-cart-item" data-cart-item-id="${cartItemId}" data-unit-price="${price}">
                    <input type="checkbox" class="cart-select me-2" ${it.Status === 1 ? 'checked' : ''} />
                    <img src="${image}" alt="${name}" />
                    <div class="mini-cart-item-details">
                        <h6>${name}</h6>
                        <div class="price">${fmt(price)}</div>
                        <div class="mini-qty">
                            <button type="button" class="btn btn-outline-secondary btn-sm btn-minus">-</button>
                            <input type="number" min="1" class="quantity form-control" value="${qty}">
                            <button type="button" class="btn btn-outline-secondary btn-sm btn-plus">+</button>
                        </div>
                    </div>
                    <button type="button" class="btn btn-sm btn-outline-danger btn-remove" title="Xóa">
                        <i class="fas fa-trash"></i>
                    </button>
                </div>
            `);
            $cartBody.append($item);
        });
    }

    // Tải lại giỏ hàng khi người dùng mở lần đầu
    $('#cart-toggle').on('click', function (e) {
        e.preventDefault();
        loadMiniCart();
        openMiniCart();
    });

    // Đóng giỏ hàng
    $('#close-mini-cart, #mini-cart-overlay').on('click', function () {
        closeMiniCart();
    });

    // Xử lý sự kiện cập nhật số lượng
    $miniCart.on('click', '.btn-plus, .btn-minus', function () {
                debugger
                const $item = $(this).closest('.mini-cart-item');
                const cartItemId = $item.attr('data-cart-item-id');
                const $input = $item.find('.quantity');
                let qty = parseInt($input.val() || 0, 10);

        if ($(this).hasClass('btn-plus')) {
            qty++;
        } else if (qty > 1) {
            qty--;
        }

        $input.val(qty);

        $.ajax({
            url: '@Url.Action("UpdateQuantity", "Cart")',
            type: 'POST',
            data: { cartItemId: cartItemId, quantity: qty },
            dataType: 'json',
            success: function (res) {
                if (res?.success) {
                    loadMiniCart();
                    toastr.success('Cập nhật giỏ hàng thành công!');
                } else {
                    toastr.error(res?.message || 'Cập nhật thất bại.');
                    loadMiniCart(); // Khôi phục trạng thái cũ
                }
            },
            error: function () {
                toastr.error('Lỗi: Không kết nối được server.');
                loadMiniCart(); // Khôi phục trạng thái cũ
            }
        });
    });

    // Xử lý sự kiện xóa sản phẩm
    $miniCart.on('click', '.btn-remove', function () {
        if (!confirm('Bạn có chắc chắn muốn xóa sản phẩm này không?')) {
            return;
        }

        const $item = $(this).closest('.mini-cart-item');
        const cartItemId = $item.attr('data-cart-item-id');

        $.ajax({
            url: '@Url.Action("RemoveItem", "Cart")',
            type: 'POST',
            data: { cartItemId: cartItemId },
            dataType: 'json',
            success: function (res) {
                if (res?.success) {
                    $item.fadeOut(300, function () {
                        $(this).remove();
                        loadMiniCart();
                    });
                    toastr.success('Sản phẩm đã được xóa khỏi giỏ hàng.');
                } else {
                    toastr.error(res?.message || 'Xóa sản phẩm thất bại.');
                    loadMiniCart(); // Khôi phục trạng thái cũ
                }
            },
            error: function () {
                toastr.error('Lỗi: Có lỗi khi kết nối đến server.');
            }
        });
    });

    $miniCart.on('change', '.cart-select', function () {
    const $item = $(this).closest('.mini-cart-item');
    const cartItemId = $item.data('cart-item-id');
    const isChecked = $(this).is(':checked');

    $.ajax({
        url: '@Url.Action("UpdateStatus", "Cart")',
        type: 'POST',
        data: { cartItemId: cartItemId, status: isChecked ? 1 : 0 },
        dataType: 'json',
        success: function (res) {
            if (res?.success) {
                toastr.success('Cập nhật trạng thái sản phẩm thành công');
            } else {
                toastr.error(res?.message || 'Cập nhật trạng thái thất bại.');
            }
        },
        error: function () {
            toastr.error('Lỗi: Không kết nối được server.');
        }
    });
});

});
</script>

</body>
</html>