<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <title>@ViewBag.Title - Mỹ phẩm chính hãng</title>
    <link rel="shortcut icon" href="~/Content/assets/images/Logo/Logo2.png">
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@600&display=swap" rel="stylesheet">
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <link href="~/Content/assets/css/GiaoDien.css" rel="stylesheet" />
    @RenderSection("Styles", required: false)
</head>
<body>
    <div class="bg-pink text-white text-center py-1 small">
        Freeship 15K mọi đơn hàng &nbsp; • &nbsp; Quà tặng cho đơn từ 499K &nbsp; • &nbsp; Giao hàng 24H
    </div>

    <header class="header">
        <div class="container-fluid">
            <div class="d-flex justify-content-between align-items-center">
                <a href="@Url.Action("Index", "Home1")" class="logo logo-dark">
                    <span class="logo-sm">
                        <img src="~/Content/assets/images/Logo/Logo2.png" alt="" height="100">
                    </span>
                    @*<span class="logo-lg">
                        <img src="~/Content/assets/images/Logo/Logo2.png" alt="" height="70">
                    </span>*@
                </a>
                @*<a href="/" class="text-decoration-none fs-3">
                    <img src="~/Content/assets/images/Logo/Logo2.png" alt="" height="70" />
                    <span class="logo-text">Hoà <span class="text-pink">Đại</span> <span class="text-gradient">Nhân</span></span>
                </a>*@

                <div class="header-right d-flex align-items-center gap-4">
                    <div class="search-box">
                        <i class="fas fa-search"></i>
                        <input type="text" placeholder="Mua 1 Tặng 1 Kem Chống Nắng" />
                        <i class="fas fa-camera"></i>
                    </div>

                    <div class="header-item">
                        <i class="fas fa-newspaper"></i>
                        <span>Tạp chí làm đẹp</span>
                    </div>
                    <div class="header-item">
                        <i class="fas fa-ellipsis-h"></i>
                    </div>
                    <div class="divider"></div>
                    <div class="header-item">
                        <i class="fas fa-user"></i>
                        <span>Đăng nhập</span>
                    </div>
                    <div class="header-icon"><i class="far fa-heart"></i></div>
                    <a id="cart-toggle" href="javascript:void(0)" class="header-icon position-relative">
                        <i class="fas fa-shopping-cart"></i>
                        <span id="cart-count" class="cart-badge position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
                            @(ViewBag.CartCount ?? 0)
                        </span>
                    </a>


                </div>
            </div>
        </div>
    </header>

    <div id="mini-cart" class="mini-cart shadow">
        <div class="mini-cart-header d-flex justify-content-between align-items-center">
            <div>
                <h5 class="mb-0">Giỏ hàng</h5>
                <small class="text-muted">Sản phẩm của bạn</small>
            </div>
            <div>
                <button id="close-mini-cart" class="btn btn-sm btn-outline-secondary" title="Đóng">&times;</button>
            </div>
        </div>

        <div class="mini-cart-body">
            <div class="mini-cart-empty">Đang tải...</div>
        </div>

        <div class="mini-cart-footer">
            <div class="d-flex justify-content-between align-items-center mb-1">
                <strong>Tổng cộng:</strong>
                <span id="mini-cart-total" class="text-danger fw-bold">0 đ</span>
            </div>
            @*<a href="@Url.Action("Index","Cart")" class="btn btn-outline-primary w-100 mb-2">Xem giỏ hàng</a>*@
            <a href="@Url.Action("Checkout","Cart")" class="btn btn-success w-100">Thanh toán</a>
        </div>
    </div>
    <div id="mini-cart-overlay" class="mini-cart-overlay"></div>

    <div class="container mb-2">
        <div class="d-flex flex-wrap gap-2">
            <button class="btn btn-outline-secondary rounded-pill">Thương hiệu</button>
            <button class="btn btn-outline-secondary rounded-pill">Khuyến mãi hot</button>
            <button class="btn btn-outline-secondary rounded-pill">Sản phẩm cao cấp</button>
            <button class="btn btn-outline-secondary rounded-pill">Trang điểm</button>
            <button class="btn btn-outline-secondary rounded-pill">Chăm sóc da</button>
            <button class="btn btn-outline-secondary rounded-pill">Chăm sóc cá nhân</button>
            <button class="btn btn-outline-secondary rounded-pill">Chăm sóc cơ thể</button>
            <button class="btn btn-outline-secondary rounded-pill">Sản phẩm mới</button>
        </div>
    </div>

    <div class="container mt-3">
        @RenderBody()
    </div>

    <footer class="footer">
        <div class="container">
            <div class="row text-center text-md-left">
                <div class="col-md-4 mb-4">
                    <h4>Thông Tin Liên Hệ</h4>
                    <p><strong>Địa chỉ:</strong> Ngô Phần, Bình Định, Lương Tài, Bắc Ninh</p>
                    <p><strong>Điện thoại:</strong> 0979 310 351</p>
                    <p><strong>Email:</strong> hoanguyen3072003@gmail.com</p>
                </div>
            </div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    @RenderSection("Scripts", required: false)
    <script>
        $(document).ready(function () {
            const $miniCart = $('#mini-cart');
            const $overlay = $('#mini-cart-overlay');
            const $cartBody = $miniCart.find('.mini-cart-body');
            const $cartTotal = $('#mini-cart-total');
            const $cartCount = $('#cart-count');

            // format tiền
            function fmt(n) {
                return Number(n || 0).toLocaleString('vi-VN') + ' đ';
            }
            function parseNumberFromText(txt) {
                if (!txt) return 0;
                return Number(String(txt).replace(/[^\d.-]/g, '')) || 0;
            }

            $('#cart-toggle').on('click', function (e) {
                e.preventDefault();
                loadMiniCart();
                $miniCart.addClass('open');
                $overlay.addClass('show');
            });


            $('#close-mini-cart, #mini-cart-overlay').on('click', function () {
                closeMiniCart();
            });

            function closeMiniCart() {
                $miniCart.removeClass('open');
                $overlay.removeClass('show');
            }

            function loadMiniCart() {
                $cartBody.html('<div class="mini-cart-empty">Đang tải...</div>');
                $.getJSON('/Cart/GetMiniCart')
                    .done(function (res) {
                        if (!res || !res.items || res.items.length === 0) {
                            $cartBody.html('<div class="mini-cart-empty">Giỏ hàng trống</div>');
                            $cartTotal.text('0 đ');
                            $cartCount.text('0');
                            return;
                        }

                        renderMiniCart(res.items);
                        const totalFromServer = res.total !== undefined ? res.total : res.items.reduce((s, it) => s + (it.UnitPrice * it.Quantity), 0);
                        $cartTotal.text(fmt(totalFromServer));
                        $cartCount.text(res.items.reduce((s, it) => s + it.Quantity, 0));
                    })
                    .fail(function () {
                        $cartBody.html('<div class="mini-cart-empty text-danger">Lỗi tải giỏ hàng</div>');
                    });
            }

            function renderMiniCart(items) {
                $cartBody.empty();
                items.forEach(function (it) {
                    const cartItemId = it.Id || it.id;
                    const image = it.Image || '/images/no-image.png';
                    const name = it.ProductName || it.Name || '';
                    const price = Number(it.UnitPrice || it.Price || 0);
                    const qty = Number(it.Quantity || 0);

                    const $item = $('<div/>', { 'class': 'mini-cart-item', 'data-id': cartItemId, 'data-unit-price': price });
                    const $img = $('<img/>', { src: image, alt: name });
                    const $details = $('<div/>', { 'class': 'mini-cart-item-details' });
                    const $title = $('<h6/>').text(name);
                    const $price = $('<div/>', { 'class': 'price' }).text(fmt(price));
                    const $meta = $('<div/>', { 'class': 'meta' }).text('Số lượng: ' + qty);

                    const $qtyWrap = $('<div/>', { 'class': 'mini-qty' });
                    const $btnMinus = $('<button/>', { 'class': 'btn btn-outline-secondary btn-sm btn-minus', type: 'button' }).text('-');
                    const $inputQty = $('<input/>', { type: 'number', min: 1, 'class': 'quantity form-control', value: qty });
                    const $btnPlus = $('<button/>', { 'class': 'btn btn-outline-secondary btn-sm btn-plus', type: 'button' }).text('+');

                    $qtyWrap.append($btnMinus).append($inputQty).append($btnPlus);

                    $details.append($title).append($price).append($qtyWrap);

                    const $btnRemove = $('<button/>', { 'class': 'btn btn-sm btn-outline-danger btn-remove', title: 'Xóa', type: 'button' }).html('<i class="fas fa-trash"></i>');

                    $item.append($img).append($details).append($btnRemove);
                    $cartBody.append($item);
                });

            }

            $miniCart.on('click', '.btn-plus, .btn-minus', function () {
                const $input = $(this).siblings('.quantity');
                let q = parseInt($input.val() || 0, 10);
                if ($(this).hasClass('btn-plus')) {
                    q++;
                } else if (q > 1) {
                    q--;
                }
                $input.val(q).trigger('change');
            });

            $miniCart.on('change', '.quantity', function () {
                const $item = $(this).closest('.mini-cart-item');
                const cartItemId = $item.data('id');
                let qty = parseInt($(this).val() || 0, 10);
                if (qty < 1) qty = 1;

                $.post('/Cart/UpdateQuantity', { cartItemId, quantity: qty })
                    .done(function (res) {
                        if (res?.success) {
                            recalcMiniTotals();
                        } else {
                            alert(res?.message || 'Cập nhật thất bại');
                            loadMiniCart();
                        }
                    })
                    .fail(function () {
                        alert('Không kết nối được server');
                        loadMiniCart();
                    });
            });

            $miniCart.on('click', '.btn-remove', function () {
                const $item = $(this).closest('.mini-cart-item');
                const cartItemId = $item.data('id');

                if (!confirm('Xóa sản phẩm khỏi giỏ hàng?')) return;

                $.post('/Cart/RemoveItem', { cartItemId: cartItemId })
                    .done(function (res) {
                        if (res && res.success) {
                            $item.remove();
                            recalcMiniTotals();
                        } else {
                            alert(res && res.message ? res.message : 'Xóa thất bại');
                        }
                    })
                    .fail(function () {
                        alert('Có lỗi khi kết nối đến server.');
                    });
            });

            function recalcMiniTotals() {
                let total = 0;
                let count = 0;
                $miniCart.find('.mini-cart-item').each(function () {
                    const $it = $(this);
                    const unit = Number($it.data('unit-price') || 0);
                    const qty = Number($it.find('.quantity').val() || 0);
                    total += unit * qty;
                    count += qty;
                });
                $cartTotal.text(fmt(total));
                $cartCount.text(count);
            }
            window.reloadMiniCart = function () {
                if ($miniCart.hasClass('open')) {
                    loadMiniCart();
                } else {
                    $.getJSON('/Cart/GetMiniCart')
                        .done(function (res) {
                            if (res && res.items) {
                                const totalQty = res.items.reduce((s, it) => s + (it.Quantity || 0), 0);
                                $cartCount.text(totalQty);
                            }
                        });
                }
            };
        });
    </script>

</body>
</html>