@model List<Models.Post>
<style>
    .line-clamp-2 {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .line-clamp-3 {
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .hover-pink:hover {
        color: #28a745 !important;
    }

    .btn-view-all:hover {
        background-color: #000;
        color: #fff;
    }

    .object-fit-cover {
        object-fit: cover;
    }
</style>
<div class="container mt-5 mb-5">
    <div class="text-center mb-5">
        <h3 class="fw-bold" style="letter-spacing: 2px; font-family: 'Segoe UI', sans-serif; font-size: 24px;">BÀI VIẾT MỚI NHẤT</h3>
    </div>

    <div class="row g-4">
        @foreach (var item in Model)
        {
            string imageUrl = string.IsNullOrEmpty(item.AnhDaiDien)
            ? "/Content/assets/images/noimage.png"
            : item.AnhDaiDien;

            <div class="col-md-4">
                <div class="blog-item-card h-100 d-flex flex-column border-0">
                    <div class="img-thumb-box mb-3" style="aspect-ratio: 16/9; overflow: hidden; border-radius: 12px; background: #f8f8f8;">
                        <a href="@Url.Action("Details", "BaiViet", new { id = item.Id })">
                            <img src="@imageUrl" class="w-100 h-100 object-fit-cover" alt="@item.TieuDe"
                                 style="transition: transform 0.5s ease;" onmouseover="this.style.transform='scale(1.08)'" onmouseout="this.style.transform='scale(1)'">
                        </a>
                    </div>

                    <div class="content-box">
                        <h6 class="fw-bold mb-2 line-clamp-2" style="font-size: 16px; min-height: 44px;">
                            <a href="@Url.Action("Details", "BaiViet", new { id = item.Id })" class="text-dark text-decoration-none hover-pink">
                                @item.TieuDe
                            </a>
                        </h6>

                        <div class="small text-secondary mb-0 line-clamp-3" style="line-height: 1.6;">
                            @{
                                var decoded = HttpUtility.HtmlDecode(item.NoiDung ?? "");
                                var plainText = System.Text.RegularExpressions.Regex.Replace(decoded, "<.*?>", string.Empty);
                            }
                            @plainText
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    <div class="text-center mt-5">
        <a href="/BaiViet" class="btn btn-outline-dark rounded-pill px-5 py-2 fw-bold btn-view-all" style="font-size: 13px; transition: 0.3s;">Tất cả bài viết</a>
    </div>
</div>