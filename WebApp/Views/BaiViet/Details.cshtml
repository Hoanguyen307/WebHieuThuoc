@model Models.Post
@{
    ViewBag.Title = Model.TieuDe;
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .post-detail-wrapper {
        background-color: #fff;
    }

    .post-main-title {
        font-size: 2.2rem;
        line-height: 1.2;
        margin-bottom: 0.5rem;
    }

    .post-entry-content {
        line-height: 1.7;
        color: #333;
        font-family: 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
    }

        .post-entry-content img {
            max-width: 100% !important;
            height: auto !important;
            display: block;
            margin: 20px auto;
            border-radius: 12px;
        }

        .post-entry-content h2, .post-entry-content h3 {
            font-weight: 700;
            margin-top: 2rem;
            margin-bottom: 1rem;
            color: #000;
        }

        .post-entry-content ul, .post-entry-content ol {
            margin-bottom: 1.5rem;
            padding-left: 1.2rem;
        }

        .post-entry-content li {
            margin-bottom: 0.5rem;
        }

        .post-entry-content table {
            width: 100% !important;
            margin-bottom: 1rem;
            border-collapse: collapse;
        }

            .post-entry-content table td, .post-entry-content table th {
                border: 1px solid #dee2e6;
                padding: 8px;
            }
</style>
@{
    string imageUrl = string.IsNullOrEmpty(Model.AnhDaiDien)
        ? "/Content/assets/images/noimage.png"
        : Model.AnhDaiDien;
}

<article class="post-detail-wrapper mt-5 mb-5">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-8 col-md-10">
                <nav aria-label="breadcrumb" class="mb-3">
                    <ol class="breadcrumb bg-transparent p-0 small">
                        <li class="breadcrumb-item"><a href="/" class="text-muted">Trang chủ</a></li>
                        <li class="breadcrumb-item"><a href="/BaiViet" class="text-muted">Blog</a></li>
                    </ol>
                </nav>

                <header class="post-header mb-4">
                    <h1 class="post-main-title fw-bold text-dark">@Model.TieuDe</h1>
                    <div class="post-meta text-muted small mt-2">
                        <span>@Model.CreatedDate</span>
                    </div>
                </header>

                @if (!string.IsNullOrEmpty(Model.AnhDaiDien))
                {
                    <div class="post-feature-image mb-4">
                        <img src="@imageUrl" class="img-fluid rounded-3 shadow-sm w-100" alt="@Model.TieuDe">
                    </div>
                }

                <div class="post-entry-content fs-6">
                    @Html.Raw(Model.NoiDung)
                </div>

                <footer class="post-footer mt-5 pt-4 border-top">
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="text-muted">Danh mục: <strong>@Model.LoaiDanhMuc</strong></span>
                        <a href="/BaiViet" class="btn btn-outline-dark btn-sm rounded-pill px-4">Quay lại</a>
                    </div>
                </footer>
            </div>
        </div>
    </div>
</article>