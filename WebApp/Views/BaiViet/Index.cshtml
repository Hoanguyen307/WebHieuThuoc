@model List<Models.Post>
@{
    ViewBag.Title = "Cẩm nang làm đẹp";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<style>
    .btn-filter {
        border: 1px solid #ddd;
        background: #fff;
        padding: 7px 18px;
        border-radius: 8px;
        font-size: 14px;
        transition: 0.3s;
    }

        .btn-filter.active {
            border-color: #28a745;
            border-width: 2px;
            font-weight: 600;
        }

    .img-thumb-box {
        width: 100%;
        aspect-ratio: 16 / 10;
        overflow: hidden;
        border-radius: 12px;
        border: 1px solid #eee;
    }

    .no-image-placeholder {
        width: 100%;
        height: 100%;
        background-color: #fff;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 15px;
        text-align: center;
    }

    .placeholder-link {
        color: #28a745;
        text-decoration: underline;
        font-size: 14px;
        font-weight: 500;
        display: -webkit-box;
        -webkit-line-clamp: 4;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .fixed-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
    }

    .custom-pager .page-item {
        margin: 0 4px;
    }

    .custom-pager .page-link {
        border-radius: 50% !important;
        width: 35px;
        height: 35px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #333;
        border: none;
    }

    .custom-pager .page-item.active .page-link {
        background-color: transparent;
        color: #000;
        font-weight: bold;
        border: 1px solid #000;
    }

    .line-clamp-3 {
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .custom-pagination .page-item {
        margin: 0 8px;
    }

    .custom-pagination .page-link {
        border: none;
        color: #000;
        font-size: 16px;
        padding: 0;
        width: 40px;
        height: 40px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: transparent;
        transition: 0.3s;
    }

    .custom-pagination .page-item.active .page-link {
        background-color: transparent;
        border: 1.5px solid #000 !important;
        border-radius: 50% !important;
        color: #000;
        font-weight: 500;
    }

    .custom-pagination .page-link:hover {
        background-color: #28a745;
        border-radius: 50%;
    }

    .custom-pagination .next-text {
        width: auto !important;
        padding: 0 10px;
        border-radius: 0 !important;
    }
</style>
<div class="container mt-5">
    <h2 class="mb-4 fw-bold" style="font-family: sans-serif;">Danh mục bài viết</h2>

    <div class="d-flex flex-wrap gap-2 mb-5">
        <button class="btn-filter active" onclick="filterBlog('', this)">Tất cả</button>
        <button class="btn-filter" onclick="filterBlog('Góc review', this)">Góc review</button>
        <button class="btn-filter" onclick="filterBlog('Cách chăm sóc da', this)">Cách chăm sóc da</button>
        <button class="btn-filter" onclick="filterBlog('Xu hướng trang điểm', this)">Xu hướng trang điểm</button>
        <button class="btn-filter" onclick="filterBlog('Bí quyết khỏe đẹp', this)">Bí quyết khỏe đẹp</button>
        <button class="btn-filter" onclick="filterBlog('Sự kiện', this)">Sự kiện</button>
        <button class="btn-filter" onclick="filterBlog('Tin tức', this)">Tin tức</button>
    </div>

    <div id="blog-list-container" class="row g-4">
        @Html.Partial("_BlogListPartial", Model)
    </div>

    <div class="d-flex justify-content-center mt-5 mb-5">
        <nav aria-label="Page navigation">
            <ul class="pagination custom-pagination" id="pagination-buttons">
            </ul>
        </nav>
    </div>
</div>
@section Scripts {
    <script>
        let currentCat = '';
        let currentPage = 1;

        function filterBlog(category, btn) {
            $('.btn-filter').removeClass('active');
            $(btn).addClass('active');
            currentCat = category;
            currentPage = 1;
            loadData();
        }

        function loadData() {
            $.ajax({
                url: '/BaiViet/GetBlogData',
                data: { category: currentCat, page: currentPage },
                success: function (res) {
                    $('#blog-list-container').html(res.html);
                    renderPager(res.totalCount, currentPage);
                }
            });
        }

        function renderPager(total, activePage) {
            let pageSize = 9;
            let totalPages = Math.ceil(total / pageSize);
            let html = '';

            if (totalPages <= 1) {
                $('#pagination-buttons').html('');
                return;
            }

            const delta = 2;
            for (let i = 1; i <= totalPages; i++) {
                if (i === 1 || i === totalPages || (i >= activePage - delta && i <= activePage + delta)) {
                    html += `<li class="page-item ${i === activePage ? 'active' : ''}">
                        <a class="page-link" href="javascript:void(0)" onclick="goToPage(${i})">${i}</a>
                     </li>`;
                } else if (i === activePage - delta - 1 || i === activePage + delta + 1) {
                    html += `<li class="page-item disabled"><span class="page-link">...</span></li>`;
                }
            }

            if (activePage < totalPages) {
                html += `<li class="page-item">
                    <a class="page-link next-text" href="javascript:void(0)" onclick="goToPage(${activePage + 1})">Next</a>
                 </li>`;
            }

            $('#pagination-buttons').html(html);
        }

        function goToPage(p) {
            currentPage = p;
            loadData();
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        $(document).ready(function() {
            renderPager(@ViewBag.TotalCount, @ViewBag.CurrentPage);
        });
    </script>
}