@model List<Models.Order>
@{
    ViewBag.Title = "Đơn hàng của tôi";
    Layout = "~/Views/Shared/_AccountLayout.cshtml";
}

<style>
    .btn-xs {
        font-size: 11px;
        padding: 4px 12px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        font-weight: 600;
    }

    .hover-shadow:hover {
        transform: translateY(-2px);
        box-shadow: 0 .25rem .75rem rgba(0,0,0,.08) !important;
        border-color: #a1efab !important;
    }

    .transition {
        transition: all 0.2s ease-in-out;
    }
    .btn-outline-danger {
        color: #a1efab;
        border-color: #a1efab;
    }

        .btn-outline-danger:hover {
            background-color: #a1efab;
            color: white;
        }

    .order-items-container img {
        border: 1px solid #f0f0f0;
    }

    .timeline {
        position: relative;
        padding-left: 30px;
    }

        .timeline::before {
            content: "";
            position: absolute;
            left: 5px;
            top: 5px;
            bottom: 5px;
            width: 2px;
            background: #dee2e6;
        }

    .timeline-item {
        position: relative;
        padding-bottom: 20px;
    }

        .timeline-item:last-child {
            padding-bottom: 0;
        }

        .timeline-item .dot {
            position: absolute;
            left: -30px;
            top: 4px;
            width: 12px;
            height: 12px;
            background: #0d6efd;
            border-radius: 50%;
            border: 2px solid #fff;
            z-index: 2;
        }

    .timeline-title {
        font-size: 14px;
        font-weight: 600;
        color: #212529;
    }

    .timeline-time {
        font-size: 11px;
        color: #6c757d;
    }

    @@media (min-width: 768px) {
        .border-start-md {
            border-left: 1px solid #dee2e6 !important;
        }
    }


    .nav-tabs .nav-link.active {
        background-color: #ff4fa4;
        border-color: #dee2e6 #dee2e6 #fff;
        color: #fff;
        font-weight: 600;
    }

    .nav-tabs .nav-link:not(.active) {
        color: #6c757d;
    }

    .nav-tabs .nav-link {
        background-color: #f8f9fa;
    }

    .btn-pink {
        background-color: #ff4fa4;
        border-color: #ff4fa4;
        color: #fff;
    }

        .btn-pink:hover {
            background-color: #e54794;
            border-color: #e54794;
        }

    .pagination .page-link {
        color: #a1efab;
        border: 1px solid #eee;
        padding: 0.5rem 0.75rem;
    }

    .pagination .page-item.active .page-link {
        background-color: #a1efab;
        border-color: #a1efab;
        color: white;
    }

    .pagination .page-link:hover {
        background-color: #a1efab;
        color: white;
    }
</style>
<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <h4 class="fw-bold mb-4">Đơn hàng của tôi</h4>
        </div>
    </div>

    <div class="row">
        <div class="col-12">
            <div class="tab-content" id="myOrderTabContent">
                <div class="tab-pane fade show active" id="online-orders" role="tabpanel" aria-labelledby="online-tab">
                    <div id="order-status-buttons" class="d-flex flex-wrap mt-3">
                        <a href="@Url.Action("DonHang", new { status = "" })"
                           class="btn btn-sm btn-outline-secondary me-2 mb-2 @(string.IsNullOrEmpty(ViewBag.CurrentStatus) ? "active" : "")">Tất cả</a>

                        <a href="@Url.Action("DonHang", new { status = "Chờ xác nhận" })"
                           class="btn btn-sm btn-outline-secondary me-2 mb-2 @(ViewBag.CurrentStatus == "Chờ xác nhận" ? "active" : "")">Chờ xác nhận</a>

                        <a href="@Url.Action("DonHang", new { status = "Đã xác nhận" })"
                           class="btn btn-sm btn-outline-secondary me-2 mb-2 @(ViewBag.CurrentStatus == "Đã xác nhận" ? "active" : "")">Đã xác nhận</a>

                        <a href="@Url.Action("DonHang", new { status = "Đang vận chuyển" })"
                           class="btn btn-sm btn-outline-secondary me-2 mb-2 @(ViewBag.CurrentStatus == "Đang vận chuyển" ? "active" : "")">Đang vận chuyển</a>

                        <a href="@Url.Action("DonHang", new { status = "Hoàn thành" })"
                           class="btn btn-sm btn-outline-secondary me-2 mb-2 @(ViewBag.CurrentStatus == "Thành công" ? "active" : "")">Hoàn thành</a>

                        <a href="@Url.Action("DonHang", new { status = "Đã hủy" })"
                           class="btn btn-sm btn-outline-secondary me-2 mb-2 @(ViewBag.CurrentStatus == "Đã hủy" ? "active" : "")">Đã hủy</a>
                    </div>
                    <div class="card shadow-sm p-4 mt-3">
                        @if (Model == null || !Model.Any())
                        {
                            <div class="text-center py-5">
                                <h5 class="text-muted">Bạn chưa có đơn hàng nào</h5>
                                <a href="@Url.Action("Index", "Products")" class="btn btn-pink mt-3">
                                    Tiếp tục mua sắm
                                </a>
                            </div>
                        }
                        else
                        {
                            <div id="order-list">
                                @foreach (var order in Model)
                                {
                                    <div class="order-item p-3 mb-3 border rounded">
                                        <p><strong>Mã đơn hàng:</strong> @order.OrderCode</p>
                                        <p>
                                            <strong>Ngày đặt:</strong>
                                            @if (order.CreatedDate.HasValue)
                                            {
                                                @order.CreatedDate.Value.ToString("dd/MM/yyyy")
                                            }
                                        </p>
                                        <p><strong>Tổng tiền:</strong> @string.Format("{0:N0}", order.TotalAmount) đ</p>
                                        @{
                                            string badgeClass = "bg-secondary";
                                            string textClass = "";
                                            string statusText = order.Status ?? "Chưa rõ";

                                            switch (statusText)
                                            {
                                                case "Hoàn thành":
                                                case "Thành công":
                                                    badgeClass = "bg-success";
                                                    break;
                                                case "Chờ xác nhận":
                                                    badgeClass = "bg-warning";
                                                    textClass = "text-dark";
                                                    break;
                                                case "Đã hủy":
                                                case "Hủy":
                                                    badgeClass = "bg-danger";
                                                    break;
                                                case "Đã xác nhận":
                                                    badgeClass = "bg-primary";
                                                    break;
                                                case "Đang vận chuyển":
                                                case "Người bán đang chuẩn bị đơn hàng":
                                                case "Đã giao cho đơn vị vận chuyển":
                                                    badgeClass = "bg-info";
                                                    textClass = "text-dark";
                                                    break;
                                                default:
                                                    badgeClass = "bg-secondary";
                                                    break;
                                            }
                                        }
                                        <span class="badge @badgeClass @textClass">@statusText</span>

                                        <button type="button"
                                                class="btn btn-sm btn-outline-primary float-end btn-view-detail"
                                                data-id="@order.ID">
                                            Xem chi tiết
                                        </button>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                    @if (ViewBag.TotalPages > 1)
                    {
                        <nav aria-label="Page navigation" class="mt-4">
                            <ul class="pagination justify-content-center">
                                <li class="page-item @(ViewBag.CurrentPage == 1 ? "disabled" : "")">
                                    <a class="page-link" href="@Url.Action("DonHang", new { page = ViewBag.CurrentPage - 1, status = ViewBag.CurrentStatus })">
                                        <i class="fas fa-chevron-left"></i>
                                    </a>
                                </li>

                                @for (int i = 1; i <= ViewBag.TotalPages; i++)
                                {
                                    if (i == 1 || i == ViewBag.TotalPages || (i >= ViewBag.CurrentPage - 2 && i <= ViewBag.CurrentPage + 2))
                                    {
                                        <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                                            <a class="page-link" href="@Url.Action("DonHang", new { page = i, status = ViewBag.CurrentStatus })">@i</a>
                                        </li>
                                    }
                                    else if (i == ViewBag.CurrentPage - 3 || i == ViewBag.CurrentPage + 3)
                                    {
                                        <li class="page-item disabled"><span class="page-link">...</span></li>
                                    }
                                }

                                <li class="page-item @(ViewBag.CurrentPage == ViewBag.TotalPages ? "disabled" : "")">
                                    <a class="page-link" href="@Url.Action("DonHang", new { page = ViewBag.CurrentPage + 1, status = ViewBag.CurrentStatus })">
                                        <i class="fas fa-chevron-right"></i>
                                    </a>
                                </li>
                            </ul>
                        </nav>
                    }
                </div>

            </div>
        </div>
    </div>

    <div class="modal fade" id="orderDetailModal" tabindex="-1" aria-labelledby="orderDetailModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content" id="modal-content-placeholder">
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script>
        $(document).ready(function() {
            var modalElement = document.getElementById('orderDetailModal');
            var myModal = new bootstrap.Modal(modalElement);
            var modalPlaceholder = $('#modal-content-placeholder');

            $('#order-list').on('click', '.btn-view-detail', function() {

                var orderId = $(this).data('id');
                var url = '@Url.Action("ChiTietDonHang", "KhachHang")';

                modalPlaceholder.html(
                    '<div class="modal-body text-center p-5">' +
                    '  <div class="spinner-border text-primary" role="status">' +
                    '    <span class="visually-hidden">Loading...</span>' +
                    '  </div>' +
                    '</div>'
                );
                myModal.show();

                $.get(url, { id: orderId })
                    .done(function(data) {
                        modalPlaceholder.html(data);
                    })
                    .fail(function() {
                        modalPlaceholder.html(
                            '<div class="modal-header">' +
                            '  <h5 class="modal-title">Lỗi</h5>' +
                            '  <button type="button" class="btn-close" data-bs-dismiss="modal"></button>' +
                            '</div>' +
                            '<div class="modal-body"><p>Không thể tải chi tiết đơn hàng. Vui lòng thử lại.</p></div>' +
                            '<div class="modal-footer">' +
                            '  <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Đóng</button>' +
                            '</div>'
                        );
                    });
            });
        });
    </script>
}