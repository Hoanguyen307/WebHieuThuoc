@{
    ViewBag.Title = "Tích điểm";
    Layout = "~/Views/Shared/_AccountLayout.cshtml";
}

<div class="points-container">
    <div class="points-card">
        <div class="d-flex align-items-center justify-content-center">
            <i class="fas fa-coins fa-2x text-warning me-2"></i>
            <h5 class="mb-0 fw-bold">
                Điểm khả dụng: <span class="text-primary">@ViewBag.TongDiem</span>
            </h5>
        </div>
    </div>
</div>

<h4 class="mb-3">Lịch sử điểm thưởng</h4>

<div class="table-responsive">
    <table class="table table-bordered table-striped">
        <thead class="table-light">
            <tr>
                <th>Ngày</th>
                <th>Mô tả</th>
                <th>Điểm</th>
                <th>Trạng thái</th>
            </tr>
        </thead>
        <tbody>
            @* Dữ liệu được lấy từ ViewBag.LichSuDiem *@
            @if (ViewBag.LichSuDiem != null && ((IEnumerable<Models.PointsModel.PointsHistory>)ViewBag.LichSuDiem).Any())
            {
                foreach (var item in (IEnumerable<Models.PointsModel.PointsHistory>)ViewBag.LichSuDiem)
                {
                    <tr>
                        <td>@item..ToString("dd/MM/yyyy")</td>
                        <td>@item.Description</td>
                        <td class="@(item.Points > 0 ? "text-success" : "text-danger")">
                            @(item.Points > 0 ? "+" : "")@item.Points
                        </td>
                        <td>@item.Type</td>
                        <td>
                            @if (item.Type == "Added")
                            {
                                <span class="badge bg-success">Đã cộng</span>
                            }
                            else if (item.Type == "Used")
                            {
                                <span class="badge bg-primary">Đã dùng</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">@item.Type</span>
                            }
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="4" class="text-center text-muted">Chưa có dữ liệu</td>
                </tr>
            }
        </tbody>
    </table>
</div>