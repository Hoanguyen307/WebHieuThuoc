@model IEnumerable<Models.DiaChiGiaoHang>
@{
    ViewBag.Title = "Quản lý địa chỉ giao hàng";
    Layout = "~/Views/Shared/_AccountLayout.cshtml";
}

<h2 class="mb-3">Địa chỉ giao hàng của tôi</h2>

<button type="button" onclick="OpenDiaChiModal(0)" class="btn btn-primary mb-3">
    <i class="fa fa-plus"></i> Thêm địa chỉ mới
</button>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Người nhận</th>
            <th>Số điện thoại</th>
            <th>Địa chỉ</th>
            <th>Mặc định</th>
            <th>Thao tác</th>
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.Any())
        {
            foreach (var item in Model)
            {
                <tr>
                    <td>@item.TenNguoiNhan</td>
                    <td>@item.SoDienThoai</td>
                    <td>@item.DiaChiChiTiet</td>
                    <td>
                        @if (item.MacDinh)
                        {
                            <span class="badge bg-success">Mặc định</span>
                        }
                        else
                        {
                            <button type="button"
                                    class="btn btn-sm btn-outline-primary"
                                    onclick="SetDefault(@item.DiaChiId)">
                                Đặt mặc định
                            </button>
                        }
                    </td>
                    <td class="text-center">
                        <button class="btn btn-sm btn-warning" onclick="OpenDiaChiModal(@item.DiaChiId)">Sửa</button>
                        <button class="btn btn-sm btn-danger" onclick="DeleteDiaChi(@item.DiaChiId)">Xóa</button>
                    </td>
                </tr>
            }
        }
        else
        {
            <tr><td colspan="5" class="text-center">Chưa có địa chỉ nào</td></tr>
        }
    </tbody>
</table>
<div class="modal fade" id="modalDiaChi" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalTitle">Địa chỉ giao hàng</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="modalBody">
            </div>
        </div>
    </div>
</div>
@section scripts {
    <script>
        // 1. Hàm mở Modal (Thêm mới/Sửa)
        function OpenDiaChiModal(id) {
        let url = id > 0 ? "/DiaChiGiaoHang/Edit" : "/DiaChiGiaoHang/Create";

        $.ajax({
            url: url,
            type: "GET",
            data: { DiaChiId: id },
            success: function (res) {
                $("#modalTitle").text(id > 0 ? "Chỉnh sửa địa chỉ" : "Thêm địa chỉ mới");
                $("#modalBody").html(res);

                var myModalEl = document.getElementById('modalDiaChi');
                var modal = bootstrap.Modal.getOrCreateInstance(myModalEl);
                modal.show();
            },
            error: function (xhr) {
                console.error(xhr.responseText);
                Swal.fire('Lỗi!', 'Không thể tải dữ liệu: ' + xhr.status, 'error');
            }
        });
        }

        // 2. Hàm Lưu địa chỉ (Gọi từ nút Lưu trong form)
        function SaveDiaChi() {
            let form = $("#form-addDiaChi");
            let data = form.serialize();
            let id = $("input[name='DiaChiId']").val();
            let url = id > 0 ? "@Url.Action("Edit", "DiaChiGiaoHang")" : "@Url.Action("Create", "DiaChiGiaoHang")";

            $.post(url, data, function (res) {
                if (res.code === 200) {
                    $("#modalDiaChi").modal("hide");
                    Swal.fire('Thành công!', res.msg, 'success').then(() => {
                        location.reload();
                    });
                } else {
                    Swal.fire('Lỗi!', res.msg, 'error');
                }
            });
        }

        // 3. Hàm Xóa (Thay thế confirm bằng SweetAlert2)
        function DeleteDiaChi(id) {
            Swal.fire({
                title: 'Bạn có chắc chắn?',
                text: "Địa chỉ này sẽ bị xóa vĩnh viễn!",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                cancelButtonColor: '#3085d6',
                confirmButtonText: 'Đồng ý xóa',
                cancelButtonText: 'Hủy'
            }).then((result) => {
                if (result.isConfirmed) {
                    $.post("@Url.Action("Delete", "DiaChiGiaoHang")", { DiaChiId: id }, function (res) {
                        if (res.code === 200) {
                            Swal.fire('Đã xóa!', res.msg, 'success').then(() => location.reload());
                        } else {
                            Swal.fire('Thất bại!', res.msg, 'error');
                        }
                    });
                }
            });
        }

        // 4. Hàm đặt mặc định
        function SetDefault(id) {
            $.post("@Url.Action("SetDefault", "DiaChiGiaoHang")", { DiaChiId: id }, function (res) {
                if (res.code === 200) {
                    Swal.fire('Thành công!', res.msg, 'success').then(() => {
                        location.reload();
                    });
                } else {
                    Swal.fire('Lỗi!', res.msg, 'error');
                }
            });
        }
    </script>
}
