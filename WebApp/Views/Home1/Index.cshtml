@model Models.HomeViewModel
@{
    ViewBag.Title = "Trang chủ";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link href="~/Content/assets/css/TrangChu.css" rel="stylesheet" />

<style>

    .flashsale-products {
        overflow-x: auto;
    }

        .flashsale-products .product-card {
            min-width: 180px;
            background: #fff;
            border: 1px solid #eee;
            border-radius: 6px;
            padding: 10px;
            text-align: center;
            position: relative;
        }

    .discount-badge {
        position: absolute;
        top: 5px;
        left: 5px;
        background: #ff4d4f;
        color: #fff;
        font-size: 12px;
        padding: 2px 5px;
        border-radius: 4px;
    }

    .product-card .product-img {
        width: 100%;
        height: 150px;
        object-fit: contain;
        margin-bottom: 10px;
    }

    .price {
        margin-top: 5px;
    }

    .sale-price {
        color: #ff4d4f;
        font-weight: bold;
    }

    .original-price {
        text-decoration: line-through;
        color: #888;
        font-size: 14px;
        margin-left: 5px;
    }


    #mainCarousel .carousel-item img {
        width: 100%;
        height: 390px;
        object-fit: cover;
    }

    @@media (max-width: 992px) {
        #mainCarousel .carousel-item img {
            height: 350px;
        }
    }

    @@media (max-width: 576px) {
        #mainCarousel .carousel-item img {
            height: 220px;
        }
    }

    .product-card, .product-card-has-image {
        opacity: 0;
        transform: translateY(30px) scale(0.95);
        transition: opacity 0.8s ease, transform 0.8s ease;
    }

        .product-card.visible, .product-card-has-image.visible {
            opacity: 1;
            transform: translateY(0) scale(1);
        }
</style>

<div id="mainCarousel" class="carousel slide" data-bs-ride="carousel" data-bs-interval="3000">
    <div class="carousel-inner rounded">
        <div class="carousel-item active">
            <img src="~/Content/assets/images/Logo/banner1.png" class="d-block w-100" alt="Banner 1">
        </div>
        <div class="carousel-item">
            <img src="~/Content/assets/images/Logo/banner2.png" class="d-block w-100" alt="Banner 2">
        </div>
        @*<div class="carousel-item">
                <img src="~/Content/assets/images/Logo/banner2.png" class="d-block w-100" alt="Banner 3">
            </div>*@
    </div>

    <button class="carousel-control-prev" type="button" data-bs-target="#mainCarousel" data-bs-slide="prev">
        <span class="carousel-control-prev-icon"></span>
    </button>
    <button class="carousel-control-next" type="button" data-bs-target="#mainCarousel" data-bs-slide="next">
        <span class="carousel-control-next-icon"></span>
    </button>

    <div class="carousel-indicators">
        <button type="button" data-bs-target="#mainCarousel" data-bs-slide-to="0" class="active"></button>
        <button type="button" data-bs-target="#mainCarousel" data-bs-slide-to="1"></button>
        @*<button type="button" data-bs-target="#mainCarousel" data-bs-slide-to="2"></button>*@
    </div>
</div>

<!-- Sản phẩm bán chạy -->
<h4 class="mt-5 mb-3 fw-bold">TOP SẢN PHẨM BÁN CHẠY</h4>
<div class="flash-deals-container">
    <div class="products-carousel-wrapper">
        <button class="carousel-nav-btn prev"><i class="fas fa-chevron-left"></i></button>
        <div class="products-grid" id="topSellingProductsCarousel">
            @if (Model.TopSellingProducts != null && Model.TopSellingProducts.Any())
            {
                foreach (var product in Model.TopSellingProducts)
                {
                    <div class="product-card">
                        @{
                            decimal? discount = 0;
                            if (product.GiaGoc > 0 && product.GiaBan < product.GiaGoc)
                            {
                                discount = ((product.GiaGoc - product.GiaBan) / product.GiaGoc) * 100;
                            }
                        }
                        @if (discount > 0)
                        {
                            <div class="discount-badge">@((int)discount)%</div>
                        }

                        <a href="#">
                            <div class="product-image">
                                <a href="@Url.Action("Details", "Products", new { id = product.ThuocId })">
                                    <img src="@product.HinhAnh" alt="@product.TenThuoc" class="product-img" />
                                </a>
                            </div>
                        </a>

                        <a class="product-title" href="@Url.Action("Details", "Products", new { id = product.ThuocId })">
                            @product.TenThuoc
                        </a>
                        <div class="product-price">
                            <span class="flash-price">@product.GiaBan.Value.ToString("N0") đ/@product.DonViTinh</span>
                            @if (discount > 0)
                            {
                                <span class="original-price">@product.GiaGoc.Value.ToString("N0") đ</span>
                            }
                        </div>
                    </div>
                }
            }
            else
            {
                <p>Không có sản phẩm bán chạy nào để hiển thị.</p>
            }
        </div>
        <button class="carousel-nav-btn next"><i class="fas fa-chevron-right"></i></button>
    </div>
</div>

<!-- FLASH SALE -->
<div id="flashsale-container" class="mt-5">
    @if (ViewBag.AllFlashSales != null && ViewBag.AllFlashSales.Count > 0)
    {
        @Html.Action("FlashSalePartial", "Home1")
    }
</div>

<div id="voucher-section" class="mt-5">
    @Html.Action("AvailableVouchersPartial", "Home1")
</div>

<!-- Sản phẩm gợi ý -->
<div class="flash-deals-section mt-5">
    <div class="section-header">
        <h4 class="section-title">Gợi ý cho bạn</h4>
        <a href="@Url.Action("Index", "Products")" class="view-all-link">Xem tất cả</a>
    </div>

    <div class="products-container">
        @if (Model.LatestProducts != null && Model.LatestProducts.Any())
        {
            foreach (var product in Model.LatestProducts)
            {
                <div class="product-card-has-image">
                    @{
                        decimal? discount = 0;
                        if (product.GiaGoc.HasValue && product.GiaBan.HasValue && product.GiaBan < product.GiaGoc)
                        {
                            discount = ((product.GiaGoc - product.GiaBan) / product.GiaGoc) * 100;
                        }
                    }

                    <div class="product-image-box">
                        <a href="@Url.Action("Details", "Products", new { id = product.ThuocId })">
                            <img src="@product.HinhAnh" alt="@product.TenThuoc" class="product-img" />
                        </a>
                        @if (discount > 0)
                        {
                            <div class="product-discount-label">@Math.Round(discount.Value, 0)%</div>
                        }
                    </div>

                    <div class="product-info">
                        <div class="product-brand">@product.TenNhaCungCap</div>
                        <a class="product-title" href="@Url.Action("Details", "Products", new { id = product.ThuocId })">
                            @product.TenThuoc
                        </a>
                        <div class="product-prices">
                            @if (product.GiaBan.HasValue && product.GiaBan > product.GiaGoc)
                            {
                                <span class="product-price-sale">@((product.GiaBan ?? 0).ToString("N0")) đ/@product.DonViTinh</span>

                            }
                            else if (product.GiaBan.HasValue && product.GiaBan < product.GiaGoc)
                            {
                                <span class="product-price-sale">@((product.GiaBan ?? 0).ToString("N0")) đ/@product.DonViTinh</span>
                                <span class="product-price-original">@((product.GiaGoc ?? 0).ToString("N0")) đ</span>
                            }
                            else
                            {
                                <span class="product-price-sale">@((product.GiaGoc ?? 0).ToString("N0")) đ/@product.DonViTinh</span>
                            }
                        </div>


                        <div class="product-rating">
                            <span class="stars">★★★★★</span>
                            <span class="review-count">(10)</span>
                            <span class="sold-count">| 54</span>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <p>Không có sản phẩm nào để gợi ý.</p>
        }
    </div>
</div>

<section id="beautybox-magazine">
    @Html.Action("LatestBlogPartial", "BaiViet")
</section>
<script src="https://cdn.jsdelivr.net/npm/dayjs@1/dayjs.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/dayjs@1/plugin/duration.js"></script>
@section Scripts {
    <script>
        function observeProducts() {
            const observer = new IntersectionObserver((entries) => {
                entries.forEach(entry => {
                    if (entry.isIntersecting) {
                        entry.target.classList.add('visible');
                    } else {
                        entry.target.classList.remove('visible');
                    }
                });
            }, { threshold: 0.2 });

            document.querySelectorAll('.product-card, .product-card-has-image').forEach(el => {
                observer.observe(el);
            });
        }

        document.addEventListener('DOMContentLoaded', function () {
            observeProducts();
            const carousel = document.getElementById('topSellingProductsCarousel');
            const prevButton = document.querySelector('.carousel-nav-btn.prev');
            const nextButton = document.querySelector('.carousel-nav-btn.next');
            const scrollDistance = 240;

            prevButton.addEventListener('click', function () {
                carousel.scrollBy({
                    left: -scrollDistance,
                    behavior: 'smooth'
                });
            });

            nextButton.addEventListener('click', function () {
                carousel.scrollBy({
                    left: scrollDistance,
                    behavior: 'smooth'
                });
            });
        });

        dayjs.extend(dayjs_plugin_duration);

        let activeTab = null;
        const countdownEl = {
            dArea: document.getElementById("days-area"),
            d: document.getElementById("days"),
            h: document.getElementById("hours"),
            m: document.getElementById("minutes"),
            s: document.getElementById("seconds"),
            label: document.querySelector(".countdown-label")
        };

        function updateCountdown() {
            if (!activeTab) return;

            const start = dayjs(activeTab.dataset.start);
            const end = dayjs(activeTab.dataset.end);
            const now = dayjs();

            let diff;
            if (now.isBefore(start)) {
                diff = start.diff(now);
                countdownEl.label.innerText = "Bắt đầu sau";
            } else if (now.isAfter(end)) {
                diff = 0;
                countdownEl.label.innerText = "Đã kết thúc";
            } else {
                diff = end.diff(now);
                countdownEl.label.innerText = "Kết thúc sau";
            }

            const duration = dayjs.duration(diff);
            const days = Math.floor(duration.asDays());
            const hours = duration.hours();

            if (days > 0) {
                countdownEl.dArea.style.display = "inline";
                countdownEl.d.innerText = String(days).padStart(2, "0");
            } else {
                countdownEl.dArea.style.display = "none";
            }
            countdownEl.h.innerText = String(duration.hours()).padStart(2, "0");
            countdownEl.m.innerText = String(duration.minutes()).padStart(2, "0");
            countdownEl.s.innerText = String(duration.seconds()).padStart(2, "0");
        }

        function loadProducts(flashSaleId) {
            $.get("/Home1/FlashSaleProducts", { flashSaleId }, function (html) {
                $("#flashsale-products").html(html);

                observeProducts();
            });
        }

        $(document).on("click", ".flashsale-tabs .tab", function () {
            $(".flashsale-tabs .tab").removeClass("active");
            $(this).addClass("active");

            activeTab = this;
            loadProducts($(this).data("id"));
            updateCountdown();
        });

        const firstTab = document.querySelector(".flashsale-tabs .tab");
        if (firstTab) {
            activeTab = firstTab;
            loadProducts(firstTab.dataset.id);
            updateCountdown();
        }

        setInterval(updateCountdown, 1000);
    </script>
}
