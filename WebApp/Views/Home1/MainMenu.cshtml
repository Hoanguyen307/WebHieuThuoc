
@{
    ViewBag.Title = "MainMenu";
    Layout = "~/Views/Shared/Layout.cshtml";
}

@* Đây là một Partial View, không cần HTML, head hay body tags *@
<div class="main-menu-container">
    <div class="container">
        <ul class="main-menu d-flex justify-content-center">
            <li class="menu-item">
                <a href="#"><i class="fas fa-boxes"></i> DANH MỤC</a>
                <div class="mega-dropdown-menu">
                    <div class="row g-0">
                        <div class="col-4 dropdown-col left-col">
                            <ul class="list-unstyled">
                                @if (ViewBag.Categories != null)
                                {
                                    foreach (var parentCategory in ViewBag.Categories)
                                    {
                                        <li class="main-category" data-target="category-@parentCategory.ID">
                                            <a href="#"><i class="@parentCategory.IconClass me-2"></i> @parentCategory.Name</a>
                                        </li>
                                    }
                                }
                            </ul>
                        </div>
                        <div class="col-8 dropdown-col right-col">
                            @if (ViewBag.Categories != null && ViewBag.ProductCategory != null)
                            {
                                foreach (var parentCategory in ViewBag.Categories)
                                {
                                    <div id="category-@parentCategory.ID" class="sub-category-content">
                                        <div class="row">
                                            @foreach (var productCategory in ((List<Models.ProductCategory>)ViewBag.ProductCategory).Where(pc => pc.CategoryId == parentCategory.ID))
                                            {
                                                <div class="col-4">
                                                    <h6>
                                                        <a href="@Url.Action("Index", "Products", new { ProductCategoryId = productCategory.Id })">@productCategory.Name</a>
                                                    </h6>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                }
                            }
                        </div>
                    </div>
                </div>
            </li>
            <li class="menu-item"><a href="#">HOT DEALS</a></li>
            <li class="menu-item"><a href="#">THƯƠNG HIỆU</a></li>
            <li class="menu-item"><a href="#">HÀNG MỚI VỀ</a></li>
            <li class="menu-item"><a href="#">BÁN CHẠY</a></li>
            <li class="menu-item"><a href="#">CLINIC & SPA</a></li>
            <li class="menu-item"><a href="#">DERMAHAIR</a></li>
            <li class="menu-item">
                <a href="#">
                    <span>Tải ứng dụng</span>
                    <i class="fas fa-mobile-alt"></i>
                </a>
            </li>
            <li class="menu-item">
                <a href="#">
                    <span>Chọn khu vực của bạn</span>
                    <i class="fas fa-map-marker-alt"></i>
                </a>
            </li>
        </ul>
    </div>
</div>

