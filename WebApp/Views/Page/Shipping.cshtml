@{
    ViewBag.Title = "Phương thức vận chuyển";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container my-5">
    <h2 class="text-center mb-4">Phương thức vận chuyển</h2>
    <div class="row text-center">
        <div class="col-md-4">
            <i class="bi bi-truck fs-1 text-primary"></i>
            <h5 class="mt-3">Giao hàng tiêu chuẩn</h5>
            <p>Thời gian: 3-5 ngày làm việc. Phí: 25.000đ.</p>
        </div>
        <div class="col-md-4">
            <i class="bi bi-lightning-charge fs-1 text-warning"></i>
            <h5 class="mt-3">Giao hàng nhanh</h5>
            <p>Thời gian: 1-2 ngày. Phí: 40.000đ.</p>
        </div>
        <div class="col-md-4">
            <i class="bi bi-bag-check fs-1 text-success"></i>
            <h5 class="mt-3">Nhận tại cửa hàng</h5>
            <p>Miễn phí, có thể lấy ngay trong ngày.</p>
        </div>
    </div>
</div>
