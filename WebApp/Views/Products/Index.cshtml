@model IEnumerable<Models.Product>

@{
    ViewBag.Title = "Tất cả sản phẩm";
    Layout = "~/Views/Shared/_Layout.cshtml";
    string currentSortOrder = ViewBag.SortOrder ?? "newest";

}
<link href="~/Content/assets/css/Products.css" rel="stylesheet" />

<div class="container product-list-page">
    <div class="row">
        <div class="col-md-3 sidebar-filters">
            <h3 class="filter-title">Danh mục</h3>
            <div class="filter-section">
                <ul class="list-unstyled">
                    @foreach (var category in ViewBag.Categories as List<Models.Category>)
                    {
                        var collapseId = "cat-" + category.ID;
                        <li class="category-item mb-2">
                            <!-- Danh mục cha -->
                            <a class="d-block fw-bold text-dark"
                               data-bs-toggle="collapse"
                               href="#@collapseId"
                               role="button"
                               aria-expanded="false"
                               aria-controls="@collapseId">
                                @category.Name
                            </a>

                            <!-- Danh mục con -->
                            <ul class="collapse ps-3 mt-1 @(ViewBag.SelectedCategoryId != null && (ViewBag.ProductCategory as List<Models.ProductCategory>).Any(p => p.DanhMucId == ViewBag.SelectedCategoryId && p.Category_ID == category.ID) ? "show" : "")"
                                id="@collapseId">
                                @foreach (var sub in ViewBag.ProductCategory as List<Models.ProductCategory>)
                                {
                                    if (sub.Category_ID == category.ID)
                                    {
                                        <li>
                                            <a href="@Url.Action("Index", "Products", new { ProductCategoryId = sub.DanhMucId, sortOrder = ViewBag.SortOrder })"
                                               class="@(ViewBag.SelectedCategoryId == sub.DanhMucId ? "active text-primary fw-bold" : "")">
                                                @sub.TenDanhMuc
                                            </a>
                                        </li>
                                    }
                                }
                            </ul>
                        </li>
                    }
                </ul>
            </div>


            <h3 class="filter-title mt-4">Nhà cung cấp</h3>
            <div class="filter-section">
                <ul>
                    @foreach (var ncc in ViewBag.NhaCungCaps as List<Models.NhaCungCap>)
                    {
                        <li>
                            <a href="@Url.Action("Index", "Products", new { NhaCungCapId = ncc.NhaCungCapId, sortOrder = ViewBag.SortOrder })"
                               class="@(ViewBag.SelectedBrandId == ncc.NhaCungCapId ? "active" : "")">
                                @ncc.TenNhaCungCap
                            </a>
                        </li>
                    }
                </ul>
            </div>

            <h3 class="filter-title mt-4">Khoảng giá</h3>
            <div class="filter-section">
                <div class="price-range">
                    <input type="text" placeholder="Từ">
                    <span>-</span>
                    <input type="text" placeholder="Đến">
                    <button class="btn btn-sm btn-outline-secondary" style="height: 35px;">Áp dụng</button>
                </div>
            </div>
        </div>

        <div class="col-md-9">
            <div class="filter-sort-section">
                <h2 class="product-page-title mb-0">Tất cả sản phẩm</h2>
                <div class="sort-options">
                    <span class="me-2">Sắp xếp theo:</span>
                    <div class="dropdown d-inline-block">
                        <button class="btn btn-outline-secondary dropdown-toggle" type="button" id="sortDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                            @if (currentSortOrder == "newest")
                            {
                                <span>Mới nhất</span>
                            }
                            else if (currentSortOrder == "price_asc")
                            {
                                <span>Giá tăng dần</span>
                            }
                            else if (currentSortOrder == "price_desc")
                            {
                                <span>Giá giảm dần</span>
                            }
                            else
                            {
                                <span>Mới nhất</span>
                            }
                        </button>
                        <ul class="dropdown-menu" aria-labelledby="sortDropdown">
                            <li>
                                <a class="dropdown-item @(currentSortOrder == "newest" ? "active" : "")"
                                   href="@Url.Action("Index", "Products", new { sortOrder = "newest", BrandId = ViewBag.SelectedBrandId, CategoryId = ViewBag.SelectedCategoryId })">
                                    Mới nhất
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item @(currentSortOrder == "price_asc" ? "active" : "")"
                                   href="@Url.Action("Index", "Products", new { sortOrder = "price_asc", BrandId = ViewBag.SelectedBrandId, CategoryId = ViewBag.SelectedCategoryId })">
                                    Giá tăng dần
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item @(currentSortOrder == "price_desc" ? "active" : "")"
                                   href="@Url.Action("Index", "Products", new { sortOrder = "price_desc", BrandId = ViewBag.SelectedBrandId, CategoryId = ViewBag.SelectedCategoryId })">
                                    Giá giảm dần
                                </a>
                            </li>
                        </ul>
                    </div>
                    <form method="get" id="pageSizeForm" class="d-inline-block ms-3">
                        <select id="pageSize" name="pageSize" class="form-select form-select-sm" onchange="document.getElementById('pageSizeForm').submit();">
                            <option value="40" @(Request.QueryString["pageSize"] == "40" ? "selected" : "")>Hiển thị 40</option>
                            <option value="60" @(Request.QueryString["pageSize"] == "60" ? "selected" : "")>Hiển thị 60</option>
                        </select>

                        <!-- Giữ lại các tham số filter khi gửi form -->
                        <input type="hidden" name="ProductCategoryId" value="@ViewBag.SelectedCategoryId" />
                        <input type="hidden" name="BrandId" value="@ViewBag.SelectedBrandId" />
                        <input type="hidden" name="sortOrder" value="@ViewBag.SortOrder" />
                    </form>
                </div>
                

            </div>

            <div class="products-grid-list">
                @if (Model != null && Model.Any())
                {
                    foreach (var product in Model)
                    {
                        <div class="product-card-has-image">
                            @{
                                decimal? discount = 0;
                                if (product.GiaGoc.HasValue && product.GiaGoc > 0 && product.GiaBan.HasValue)
                                {
                                    discount = ((product.GiaGoc - product.GiaBan) / product.GiaGoc) * 100;
                                }
                            }

                            <div class="product-image-box">
                                <a href="@Url.Action("Details", "Products", new { id = product.ThuocId })">
                                    <img src="https://localhost:44310/@product.HinhAnh" alt="@product.TenThuoc" class="product-img" />
                                </a>
                                @if (discount > 0)
                                {
                                    <div class="product-discount-label">@Math.Round(discount.Value, 0)%</div>
                                }
                            </div>

                            <div class="product-info">
                                <div class="product-brand">@product.TenNhaCungCap</div>
                                <a class="product-title" href="@Url.Action("Details", "Products", new { id = product.ThuocId })">
                                    @product.TenThuoc
                                </a>
                                <div class="product-prices">
                                    @if (product.GiaBan.HasValue && product.GiaBan < product.GiaGoc)
                                    {
                                        <span class="product-price-sale">@((product.GiaBan ?? 0).ToString("N0")) đ/@product.DonViTinh</span>
                                        <span class="product-price-original">@((product.GiaGoc ?? 0).ToString("N0")) đ</span>
                                    }
                                    else
                                    {
                                <span class="product-price-sale">@((product.GiaGoc ?? 0).ToString("N0")) đ/@product.DonViTinh</span>
                                    }
                                </div>


                                <div class="product-rating">
                                    <span class="stars">★★★★★</span>
                                    <span class="review-count">(10)</span>
                                    <span class="sold-count">| 54</span>
                                </div>
                            </div>
                        </div>

                    }
                }
                else
                {
                    <p>Không có sản phẩm nào để hiển thị.</p>
                }
            </div>
        </div>
    </div>
</div>