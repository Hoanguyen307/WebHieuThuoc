            <div class="product-description-section mt-5 p-4 rounded bg-white shadow-sm" style="margin:0 -12px;">
                <h4 class="section-title">Mô tả sản phẩm</h4>
                <p>
                    @Html.Raw(Model.Product.QuyCach)
                </p>

                <ul class="nav nav-tabs mt-4" id="productTabs" role="tablist">
                    <li class="nav-item" role="presentation">
                        <button class="nav-link active" id="details-tab" data-bs-toggle="tab" data-bs-target="#details" type="button" role="tab" aria-controls="details" aria-selected="true">Thông số</button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" id="usage-tab" data-bs-toggle="tab" data-bs-target="#usage" type="button" role="tab" aria-controls="usage" aria-selected="false">Cách dùng</button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" id="reviews-tab" data-bs-toggle="tab" data-bs-target="#reviews" type="button" role="tab" aria-controls="reviews" aria-selected="false">Đánh giá</button>
                    </li>
                </ul>
                <div class="tab-content pt-3" id="productTabsContent">
                    <div class="tab-pane fade show active" id="details" role="tabpanel" aria-labelledby="details-tab">
                        <div class="product-specs-table">
                            <table class="table table-bordered">
                                <tbody>
                                    <tr>
                                        <p>Test Công dụng: @Model.Product.CongDung</p>
                                        <td style="width: 25%; font-weight: bold; background-color: #f9f9f9;">Công dụng</td>
                                        <td>
                                            @if (Model.Product.CongDung != null)
                                            {
                                                @Html.Raw(Model.Product.CongDung)
                                            }
                                            else
                                            {
                                                <span>Đang cập nhật...</span>
                                            }
                                        </td>
                                    </tr>
                                    <tr>
                                        <td style="width: 25%; font-weight: bold; background-color: #f9f9f9;">Thành phần</td>
                                        <td>
                                            @if (Model.Product.ThanhPhan != null)
                                            {
                                                @Html.Raw(Model.Product.ThanhPhan)
                                            }
                                            else
                                            {
                                                <span>Đang cập nhật...</span>
                                            }
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                    <div class="tab-pane fade" id="usage" role="tabpanel" aria-labelledby="usage-tab">
                        <div class="product-usage-detail" style="padding: 20px;">
                            @Html.Raw(Model.Product.CachSuDung)
                        </div>
                    </div>
                    <div class="tab-pane fade" id="reviews" role="tabpanel" aria-labelledby="reviews-tab">
                        <h4 class="mt-3">Đánh giá sản phẩm</h4>
                        @{
                            int? currentRating = ViewBag.SelectedRating;
                        }
                        <div class="review-filter-buttons mb-3 p-3 bg-light rounded">
                            <button class="btn btn-outline-secondary btn-sm filter-btn @(currentRating == null ? "active" : "")" data-filter="all">Tất cả</button>
                            <button class="btn btn-outline-secondary btn-sm filter-btn @(currentRating == 5 ? "active" : "")" data-filter="5">5 sao</button>
                            <button class="btn btn-outline-secondary btn-sm filter-btn @(currentRating == 4 ? "active" : "")" data-filter="4">4 sao</button>
                            <button class="btn btn-outline-secondary btn-sm filter-btn @(currentRating == 3 ? "active" : "")" data-filter="3">3 sao</button>
                            <button class="btn btn-outline-secondary btn-sm filter-btn @(currentRating == 2 ? "active" : "")" data-filter="2">2 sao</button>
                            <button class="btn btn-outline-secondary btn-sm filter-btn @(currentRating == 1 ? "active" : "")" data-filter="1">1 sao</button>
                        </div>
                        @if (Session["Login"] != null)
                        {
                            <div class="review-form-container">
                                <h5>Viết đánh giá của bạn</h5>
                                @using (Html.BeginForm("AddReview", "Products", FormMethod.Post))
                                {
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="ProductId" value="@Model.Product.ThuocId" />

                                    <div class="mb-3">
                                        <label class="form-label d-block">Đánh giá của bạn:</label>
                                        <div class="star-rating">
                                            <input type="radio" id="star5" name="Rating" value="5" required /><label for="star5" title="5 sao">★</label>
                                            <input type="radio" id="star4" name="Rating" value="4" /><label for="star4" title="4 sao">★</label>
                                            <input type="radio" id="star3" name="Rating" value="3" /><label for="star3" title="3 sao">★</label>
                                            <input type="radio" id="star2" name="Rating" value="2" /><label for="star2" title="2 sao">★</label>
                                            <input type="radio" id="star1" name="Rating" value="1" /><label for="star1" title="1 sao">★</label>
                                        </div>
                                    </div>

                                    <div class="mb-3">
                                        <label for="Comment" class="form-label">Nhận xét của bạn:</label>
                                        <textarea id="Comment" name="Comment" class="form-control" rows="4" placeholder="Sản phẩm này rất tốt..." required></textarea>
                                    </div>

                                    <button type="submit" class="btn btn-primary">Gửi đánh giá</button>}
                            </div> }
                        else
                        {
                            <div class="alert alert-info">
                                Vui lòng <a href="@Url.Action("Login", "Account")">đăng nhập</a> để gửi đánh giá.
                            </div>}

                        @if (Model.productReviews != null && Model.productReviews.Any())
                        {
                            <div id="review-list-container">
                                @foreach (var review in Model.productReviews)
                                {
                                    <div class="review-item mb-4 p-3 border rounded d-flex" data-rating="@review.Rating">
                                        <div class="flex-shrink-0 me-3">
                                            <img src="~/Content/assets/images/Logo/default-avatar.png" alt="Avatar" class="review-avatar">
                                        </div>

                                        <div class="flex-grow-1">
                                            <div class="d-flex justify-content-between align-items-center mb-2">
                                                <h6 class="mb-0">@review.FullName</h6>
                                                <small class="text-muted">@review.CreatedDate.ToShortDateString()</small>
                                            </div>
                                            <div class="stars mb-2">
                                                @for (int i = 1; i <= 5; i++)
                                                {
                                                    if (i <= review.Rating)
                                                    {<i class="fas fa-star text-warning"></i> }
                                                    else
                                                    { <i class="far fa-star text-warning"></i>}
                                                }
                                            </div>
                                            <p class="review-comment mb-0">@review.Comment</p>
                                        </div>
                                    </div>
                                }
                            </div>
                            <p class="text-muted text-center mt-3 d-none" id="reviews-not-found">
                                Không tìm thấy đánh giá nào phù hợp.
                            </p>
                        }
                        else
                        {
                            <p class="text-muted text-center mt-3">Chưa có đánh giá nào cho sản phẩm này.</p>
                        }
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <h4 class="sidebar-title">Sản phẩm tương tự</h4>
            <div class="related-products-list">
                @if (Model.RelatedProducts != null && Model.RelatedProducts.Any())
                {
                    foreach (var relatedProduct in Model.RelatedProducts)
                    {
                        <a href="@Url.Action("Details", new { id = relatedProduct.ThuocId })" class="related-product-card d-block mb-3">
                            <div class="row g-0">
                                <div class="col-4">
                                    <img src="@relatedProduct.HinhAnh" class="img-fluid rounded-start" alt="@relatedProduct.TenThuoc">
                                </div>
                                <div class="col-8">
                                    <div class="card-body">
                                        <h6 class="card-title">@relatedProduct.TenThuoc</h6>
                                        <div class="stars me-2">
                                            @for (int i = 1; i <= 5; i++)
                                            {
                                                if (i <= Math.Round(Model.AverageRating))
                                                {
                                                    <i class="fas fa-star text-warning"></i>
                                                }
                                                else
                                                {
                                                    <i class="far fa-star text-warning"></i>
                                                }
                                            }
                                            <span class="ms-2">(@Model.TotalReviews đánh giá)</span>
                                        </div>
                                        @if (relatedProduct.GiaBan.HasValue)
                                        {
                                            <p class="card-price mb-0">@relatedProduct.GiaBan.Value.ToString("N0") đ</p>
                                        }
                                        else
                                        {
                                            <p class="card-price mb-0">@relatedProduct.GiaGoc.Value.ToString("N0") đ</p>
                                        }
                                    </div>
                                </div>
                            </div>
                        </a>
                    }
                }
                else
                {
                    <p class="text-muted text-center mt-3">Không có sản phẩm tương tự.</p>
                }
            </div>
        </div>
    </div>
</div>
<script>
    $(document).ready(function () {
        function selectAddressCard(element, id) {
            $('.address-item-card').removeClass('active');
            $(element).addClass('active');
            $(element).find('input[type="radio"]').prop('checked', true);
        }
        $('#prescriptionInput').on('change', function () {
            var file = this.files[0];
            var $display = $('#fileNameDisplay');
            var $btnSubmit = $('#btnSubmitPrescription');

            if (file) {
                $display.html('<i class="fas fa-check me-1"></i>' + file.name).addClass('show');
                $btnSubmit.prop('disabled', false).attr('title', 'Nhấn để gửi đơn hàng');
            } else {
                $display.text("Chưa chọn ảnh").removeClass('show');
                $btnSubmit.prop('disabled', true);
            }
        });
        $('#btnSubmitPrescription').on('click', function () {
            //var diaChiId = $('#prescriptionAddressId').val();
            var diaChiId = $('input[name="diaChiId"]:checked').val();
            if (!diaChiId) {
                Swal.fire('Thông báo', 'Vui lòng chọn hoặc thêm địa chỉ nhận hàng.', 'warning');
                return;
            }
            var formData = new FormData();
            var file = $('#prescriptionInput')[0].files[0];
            var productId = '@Model.Product.ThuocId';
            var quantity = $('.quantity-selector input').val() || 1;

            formData.append('productId', productId);
            formData.append('quantity', quantity);
            formData.append('prescriptionFile', file);
            formData.append('diaChiId', diaChiId);

        Swal.fire({
            title: 'Đang gửi đơn hàng...',
            didOpen: () => { Swal.showLoading(); }
        });

        $.ajax({
            url: '/Cart/OrderWithPrescription',
            type: 'POST',
            data: formData,
            contentType: false,
            processData: false,
            success: function (res) {
                if (res.success) {
                    Swal.fire('Thành công!', res.message, 'success').then(() => {
                        window.location.href = '/KhachHang/DonHang'; 
                    });
                } else {
                    Swal.fire('Lỗi', res.message, 'error');
                }
            },
            error: function () {
                Swal.fire('Lỗi', 'Không thể kết nối đến máy chủ.', 'error');
            }
        });
    });
        $('.btn-add-to-cart').on('click', function () {
        var productId = '@Model.Product.ThuocId';
        var quantity = $('.quantity-selector input').val();

        $.ajax({
            url: '/Cart/AddToCart',
            type: 'POST',
            data: {
                productId: productId,
                quantity: quantity
            },
            success: function (res) {
                if (res.success) {
                    Swal.fire({
                        icon: 'success',
                        title: 'Thành công!',
                        text: 'Sản phẩm đã được thêm vào giỏ hàng.',
                        timer: 1500,
                        showConfirmButton: false
                    });
                    updateCartCount();
                } else {
                    Swal.fire({
                        icon: 'error',
                        title: 'Thất bại!',
                        text: res?.message || 'Thêm sản phẩm thất bại.'
                    });
                }
            },
            error: function () {
                Swal.fire({
                    icon: 'error',
                    title: 'Lỗi',
                    text: 'Không kết nối được server.'
                });
            }
        });
    });
        $(".variant-btn").on("click", function () {
            $(".variant-btn").removeClass("active");
            $(this).addClass("active");

            var price = $(this).data("price");
            var sale = $(this).data("sale");

            if (sale && sale < price) {
                $("#productSalePrice").text(sale.toLocaleString() + " đ").show();
                $("#productPrice").text(price.toLocaleString() + " đ").show();
            } else {
                $("#productSalePrice").text(price.toLocaleString() + " đ").show();
                $("#productPrice").hide();
            }
        });
        $('#volumeSelect').on('change', function () {
            var price = $(this).find(':selected').data('price');
            var sale = $(this).find(':selected').data('sale');

            $('#productPrice').text(price + 'đ');
            if (sale > 0 && sale < price) {
                $('#productSalePrice').text(sale + 'đ').show();
            } else {
                $('#productSalePrice').hide();
            }
        });

        $('.btn-buy-now').on('click', function () {
            var productId = '@Model.Product.ThuocId';
            var quantity = $('.quantity-selector input').val() || 1;

            var salePriceText = $('#productSalePrice').text().replace(/\D/g, '');
            var salePrice = parseFloat(salePriceText) || 0;

            window.location.href = '/Cart/BuyNow?productId=' + productId +
                '&quantity=' + quantity +
                '&salePrice=' + salePrice;
        });
        $('form[action="/Products/AddReview"]').on('submit', function (e) {

            e.preventDefault();

            var form = $(this);

            $.ajax({
                url: form.attr('action'),
                type: form.attr('method'),
                data: form.serialize(),

                success: function (res) {
                    if (res.success) {
                        Swal.fire({
                            icon: 'success',
                            title: 'Thành công!',
                            text: res.message,
                            timer: 2000,
                            showConfirmButton: false
                        }).then(function () {
                            location.reload();
                        });
                    } else {
                        Swal.fire({
                            icon: 'error',
                            title: 'Thất bại!',
                            text: res.message
                        }).then(function () {
                            if (res.redirectUrl) {
                                window.location.href = res.redirectUrl;
                            }
                        });
                    }
                },
                error: function () {
                    Swal.fire({
                        icon: 'error',
                        title: 'Lỗi',
                        text: 'Không kết nối được server.'
                    });
                }
            });
        });
});
    $('.filter-btn').on('click', function () {
    var $this = $(this);
    var filter = $this.data('filter');
    var productId = '@Model.Product.ThuocId';

    var ratingValue = (filter === 'all') ? null : filter;

    $('.filter-btn').removeClass('active');
    $this.addClass('active');

    var $container = $('#review-list-container');
    $container.html('<p class="text-center text-muted">Đang tải đánh giá...</p>');

    $.ajax({
        url: '@Url.Action("_GetProductReviews", "Products")',
        type: 'GET',
        data: {
            productId: productId,
            rating: ratingValue
        },
        success: function (data) {
            $container.html(data);
        },
        error: function () {
            $container.html('<p class="text-center text-danger">Đã xảy ra lỗi khi tải đánh giá.</p>');
        }
    });
});
</script>

