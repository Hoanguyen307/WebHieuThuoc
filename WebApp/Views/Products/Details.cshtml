@model Models.ProductViewModel

@{
    ViewBag.Title = Model.Product.TenThuoc;
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<link href="~/Content/assets/css/ProductDetail.css" rel="stylesheet" />
<style>
    .prescription-box {
        width: 100%;
        max-width: none;
        box-sizing: border-box;
    }
    .prescription-actions {
        display: flex;
        gap: 10px; 
        margin-top: 10px;
    }

        .prescription-actions .btn {
            flex: 1; 
            padding: 8px 5px;
            font-size: 13px;
            font-weight: bold;
            white-space: nowrap;
        }
    .btn-upload-small {
        border: 1px solid #0d6efd;
        color: #0d6efd;
        background: #fff;
    }
    .address-scroll-container {
        max-height: 180px; 
        overflow-y: auto;
        border: 1px solid #eee;
        border-radius: 8px;
        padding: 5px;
        background-color: #fcfcfc;
    }

    .address-item-card {
        display: flex;
        align-items: center;
        background: #fff;
        border: 1px solid #ddd;
        border-radius: 8px;
        margin-bottom: 8px;
        padding: 10px;
        cursor: pointer;
        transition: 0.2s;
    }

        .address-item-card.active {
            border-color: #198754;
            background-color: #f0fff4;
        }

        .address-item-card input[type="radio"] {
            width: 18px;
            height: 18px;
            margin-right: 12px;
            flex-shrink: 0;
            accent-color: #198754;
        }

    .address-info-content {
        flex-grow: 1;
        line-height: 1.3;
    }

        .address-info-content .user-name {
            font-weight: bold;
            font-size: 14px;
            color: #333;
        }

        .address-info-content .phone-num {
            font-size: 13px;
            color: #666;
        }

        .address-info-content .detail-addr {
            font-size: 13px;
            color: #777;
            margin-top: 2px;
        }

    #fileNameDisplay {
        min-height: 25px;
        font-size: 12px;
        margin: 5px 0;
        color: #198754;
        display: block;
        overflow: hidden;
        text-overflow: ellipsis;
        visibility: hidden; /* Giữ chỗ khi chưa chọn file */
    }

        #fileNameDisplay.show {
            visibility: visible;
        }

    .badge-default {
        background-color: #198754;
        color: white;
        font-size: 10px;
        padding: 1px 6px;
        border-radius: 3px;
        display: inline-block;
    }
    .review-avatar {
        width: 48px;
        height: 48px;
        border-radius: 50%;
        object-fit: cover;
        border: 1px solid #dee2e6;
    }

    .review-filter-buttons .filter-btn {
        margin-right: 5px;
        margin-bottom: 5px;
    }

        .review-filter-buttons .filter-btn.active {
            background-color: #28a745;
            color: #fff;
            border-color: #28a745;
        }

    .see-more-wrapper {
        text-align: center;
        margin-top: 10px;
    }

    .see-more-link {
        font-size: 14px;
        font-weight: 500;
        color: #007bff;
        text-decoration: none;
        cursor: pointer;
    }

        .see-more-link:hover {
            text-decoration: underline;
            color: #0056b3;
        }

    .review-form-container {
        border: 1px solid #eee;
        padding: 20px;
        border-radius: 8px;
        margin-bottom: 30px;
    }

    /* CSS cho Star Rating Input */
    .star-rating {
        display: flex;
        flex-direction: row-reverse;
        justify-content: flex-end; /* Căn sao về bên phải */
        font-size: 2rem;
        padding: 0;
    }

        .star-rating input {
            display: none;
        }

        .star-rating label {
            color: #ddd;
            cursor: pointer;
            padding: 0 3px;
        }

        /* Khi hover hoặc chọn */
        .star-rating input:checked ~ label,
        .star-rating:not(:checked) > label:hover,
        .star-rating:not(:checked) > label:hover ~ label {
            color: #f7b32b; /* Màu vàng cam */
        }
</style>

<div class="container product-detail-main-wrapper mt-4 mb-5">
    <div class="row">
        <div class="col-md-9">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="@Url.Action("Index", "Home1")">Trang chủ</a></li>
                    <li class="breadcrumb-item"><a href="#">@Model.Product.ProductCategoryName</a></li>
                    <li class="breadcrumb-item active" aria-current="page">@Model.Product.TenThuoc</li>
                </ol>
            </nav>

            <div class="row main-product-section">
                <div class="col-md-5 product-image-wrapper">
                    <img src="@Model.Product.HinhAnh" alt="@Model.Product.TenThuoc" class="img-fluid main-product-image">
                </div>

                <div class="col-md-7 product-info-wrapper">
                    <h1 class="product-name">@Model.Product.TenThuoc</h1>
                    <div class="product-ratings d-flex align-items-center mb-3">
                        <span>23 đánh giá | 60 Hỏi đáp | Mã sản phẩm: 422208871</span>
                    </div>
                    <div class="stars me-2">
                        @for (int i = 1; i <= 5; i++)
                        {
                            if (i <= Math.Round(Model.AverageRating))
                            {
                                <i class="fas fa-star text-warning"></i>
                            }
                            else
                            {
                                <i class="far fa-star text-warning"></i>
                            }
                        }
                        <span class="ms-2">(@Model.TotalReviews đánh giá)</span>
                    </div>


