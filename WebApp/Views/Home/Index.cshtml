@{
    ViewBag.Title = "Yêu cầu";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section Styles {
    <link href="~/Content/assets/css/Case.css" rel="stylesheet" />
}

<div class="container-wrapper" style=" display: flex; flex-direction: column;">
    <input type="hidden" id="Id" name="Id" />

    <div class="d-flex justify-content-between align-items-center mb-3" style="padding: 10px 10px 0 0;">
        <div id="filter-box" style="border: 1px solid #ddd;border-radius: 8px;padding: 10px 15px;background-color: #f9f9f9;box-shadow: 0 0 5px rgba(0,0,0,0.05);display: flex;align-items: center;gap: 10px;min-width: 380px;">
            
                <select id="month" class="form-select form-select-sm">
                </select>

                <select id="year" class="form-select form-select-sm">
                </select>

                <select id="selectToaNha" class="form-control form-control-sm" name="BuildingId" style=" width: 102px;">
                    <option value=""></option>
                </select>
        </div>

        <div class="d-flex align-items-center gap-2">
            <a href="#" onclick="openModal()" class="btn btn-outline-success">+ Thêm mới</a>
            <a class="btn btn-outline-secondary" href="~/Case/Index">Danh sách</a>
        </div>

    </div>

    <div class="main-container">
        <h3 class="text-center">TIẾN TRÌNH</h3>

        <div class="step-container">
            <div id="step1" class="step" data-step-number="1" style="cursor: pointer;">
                <div class="step-item">Bắt đầu</div>
                <div class="step-box">
                    <div class="step-actions">

                    </div>
                    <hr />
                    Tạo tiến trình <br />gửi thông báo phí
                    <hr />
                </div>
            </div>
            <div class="arrow">→</div>

            <div id="step2" class="step" data-step-number="2">
                <div class="circle" id="circle2">Phí Định Kỳ</div>
                <div class="step-box">
                    <div class="step-actions">
                        <a class="btn-back-step" title="Quay lại"><i class="fas fa-arrow-circle-left"></i></a>
                        <strong>BƯỚC 1</strong>
                        <a class="btn-next-step" title="Tiếp tục"><i class="fas fa-arrow-circle-right"></i></a>
                    </div>
                    <hr />
                    Vào chức năng <b>Dịch vụ định kỳ</b>
                    <br />Khai báo các thông tin
                    <hr>
                    <div class="btn-group" role="group" aria-label="step actions">
                        <a class="btn-detail btn btn-sm btn-outline-success" data-target-url="/Home/Index">Chi tiết</a>
                    </div>
                </div>
            </div>
            <div class="arrow">→</div>

            <div id="step3" class="step" data-step-number="3">
                <div class="circle" id="circle3">Chốt chỉ số điện</div>
                <div class="step-box">
                    <div class="step-actions">
                        <a class="btn-back-step" title="Quay lại"><i class="fas fa-arrow-circle-left"></i></a>
                        <strong>BƯỚC 2</strong>
                        <a class="btn-next-step" title="Tiếp tục"><i class="fas fa-arrow-circle-right"></i></a>
                    </div>
                    <hr />
                    Vào chức năng <b>Điện</b>
                    <br />Khai báo các thông tin
                    <hr>
                    <div class="btn-group" role="group" aria-label="step actions">
                        <a class="btn-detail btn btn-sm btn-outline-success" data-target-url="/Test/Index">Chi tiết</a>
                    </div>
                </div>
            </div>
            <div class="arrow">→</div>

            <div id="step4" class="step" data-step-number="4">
                <div class="circle" id="circle4">Chốt chỉ số nước</div>
                <div class="step-box">
                    <div class="step-actions">
                        <a class="btn-back-step" title="Quay lại"><i class="fas fa-arrow-circle-left"></i></a>
                        <strong>BƯỚC 3</strong>
                        <a class="btn-next-step" title="Tiếp tục"><i class="fas fa-arrow-circle-right"></i></a>
                    </div>
                    <hr />
                    Vào chức năng <b>Nước</b>
                    <br />Khai báo các thông tin
                    <hr>
                    <div class="btn-group" role="group" aria-label="step actions">
                        <a class="btn-detail btn btn-sm btn-outline-success" data-target-url="">Chi tiết</a>
                    </div>
                </div>
            </div>
            <div class="arrow">→</div>

            <div id="step5" class="step" data-step-number="5">
                <div class="circle" id="circle5">Chốt xe</div>
                <div class="step-box">
                    <div class="step-actions">
                        <a class="btn-back-step" title="Quay lại"><i class="fas fa-arrow-circle-left"></i></a>
                        <strong>BƯỚC 4</strong>
                        <a class="btn-next-step" title="Tiếp tục"><i class="fas fa-arrow-circle-right"></i></a>
                    </div>
                    <hr />
                    Vào chức năng <b>Thẻ Xe</b>
                    <br />Khai báo các thông tin
                    <hr>
                    <div class="btn-group" role="group" aria-label="step actions">
                        <a class="btn-detail btn btn-sm btn-outline-success" data-target-url="">Chi tiết</a>
                    </div>
                </div>
            </div>
            <div class="arrow">→</div>

            <div id="step6" class="step" data-step-number="6">
                <div class="circle" id="circle6">Tổng hợp<br /> khoản phải thu</div>
                <div class="step-box">
                    <div class="step-actions">
                        <a class="btn-back-step" title="Quay lại"><i class="fas fa-arrow-circle-left"></i></a>
                        <strong>BƯỚC 5</strong>
                        <a class="btn-next-step" title="Tiếp tục"><i class="fas fa-arrow-circle-right"></i></a>
                    </div>
                    <hr />
                    Vào chức năng <b>Khoản phải thu</b>
                    <br />Khai báo các thông tin
                    <hr>
                    <div class="btn-group" role="group" aria-label="step actions">
                        <a class="btn-detail btn btn-sm btn-outline-success" data-target-url="">Chi tiết</a>
                    </div>
                </div>
            </div>
            <div class="arrow">→</div>

            <div id="step7" class="step" data-step-number="7">
                <div class="step-item" id="circle7">Thông báo phí</div>
                <div class="step-box">
                    <div class="step-actions">
                        <a class="btn-back-step" title="Quay lại"><i class="fas fa-arrow-circle-left"></i></a>
                        <strong>BƯỚC 6</strong>
                        <a class="btn-complete-process btn-success btn-sm" title="Kết thúc tiến trình">
                            <i class="fas fa-check-circle"></i>
                        </a>
                    </div>
                    <hr />
                    Vào chức năng <b>Thông báo phí</b>
                    <br />Khai báo các thông tin
                    <hr>
                    <div class="btn-group" role="group" aria-label="step actions">
                        <a class="btn-detail btn btn-sm btn-outline-success" data-target-url="">Chi tiết</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal" id="modalTienTrinh" style="color:black">
    <div class="modal-dialog modal-lg modal-dialog-scrollable" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalTienTrinhLabel">Thông tin tiến trình</h5>
                <button type="button" onclick="closeModal()" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body" style="color: black">

            </div>
        </div>
    </div>
</div>

@section Scripts {

    <script src="~/Content/assets/js/Process.js?v=(@DateTime.Now.Ticks)"></script>
}

