<!-- Modal đặt lịch -->
<div class="modal fade" id="bookingModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form id="bookingForm" method="post" action="@Url.Action("DatLich","LichHen")">
                <div class="modal-header">
                    <h5 class="modal-title">Đặt lịch hẹn</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" name="DichVuId" id="serviceId" />

                    <div class="mb-3">
                        <label>Dịch vụ</label>
                        <input type="text" id="serviceName" class="form-control" readonly>
                    </div>
                    <div class="mb-3">
                        <label>Họ và tên</label>
                        <input type="text" name="TenKhachHang" class="form-control" required>
                    </div>
                    <div class="mb-3">
                        <label>Số điện thoại</label>
                        <input type="text" name="SoDienThoai" class="form-control" required>
                    </div>
                    <div class="mb-3">
                        <label>Ngày hẹn</label>
                        <input type="date" name="NgayDat" class="form-control" required>
                    </div>
                    <div class="mb-3">
                        <label>Giờ hẹn</label>
                        <input type="time" name="KhungGio" class="form-control" required>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="submit" class="btn btn-success">Xác nhận</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    // Gán thông tin dịch vụ vào modal
    const bookingModal = document.getElementById('bookingModal');
    bookingModal.addEventListener('show.bs.modal', function (event) {
        const button = event.relatedTarget;
        const serviceName = button.getAttribute('data-service');
        const serviceId = button.getAttribute('data-id');

        document.getElementById('serviceName').value = serviceName;
        document.getElementById('serviceId').value = serviceId;
    });
</script>
