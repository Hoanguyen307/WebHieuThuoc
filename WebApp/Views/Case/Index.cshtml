@model PagedList.IPagedList<Models.Process>
@using PagedList.Mvc;
@{
    ViewBag.Title = "Danh sách tiến trình";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section Styles {
    <link href="~/Content/assets/css/common.css" rel="stylesheet" />
}
<div class="container-wrapper" style=" display: flex; flex-direction: column;">
    <input type="hidden" id="Id" name="Id" />
    <div class="d-flex justify-content-between mb-3">
        <h4>Danh sách tiến trình</h4>
        <div>
            <button class="btn btn-outline-success">Excel operations <i class="fa fa-download"></i></button>
        </div>
    </div>
    <form method="get" action="@Url.Action("Index", "Case")" class="input-group input-group-sm mb-3" style=" width: 335px !important;">
        @*<input type="text" class="form-control" id="searchInput" name="searchString" value="@Request["searchString"]" placeholder="Tìm kiếm..." />*@

        <select id="month" name="Month" class="form-select form-select-sm" style=" width: 100px !important;">
            <option value="">Tháng</option>
            @foreach (var m in ViewBag.Months as SelectList)
            {
                <option value="@m.Value" @(Request["Month"] == m.Value ? "selected" : "")>@m.Text</option>
            }
        </select>

        <select id="year" name="Year" class="form-select form-select-sm" style=" width: 80px !important;">
            <option value="">Năm</option>
            @foreach (var y in ViewBag.Years as SelectList)
            {
                <option value="@y.Value" @(Request["Year"] == y.Value ? "selected" : "")>@y.Text</option>
            }
        </select>

        <select id="selectToaNha" class="form-control form-control-sm" name="BuildingId" style=" width: 100px !important;">
            <option value="">-- Toà nhà --</option>
            @foreach (var b in ViewBag.Buildings as SelectList)
            {
                <option value="@b.Value" @(Request["BuildingId"] == b.Value ? "selected" : "")>@b.Text</option>
            }
        </select>
        <button class="btn btn-primary" type="submit" id="searchBtn">
            <i class="fa fa-search"></i>
        </button>
    </form>
    <div class="main-content" style="flex:1; overflow: auto;">
        <div style=" overflow-x: auto;">
            <table class="table table-striped table-bordered" style="width: 100%; table-layout: auto; white-space: nowrap;" id="ds-tientrinh">
                <thead class="thead-light">
                    <tr>
                        <th><input type="checkbox" id="SelectAll" /></th>
                        <th>STT</th>
                        <th>Tên tiến trình</th>
                        <th>Bước hoàn thành</th>
                        <th>Ngày tạo</th>
                        <th>Ngày cập nhật</th>
                        <th>Toà nhà</th>
                        <th>Trạng thái</th>
                        <th>Hành động</th>
                    </tr>
                </thead>
                <tbody id="tientrinh-body">
                    
                </tbody>
            </table>
        </div>
        <div id="pagination" class="d-flex justify-content-end mt-2"></div>
    </div>
</div>
<div id="loadingOverlay" style="display: none;">
    <div class="spinner-border text-primary" role="status">
        <span class="visually-hidden">Loading...</span>
    </div>
</div>

@section Scripts {

    <script src="~/Content/assets/js/Case.js?v=(@DateTime.Now.Ticks)"></script>
}

