@{
    ViewBag.Title = "Xác nhận OTP";
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <title>Xác nhận OTP</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet">

    <style>
        body {
            background-color: #f5f5f5;
            font-family: 'Segoe UI', sans-serif;
        }

        .login-container {
            max-width: 900px;
            margin: 60px auto;
            background: #fff;
            display: flex;
            border-radius: 12px;
            overflow: hidden;
            box-shadow: 0 5px 20px rgba(0,0,0,0.1);
        }

        .login-left, .login-right {
            flex: 1;
            padding: 40px;
        }

            .login-left h2 {
                font-weight: bold;
                margin-bottom: 10px;
            }

            .login-left p {
                color: #555;
                margin-bottom: 30px;
            }

        .form-control {
            border-radius: 8px;
            text-align: center;
            font-size: 20px;
            letter-spacing: 5px;
        }

        .btn-otp {
            background-color: black;
            color: white;
            border-radius: 30px;
            font-weight: bold;
            width: 100%;
            padding: 10px;
        }

        .login-right {
            background: url('https://file.hstatic.net/200000722513/file/abbw_cua_hang_002_209009d3b9ea42dcbef63c2b0e4108e2.jpg') center center / cover no-repeat;
            color: white;
            position: relative;
            display: flex;
            align-items: center;
            justify-content: center;
            text-align: center;
        }

            .login-right .overlay {
                background-color: rgba(0, 0, 0, 0.4);
                padding: 30px;
                border-radius: 12px;
            }

            .login-right h4 {
                font-weight: bold;
            }

        a {
            color: #007bff;
            text-decoration: none;
        }

            a:hover {
                text-decoration: underline;
            }
    </style>
</head>
<body>
    <div class="login-container">
        <!-- Left: OTP Form -->
        <div class="login-left text-center">
            <h2>Xác nhận OTP</h2>
            <p>Nhập mã OTP đã gửi tới email của bạn</p>

            <form method="post" action="@Url.Action("ConfirmOTP", "Account")">
                @Html.AntiForgeryToken()
                <div class="form-group">
                    <input type="text" class="form-control" name="otp_input" maxlength="6" placeholder="------" required />
                </div>

                <button type="submit" class="btn btn-otp">Xác nhận</button>
            </form>

            <div class="mt-3">
                <a href="@Url.Action("Register", "Account")">Quay lại đăng ký</a>
            </div>
        </div>

        <!-- Right: Banner -->
        <div class="login-right">
            <div class="overlay">
                <h4>BẢO MẬT TÀI KHOẢN</h4>
                <p>
                    Mã OTP giúp đảm bảo an toàn cho tài khoản của bạn.<br />
                    Vui lòng không chia sẻ OTP với bất kỳ ai.
                </p>
            </div>
        </div>
    </div>
</body>
</html>
