@{
    ViewBag.Title = "Đăng ký";
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <title>Đăng ký</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" rel="stylesheet" />
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>

    <style>
        body {
            background-color: #f5f5f5;
            font-family: 'Segoe UI', sans-serif;
        }

        .login-container {
            max-width: 900px;
            margin: 60px auto;
            background: #fff;
            display: flex;
            border-radius: 12px;
            overflow: hidden;
            box-shadow: 0 5px 20px rgba(0,0,0,0.1);
        }

        .login-left, .login-right {
            flex: 1;
            padding: 40px;
        }

            .login-left h2 {
                font-weight: bold;
                margin-bottom: 10px;
            }

            .login-left p {
                color: #555;
                margin-bottom: 30px;
            }

        .form-control {
            border-radius: 8px;
        }

        .btn-login {
            background-color: black;
            color: white;
            border-radius: 30px;
            font-weight: bold;
            width: 100%;
            padding: 10px;
        }

        .login-right {
            background: url('https://file.hstatic.net/200000722513/file/abbw_cua_hang_002_209009d3b9ea42dcbef63c2b0e4108e2.jpg') center center / cover no-repeat;
            color: white;
            position: relative;
            display: flex;
            align-items: center;
            justify-content: center;
            text-align: center;
        }

            .login-right .overlay {
                background-color: rgba(0, 0, 0, 0.4);
                padding: 30px;
                border-radius: 12px;
            }

        .btn-register {
            margin-top: 20px;
            border: 2px solid white;
            background-color: transparent;
            color: white;
            border-radius: 30px;
            padding: 8px 30px;
            font-weight: bold;
        }
    </style>
</head>
<body>
    <div class="login-container">
        <!-- Left: Register Form -->
        <div class="login-left">
            <h2>Đăng ký</h2>
            <p>Tạo tài khoản mới để tận hưởng các ưu đãi thành viên</p>

            <form id="form-register">
                @Html.AntiForgeryToken()

                <div class="form-group">
                    <input type="text" id="FullName" name="FullName" class="form-control" placeholder="Họ và tên" required />
                </div>

                <div class="form-group row">
                    <div class="col-md-6">
                        <label>Giới tính:</label><br />
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="radio" name="Gender" id="GenderMale" value="true" checked>
                            <label class="form-check-label" for="GenderMale">Nam</label>
                        </div>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="radio" name="Gender" id="GenderFemale" value="false">
                            <label class="form-check-label" for="GenderFemale">Nữ</label>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <label for="BirthDate">Ngày sinh:</label>
                        <input type="date" id="BirthDate" name="BirthDate" class="form-control" required />
                    </div>
                </div>

                <div class="form-group">
                    <input type="text" id="Phone" name="Phone" class="form-control" placeholder="Số điện thoại" required />
                </div>

                <div class="form-group">
                    <input type="email" id="Email" name="Email" class="form-control" placeholder="Email" required />
                </div>

                <div class="form-group">
                    <input type="text" id="Address" name="Address" class="form-control" placeholder="Địa chỉ" required />
                </div>

                <div class="form-group">
                    <input type="password" id="PasswordHash" name="PasswordHash" class="form-control" placeholder="Mật khẩu" required />
                </div>

                <button type="submit" class="btn btn-primary btn-block">Đăng ký</button>
            </form>

            <div class="text-center mt-4">
                Đã có tài khoản? <a href="@Url.Action("Login", "Account")">Đăng nhập ngay</a>
            </div>
        </div>

        <!-- Right -->
        <div class="login-right">
            <div class="overlay">
                <h4>THÀNH VIÊN MỚI</h4>
                <p>Đăng ký ngay để tích lũy điểm và nhận ưu đãi đặc biệt!</p>
                <a href="@Url.Action("Login", "Account")" class="btn btn-register">ĐĂNG NHẬP</a>
            </div>
        </div>
    </div>
    <script>
        $(document).ready(function () {
            $("#form-register").submit(function (e) {
                debugger
                e.preventDefault();

                var token = $('input[name="__RequestVerificationToken"]').val();
                var formData = {
                    FullName: $("#FullName").val(),
                    Gender: $('input[name="Gender"]:checked').val() === "true",
                    BirthDate: $("#BirthDate").val(),
                    Phone: $("#Phone").val(),
                    Email: $("#Email").val(),
                    Address: $("#Address").val(),
                    PasswordHash: $("#PasswordHash").val(),
                    __RequestVerificationToken: token
                };

                $.ajax({
                    url: '/Account/Register',
                    type: 'POST',
                    data: formData,
                    success: function (res) {
                        if (res.code === 200) {
                            toastr.success(res.msg || "Đăng ký thành công!");
                            setTimeout(function () {
                                window.location.href = "/Account/ConfirmOTP?email=" + encodeURIComponent(formData.Email);
                            }, 1000);
                        } else if (res.code === 400) {
                            toastr.error(res.msg || "Đăng ký thất bại!");
                        }
                    },
                    error: function () {
                        toastr.error("Có lỗi xảy ra, vui lòng thử lại!");
                    }
                });
            });
        });
    </script>
</body>
</html>
