@model Models.LoginViewModel
@{
    ViewBag.Title = "Đăng Nhập";
    Layout = null;

    var savedUserName = Request.Cookies["UserName"] != null ? Request.Cookies["UserName"].Value : "";
    var savedPassword = Request.Cookies["Password"] != null ? Common.EncryptionHelper.Decode(Request.Cookies["Password"].Value) : "";
    var rememberMeChecked = !string.IsNullOrEmpty(savedUserName) && !string.IsNullOrEmpty(savedPassword);
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <title>Đăng nhập</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" rel="stylesheet" />
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>

    <style>
        body {
            background-color: #f5f5f5;
            font-family: 'Segoe UI', sans-serif;
        }

        .login-container {
            max-width: 900px;
            margin: 60px auto;
            background: #fff;
            display: flex;
            border-radius: 12px;
            overflow: hidden;
            box-shadow: 0 5px 20px rgba(0,0,0,0.1);
        }

        .login-left, .login-right {
            flex: 1;
            padding: 40px;
        }

            .login-left h2 {
                font-weight: bold;
                margin-bottom: 10px;
            }

            .login-left p {
                color: #555;
                margin-bottom: 30px;
            }

        .form-control {
            border-radius: 8px;
        }

        .btn-login {
            background-color: black;
            color: white;
            border-radius: 30px;
            font-weight: bold;
            width: 100%;
            padding: 10px;
        }

        .login-right {
            background: url('https://file.hstatic.net/200000722513/file/abbw_cua_hang_002_209009d3b9ea42dcbef63c2b0e4108e2.jpg') center center / cover no-repeat;
            color: white;
            position: relative;
            display: flex;
            align-items: center;
            justify-content: center;
            text-align: center;
        }

            .login-right .overlay {
                background-color: rgba(0, 0, 0, 0.4);
                padding: 30px;
                border-radius: 12px;
            }

            .login-right h4 {
                font-weight: bold;
            }

        .btn-register {
            margin-top: 20px;
            border: 2px solid white;
            background-color: transparent;
            color: white;
            border-radius: 30px;
            padding: 8px 30px;
            font-weight: bold;
        }

        a {
            color: #007bff;
            text-decoration: none;
        }

            a:hover {
                text-decoration: underline;
            }
    </style>
</head>
<body>
    <div class="login-container">
        <!-- Left: Login Form -->
        <div class="login-left">
            <h2>Đăng nhập</h2>
            <p>Quý khách đăng nhập tài khoản để xem Điểm & hạng thành viên</p>

            <form id="loginForm" method="post" action="@Url.Action("Login", "Account")">
                @Html.AntiForgeryToken()
                <div class="form-group">
                    <div class="input-group">
                        <div class="input-group-prepend">
                            <span class="input-group-text bg-white">
                                <i class="fas fa-user"></i>
                            </span>
                        </div>
                        <input type="text" id="tendangnhap" class="form-control" name="UserName" placeholder="Tài khoản" required />
                    </div>
                </div>

                <!-- Mật khẩu -->
                <div class="form-group">
                    <div class="input-group">
                        <div class="input-group-prepend">
                            <span class="input-group-text bg-white">
                                <i class="fas fa-lock"></i>
                            </span>
                        </div>
                        <input type="password" id="matkhau" class="form-control" name="Password" placeholder="Mật khẩu" required />
                    </div>
                </div>

                <div class="form-group text-right">
                    <a href="/Account/ForgotPassword">Quên mật khẩu?</a>
                </div>

                <button type="submit" class="btn-login" id="btnLogin">
                    <span id="btnText">Đăng nhập</span>
                    <span id="loadingIcon" style="display:none;"><i class="fa fa-spinner fa-spin"></i></span>
                </button>

            </form>

            <div class="text-center mt-4">
                Bạn chưa có tài khoản? <a href="@Url.Action("Register", "Account")">Đăng ký ngay</a>
            </div>
        </div>

        <!-- Right: Register Prompt -->
        <div class="login-right">
            <div class="overlay">
                <h4>KHÁCH HÀNG MỚI</h4>
                <p>Tạo tài khoản của bạn và tận hưởng những lợi ích trực tuyến độc quyền từ chúng tôi!</p>
                <a href="@Url.Action("Register", "Account")" class="btn btn-register">ĐĂNG KÝ</a>
            </div>
        </div>
    </div>
    <script>
        $(document).ready(function () {
            updateCartCount(); // Load số giỏ hàng đúng sau khi login
        });

        $("#loginForm").submit(function (e) {
            e.preventDefault();

            $("#btnText").hide();
            $(".btn-login").prop("disabled", true);
            $("#loadingIcon").show();

            var tendangnhap = $("#tendangnhap").val().trim();
            var matkhau = $("#matkhau").val().trim();
            //var rememberMe = $("#RememberMe").is(":checked");

            if (!tendangnhap || !matkhau) {
                toastr.warning("Vui lòng nhập đầy đủ thông tin!");
                $("#btnText").show();
                $("#loadingIcon").hide();
                $(".btn-login").prop("disabled", false);
                return;
            }

            $.ajax({
                url: "/Account/Login",
                type: "POST",
                data: {
                    tendangnhap: tendangnhap,
                    matkhau: matkhau,
                    __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                },
                dataType: "json",
                success: function (res) {
                    $("#btnText").show();
                    $("#loadingIcon").hide();
                    $(".btn-login").prop("disabled", false);

                    if (res.code === 200) {
                        toastr.success(res.msg || "Đăng nhập thành công!");
                        setTimeout(function () {
                            window.location.href = res.redirectUrl || "/";
                        }, 1000);

                        //if (rememberMe) {
                        //    document.cookie = "UserName=" + encodeURIComponent(userName) + "; path=/";
                        //    document.cookie = "Password=" + encodeURIComponent(password) + "; path=/";
                        //} else {
                        //    document.cookie = "UserName=; expires=Thu, 01 Jan 1970 00:00:00 UTC; path=/;";
                        //    document.cookie = "Password=; expires=Thu, 01 Jan 1970 00:00:00 UTC; path=/;";
                        //}
                    } else {
                        toastr.error(res.msg || "Đăng nhập thất bại!");
                    }
                },
                error: function (xhr) {
                    $("#btnText").show();
                    $("#loadingIcon").hide();
                    $(".btn-login").prop("disabled", false);
                    toastr.error("Có lỗi xảy ra, vui lòng thử lại!");
                }
            });
        });
    </script>
</body>
</html>
