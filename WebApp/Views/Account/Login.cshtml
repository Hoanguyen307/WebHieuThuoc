@model Models.LoginViewModel
@{
    ViewBag.Title = "Đăng Nhập Hiệu Thuốc";
    Layout = null;

    var savedUserName = Request.Cookies["UserName"] != null ? Request.Cookies["UserName"].Value : "";
    var savedPassword = Request.Cookies["Password"] != null ? Common.EncryptionHelper.Decode(Request.Cookies["Password"].Value) : "";
    var rememberMeChecked = !string.IsNullOrEmpty(savedUserName) && !string.IsNullOrEmpty(savedPassword);
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <title>Đăng nhập - Hiệu thuốc</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" rel="stylesheet" />
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>

    <style>
        body {
            background: #eafaf1;
            font-family: 'Segoe UI', sans-serif;
        }

        .login-container {
            max-width: 600px;
            margin: 70px auto;
            background: #fff;
            display: flex;
            border-radius: 12px;
            overflow: hidden;
            box-shadow: 0 6px 20px rgba(0,0,0,0.15);
        }

        .login-left {
            flex: 1;
            padding: 40px;
        }

            .login-left h2 {
                font-weight: bold;
                color: #1b7a3d;
                margin-bottom: 15px;
            }

            .login-left p {
                color: #666;
                margin-bottom: 25px;
            }

        .form-control {
            border-radius: 8px;
        }

        .btn-login {
            background-color: #1b7a3d;
            color: white;
            border-radius: 30px;
            font-weight: bold;
            width: 100%;
            padding: 10px;
            transition: 0.3s;
        }

            .btn-login:hover {
                background-color: #14652f;
            }

        .login-right {
            flex: 1;
            background: url('https://img.freepik.com/free-photo/pharmacist-arranging-medicines-pharmacy_23-2149353742.jpg') center center / cover no-repeat;
            position: relative;
            display: flex;
            align-items: center;
            justify-content: center;
            text-align: center;
        }

            .login-right .overlay {
                background-color: rgba(27, 122, 61, 0.75);
                padding: 30px;
                border-radius: 12px;
                color: #fff;
            }

            .login-right h4 {
                font-weight: bold;
                font-size: 20px;
                margin-bottom: 15px;
            }

        .btn-register {
            margin-top: 20px;
            border: 2px solid white;
            background-color: transparent;
            color: white;
            border-radius: 30px;
            padding: 8px 30px;
            font-weight: bold;
            transition: 0.3s;
        }

            .btn-register:hover {
                background: white;
                color: #1b7a3d;
            }

        a {
            color: #1b7a3d;
            text-decoration: none;
        }

            a:hover {
                text-decoration: underline;
            }
    </style>
</head>
<body>
    <div class="login-container">
        <!-- Left: Login Form -->
        <div class="login-left">
            <div class="text-center mb-4">
                <img src="~/Content/assets/images/Logo/Logo4.png"
                     alt="Hiệu thuốc"
                     style="height: 100px;">
            </div>

            <h2><i class="fas fa-prescription-bottle-medical"></i> Đăng nhập</h2>
            <p>Hệ thống quản lý hiệu thuốc - Vui lòng đăng nhập để tiếp tục</p>

            <form id="loginForm" method="post" action="@Url.Action("Login", "Account")">
                @Html.AntiForgeryToken()
                <div class="form-group">
                    <div class="input-group">
                        <div class="input-group-prepend">
                            <span class="input-group-text bg-white">
                                <i class="fas fa-user-md"></i>
                            </span>
                        </div>
                        <input type="text" id="tendangnhap" class="form-control" name="UserName" placeholder="Tài khoản" required />
                    </div>
                </div>

                <!-- Mật khẩu -->
                <div class="form-group">
                    <div class="input-group">
                        <div class="input-group-prepend">
                            <span class="input-group-text bg-white">
                                <i class="fas fa-lock"></i>
                            </span>
                        </div>
                        <input type="password" id="matkhau" class="form-control" name="Password" placeholder="Mật khẩu" required />
                    </div>
                </div>

                <div class="form-group text-right">
                    <a href="/Account/ForgotPassword">Quên mật khẩu?</a>
                </div>

                <button type="submit" class="btn-login" id="btnLogin">
                    <span id="btnText">Đăng nhập</span>
                    <span id="loadingIcon" style="display:none;"><i class="fa fa-spinner fa-spin"></i></span>
                </button>

            </form>

            <div class="text-center mt-4">
                Bạn chưa có tài khoản? <a href="@Url.Action("Register", "Account")">Đăng ký ngay</a>
            </div>
        </div>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        $(document).ready(function () {
            updateCartCount(); // Load số giỏ hàng đúng sau khi login
        });

        $("#loginForm").submit(function (e) {
            e.preventDefault();

            $("#btnText").hide();
            $(".btn-login").prop("disabled", true);
            $("#loadingIcon").show();

            var tendangnhap = $("#tendangnhap").val().trim();
            var matkhau = $("#matkhau").val().trim();
            //var rememberMe = $("#RememberMe").is(":checked");

            if (!tendangnhap || !matkhau) {
                Swal.fire({
                    icon: 'warning',
                    title: 'Lỗi',
                    text: 'Vui lòng nhập đầy đủ thông tin!'
                });
                $("#btnText").show();
                $("#loadingIcon").hide();
                $(".btn-login").prop("disabled", false);
                return;
            }

            $.ajax({
                url: "/Account/Login",
                type: "POST",
                data: {
                    tendangnhap: tendangnhap,
                    matkhau: matkhau,
                    __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                },
                dataType: "json",
                success: function (res) {
                    $("#btnText").show();
                    $("#loadingIcon").hide();
                    $(".btn-login").prop("disabled", false);

                    if (res.code === 200) {
                        toastr.success(res.msg || 'Đăng nhập thành công!');
                        setTimeout(function () {
                            window.location.href = res.redirectUrl || "/";
                        }, 1000);

                    } else {
                        toastr.error(res.msg || "Đăng nhập thất bại!");
                        Swal.fire({
                            icon: 'error',
                            title: 'Thất bại!',
                            text: res.msg || 'Đăng nhập thất bại!'
                        });
                    }
                },
                error: function (xhr) {
                    $("#btnText").show();
                    $("#loadingIcon").hide();
                    $(".btn-login").prop("disabled", false);
                    Swal.fire({
                        icon: 'error',
                        title: 'Lỗi',
                        text: 'Có lỗi xảy ra, vui lòng thử lại!'
                    });
                }
            });
        });
    </script>
</body>
</html>
