@{
    ViewBag.Title = "Quên mật khẩu";
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <title>Quên mật khẩu</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" rel="stylesheet" />
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>

    <style>
        body {
            background-color: #f5f5f5;
            font-family: 'Segoe UI', sans-serif;
        }

        .login-container {
            max-width: 900px;
            margin: 60px auto;
            background: #fff;
            display: flex;
            border-radius: 12px;
            overflow: hidden;
            box-shadow: 0 5px 20px rgba(0,0,0,0.1);
        }

        .login-left, .login-right {
            flex: 1;
            padding: 40px;
        }

            .login-left h2 {
                font-weight: bold;
                margin-bottom: 10px;
            }

            .login-left p {
                color: #555;
                margin-bottom: 30px;
            }

        .form-control {
            border-radius: 8px;
            font-size: 16px;
        }

        .btn-forgot {
            background-color: black;
            color: white;
            border-radius: 30px;
            font-weight: bold;
            width: 100%;
            padding: 10px;
        }

        .login-right {
            background: url('https://file.hstatic.net/200000722513/file/abbw_cua_hang_002_209009d3b9ea42dcbef63c2b0e4108e2.jpg') center center / cover no-repeat;
            color: white;
            position: relative;
            display: flex;
            align-items: center;
            justify-content: center;
            text-align: center;
        }

            .login-right .overlay {
                background-color: rgba(0, 0, 0, 0.4);
                padding: 30px;
                border-radius: 12px;
            }

            .login-right h4 {
                font-weight: bold;
            }

        a {
            color: #007bff;
            text-decoration: none;
        }

            a:hover {
                text-decoration: underline;
            }
    </style>
</head>
<body>
    <div class="login-container">
        <!-- Left: Forgot Password Form -->
        <div class="login-left text-center">
            <h2>Quên mật khẩu</h2>
            <p>Nhập email để nhận mã OTP đặt lại mật khẩu</p>

            <form id="form-forgot" method="post">
                @Html.AntiForgeryToken()
                <div class="form-group text-left">
                    <label for="Email">Email của bạn</label>
                    <input type="email" class="form-control" id="Email" name="Email" required />
                </div>
                <button type="submit" id="btnForgot" class="btn btn-forgot">
                    <span class="spinner-border spinner-border-sm mr-2 d-none" id="forgotLoading"></span>
                    Gửi OTP
                </button>
            </form>

            <div class="mt-3">
                <a href="@Url.Action("Login","Account")">Quay lại đăng nhập</a>
            </div>
        </div>

        <!-- Right: Banner -->
        <div class="login-right">
            <div class="overlay">
                <h4>BẢO MẬT TÀI KHOẢN</h4>
                <p>
                    Chúng tôi sẽ gửi mã OTP đến email của bạn.<br />
                    Vui lòng không chia sẻ OTP với bất kỳ ai.
                </p>
            </div>
        </div>
    </div>
    <script>
        $("#form-forgot").submit(function (e) {
            debugger
            e.preventDefault();

            $("#btnForgot").prop("disabled", true);
            $("#forgotLoading").removeClass("d-none");

            $.ajax({
                url: '/Account/ForgotPassword',
                type: 'POST',
                data: {
                    email: $("#Email").val(),
                    __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val(),
                },
                success: function (res) {
                    if (res.code === 200) {
                        toastr.success(res.msg);
                        setTimeout(function () {
                            window.location.href = res.redirectUrl;
                        }, 1500);
                    } else {
                        toastr.error(res.msg);
                        $("#btnForgot").prop("disabled", false);
                        $("#forgotLoading").addClass("d-none");
                    }
                },
                error: function () {
                    toastr.error("Có lỗi xảy ra, vui lòng thử lại!");
                    $("#btnForgot").prop("disabled", false);
                    $("#forgotLoading").addClass("d-none");
                }
            });
        });
    </script>
</body>
</html>
