@model Models.NhapKho
@using Newtonsoft.Json
@{
    bool isEdit = Model.Id > 0;
    string actionUrl = isEdit ? Url.Action("Update", "NhapKho") : Url.Action("Add", "NhapKho");
    string autoCode = !isEdit && string.IsNullOrEmpty(Model.MaPhieu)
        ? $"PN-{DateTime.Now:yyyyMMddHHmmss}"
        : Model.MaPhieu;
}

<style>
    #productModal {
        z-index: 10003 !important;
    }
</style>
<form id="form-addNhapKho">
    @Html.HiddenFor(m => m.Id)
    <script type="text/javascript">
        window.tempProducts = @Html.Raw(ViewBag.Products ?? "[]");
        window.tempSelected = @Html.Raw(JsonConvert.SerializeObject(Model.ChiTietNhapKho ?? new List<Models.ChiTietNhapKho>()));
    </script>
    <div class="modal-body" style="color:black">
        <!-- Thông tin phiếu -->
        <div class="row">
            <div class="col-md-6 form-group">
                <label for="MaPhieu">Mã phiếu</label>
                <input type="text" class="form-control" id="MaPhieu" name="MaPhieu" value="@autoCode" readonly>
            </div>
            <div class="col-md-12 form-group">
                <label for="GhiChu">Ghi chú</label>
                <textarea class="form-control" id="GhiChu" name="GhiChu">@Model.GhiChu</textarea>
            </div>
        </div>

        <hr />

        <!-- Danh sách sản phẩm đã chọn -->
        <div class="d-flex justify-content-between align-items-center mb-2">
            <h6>Chi tiết sản phẩm</h6>
            <button type="button" class="btn btn-success btn-sm" onclick="openProductModal()">
                <i class="fas fa-plus"></i> Thêm sản phẩm
            </button>
        </div>

        <table class="table table-bordered" id="selectedProductsTable">
            <thead>
                <tr>
                    <th>Tên sản phẩm</th>
                    <th>Số lượng</th>
                    <th>Đơn giá nhập</th>
                    <th>Ngày sản xuất</th>
                    <th>Hạn sử dụng</th>
                    <th>Thành tiền</th>
                    <th>Hành động</th>
                </tr>
            </thead>
            <tbody>
                <tr><td colspan="7" class="text-center">Chưa có sản phẩm nào.</td></tr>
            </tbody>
        </table>
        <div id="SelectedPagination" class="mt-2"></div>

        <div class="text-end">
            <strong>Tổng tiền: <span id="previewTotalAmount">0</span></strong>
        </div>
    </div>

    <!-- Footer -->
    <div class="modal-footer">
        <button type="button" class="btn btn-danger btn-sm" onclick="closeModal()">
            <i class="fas fa-times"></i> Đóng
        </button>
        <button type="button" onclick="SavePhieuNhap()" class="btn btn-primary">
            <i class="fas fa-save"></i> Lưu
        </button>
    </div>
</form>

<!-- Modal phụ: chọn sản phẩm -->
<div class="modal fade" id="productModal" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-lg" style=" min-width: 1111px;">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Chọn sản phẩm nhập kho</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="text" id="searchProduct" class="form-control mb-2" placeholder="Nhập tên sản phẩm...">
                <table class="table table-sm table-bordered" id="tableAllProducts">
                    <thead>
                        <tr>
                            <th style="width: 200px;">Tên sản phẩm</th>
                            <th style="width:100px">Số lượng</th>
                            <th style="width:130px">Đơn giá nhập</th>
                            <th style="width:160px">Ngày sản xuất</th>
                            <th style="width:130px">HSD (tháng)</th>
                            <th style="width:80px">Chọn</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
                <nav><ul class="pagination justify-content-center" id="productPagination"></ul></nav>
            </div>
        </div>
    </div>
</div>
