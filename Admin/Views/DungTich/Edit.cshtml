@model Models.DungTichSanPham
@{
    ViewBag.Title = "Cập nhật dung tích sản phẩm";
}

<form id="form-addDungTich" autocomplete="off" enctype="multipart/form-data">
    @Html.HiddenFor(m => m.Id)
    @*<input type="hidden" id="Id" value=" @Model.Id" />*@
    <div class="modal-body" style="color:black">
        <div class="form-group row">
            <label>Tên sản phẩm</label>
            <p class="form-control-plaintext">@Model.ProductName</p>
            <input type="hidden" name="ProductId" value="@Model.ProductId" />
        </div>
        <div class="form-group row">
            <label>Giá gốc</label>
            <input type="text" class="form-control" id="Gia" name="Gia" value="@Model.Gia" placeholder="Giá gốc" autocomplete="off" />
        </div>
        <div class="form-group row">
            <label>Giá KM</label>
            <input type="text" class="form-control" id="SalePrice" name="SalePrice" value="@Model.SalePrice" placeholder="Giá KM" autocomplete="off" />
        </div>
        <div class="form-group row">
            <label>Dung tích</label>
            @Html.DropDownListFor(m => m.DungTichId, (SelectList)ViewBag.DungTiches, "-- Chọn dung tích --", new { @class = "form-control" })
        </div>
        <div class="form-group row">
            <label>Số lượng</label>
            <input type="number" class="form-control" id="SoLuong" name="SoLuong" value="@Model.SoLuong" placeholder="Số lượng" min="1" step="1" />
        </div>
    </div>
    <div class="modal-footer">
        <button type="button" class="btn btn-danger btn-sm" onclick="closeModal()" data-dismiss="modalproduct"><i class="fas fa-times"></i> Đóng</button>
        <button type="button" onclick="SaveDungTich()" class="btn btn-primary"> <i class="fas fa-save"></i> Lưu</button>
    </div>
</form>

