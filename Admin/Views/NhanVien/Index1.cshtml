@model PagedList.IPagedList<Models.NhanVien>
@{
    ViewBag.Title = "Lịch làm việc";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section Styles {
    <link href="~/Content/assets/css/lichlamviec.css" rel="stylesheet" />
}
<script>
    const caLamOptions = `
        <option value="">-- Chọn ca làm --</option>
        @foreach (var ca in ViewBag.Calams as SelectList)
        {
            <text><option value="@ca.Value">@ca.Text</option></text>
        }
    `;
</script>

<div class="container-wrapper" style=" display: flex; flex-direction: column;">
    <input type="hidden" id="Id" name="Id" />
    <div class="d-flex justify-content-between mb-3" style="padding: 30px 10px 0 0;">
        <h4>Lịch làm việc</h4>
        <div>
            <button class="btn btn-outline-success">Excel operations <i class="fa fa-download"></i></button>
        </div>
    </div>
    <form id="filterForm" class="filter-form">
        <div class="form-group d-flex align-items-center me-2">
            <input type="date" id="FromDate" name="FromDate" class="form-control form-control-sm" style="width: 140px !important;">
        </div>

        <div class="form-group d-flex align-items-center me-2">
            <input type="date" id="ToDate" name="ToDate" class="form-control form-control-sm" style="width: 140px !important;">
        </div>

        <div class="form-group d-flex align-items-center me-2">
            <select id="ShiftId" name="ShiftId" class="form-control form-control-sm" style="border-radius: 10px; border: 1px solid #d3cce3; font-weight: 500; width: 180px !important; text-align: center;">
                <option value="">-- Ca làm --</option>
                @foreach (var m in ViewBag.Calams as SelectList)
                {
                    <option value="@m.Value">@m.Text</option>
                }
            </select>
        </div>

        <div class="form-group d-flex align-items-center me-2">
            <select id="PositionId" name="PositionId" class="form-control form-control-sm" style="border-radius: 10px; border: 1px solid #d3cce3; font-weight: 500; width: 180px !important; text-align: center;">
                <option value="">-- Chức vụ --</option>
                @foreach (var m in ViewBag.Positions as SelectList)
                {
                    <option value="@m.Value">@m.Text</option>
                }
            </select>
        </div>

        <!-- Nút lọc -->
        <button class="btn btn-primary" type="submit" id="searchBtn" style="width: 70px; height:33px;">
            <i class="fa fa-search"></i> Xem
        </button>
    </form>

    <div id="status-legend" style="margin-bottom: 10px; display: flex; gap: 20px; flex-wrap: wrap;">
        <div class="legend-item"><span class="legend-box" style="background-color: #fff3cd;"></span> Ca sáng</div>
        <div class="legend-item"><span class="legend-box" style="background-color: #d1ecf1;"></span> Ca chiều</div>
        <div class="legend-item"><span class="legend-box" style="background-color: #d4edda;"></span> Ca linh hoạt</div>
    </div>

    <div class="main-content" style="flex: 1; overflow: auto; margin-left: 0;">
        <div style=" overflow-x: auto;">
            <table class="table table-striped table-bordered" style="width: 100%; table-layout: auto; white-space: nowrap;" id="ds-donhang">
                <thead id="lichlamviec-header" class="thead-light">
                </thead>
                <tbody id="lichlamviec-body">
                </tbody>
            </table>
        </div>
        <div id="pagination" class="d-flex justify-content-end mt-2"></div>
    </div>
</div>
<div id="loadingOverlay" style="display:none;">
    <div class="spinner-border text-primary" role="status"></div>
</div>

@section Scripts {
    <script src="~/Content/assets/js/LichLamViec.js?v=(@DateTime.Now.Ticks)"></script>
}
