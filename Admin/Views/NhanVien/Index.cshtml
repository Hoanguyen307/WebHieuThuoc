@model PagedList.IPagedList<Models.NhanVien>
@{
    ViewBag.Title = "Danh sách nhân viên";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section Styles {
    <link href="~/Content/assets/css/common.css" rel="stylesheet" />
}
<div class="container-wrapper" style=" display: flex; flex-direction: column; overflow: auto;">
    <input type="hidden" id="Id" name="Id" />
    <div class="d-flex justify-content-between mb-3">
        <h4>Danh sách nhân viên</h4>
        <div>
            @*<a href="~/Files/Template_ImportNhanVien.xlsx" class="btn btn-outline-secondary ms-2">
                <i class="fas fa-download"></i> Tải file mẫu
            </a>
            <button type="button" class="btn btn-outline-success ms-2" data-bs-toggle="modal" data-bs-target="#modalImportExcel">
                <i class="fa fa-upload"></i> Import Excel
            </button>*@
            <button type="button" class="btn btn-primary" onclick="LoadForm()">
                <i class="fas fa-plus"></i>
                Thêm mới
            </button>
        </div>
    </div>
    <form id="filterForm" class="filter-form">

        <input type="text" class="form-control form-control-sm search-input"
               id="searchString" name="searchString"
               placeholder="Tìm kiếm theo tên nhân viên..." />

        <!-- Tháng -->
        <select id="month" name="Month" class="form-select form-select-sm" style=" width: 95px !important;">
            <option value="">Tháng</option>
            @foreach (var m in ViewBag.Months as SelectList)
            {
                <option value="@m.Value">@m.Text</option>
            }
        </select>

        <!-- Năm -->
        <select id="year" name="Year" class="form-select form-select-sm" style=" width: 75px !important;">
            <option value="">Năm</option>
            @foreach (var y in ViewBag.Years as SelectList)
            {
                <option value="@y.Value">@y.Text</option>
            }
        </select>

        <select id="calam" name="ShiftId" class="form-select form-select-sm">
            <option value="">Ca làm</option>
            @foreach (var m in ViewBag.Calams as SelectList)
            {
                <option value="@m.Value">@m.Text</option>
            }
        </select>

        <select id="chucvu" name="PositionId" class="form-select form-select-sm">
            <option value="">Chức vụ</option>
            @foreach (var m in ViewBag.Positions as SelectList)
            {
                <option value="@m.Value">@m.Text</option>
            }
        </select>

        <!-- Nút lọc -->
        <button class="btn btn-primary" type="submit" id="searchBtn">
            <i class="fa fa-search"></i> Lọc
        </button>
    </form>
    <div class="main-content" style="flex:1; overflow: auto;">
        <div>
            <table class="table table-striped table-bordered" style="width: 100%; table-layout: auto; white-space: nowrap;" id="ds-nhanvien">
                <thead class="thead-light">
                    <tr>
                        <th>STT</th>
                        <th>Họ và tên</th>
                        <th>Giới tính</th>
                        <th>Số điện thoại</th>
                        <th>Chức vụ</th>
                        <th>Ca làm</th>
                        <th>Ngày bắt đầu</th>
                        <th>Hành động</th>
                    </tr>
                </thead>
                <tbody id="nhanvien-body">
                </tbody>
            </table>
        </div>
        <div id="pagination" class="d-flex justify-content-end mt-2"></div>
    </div>

    <!-- Modal -->
    <div class="modal" id="modalNhanVien" style="color:black">
        <div class="modal-dialog modal-lg modal-dialog-scrollable" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="modalNhanVienLabel">Thông tin Nhân Viên</h5>
                    <button type="button" onclick="closeModal()" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body" style="color: black"></div>
            </div>
        </div>
    </div>
    <div class="modal" id="modalXepLich" style="color:black">
        <div class="modal-dialog modal-lg modal-dialog-scrollable" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="modalXepLichLabel">Lịch làm việc</h5>
                    <button type="button" onclick="closeModal()" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body" style="color: black"></div>
            </div>
        </div>
    </div>

    <!-- Modal Import Excel -->
    <div class="modal fade" id="modalImportExcel" tabindex="-1" role="dialog" aria-labelledby="modalImportExcelLabel" aria-hidden="true">
        <div class="modal-dialog" role="document">
            <form action="@Url.Action("ImportExcel", "NhanVien")" method="post" enctype="multipart/form-data">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">Import Nhân viên từ Excel</h5>
                        <button type="button" class="close" data-dismiss="modal" aria-label="Đóng">
                            <span aria-hidden="true">&times;</span>
                        </button>
                    </div>
                    <div class="modal-body">
                        <p>Chọn file Excel theo mẫu để import nhân viên.</p>
                        <input type="file" name="excelFile" class="form-control" accept=".xlsx" required />
                    </div>
                    <div class="modal-footer">
                        <button type="submit" class="btn btn-success">Import</button>
                        <button type="button" class="btn btn-secondary" data-dismiss="modal">Đóng</button>
                    </div>
                </div>
            </form>
        </div>
    </div>

</div>

@section Scripts {
    <script src="~/Content/assets/js/NhanVien.js?v=(@DateTime.Now.Ticks)"></script>
}

