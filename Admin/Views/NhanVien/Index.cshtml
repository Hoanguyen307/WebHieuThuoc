@model PagedList.IPagedList<Models.NhanVien>
@{
    ViewBag.Title = "Danh sách nhân viên";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section Styles {
    <link href="~/Content/assets/css/common.css" rel="stylesheet" />
}
<div class="container-wrapper" style=" display: flex; flex-direction: column;">
    <input type="hidden" id="Id" name="Id" />
    <div class="d-flex justify-content-between mb-3" style="padding: 70px 10px 0 260px;">
        <h4>Danh sách nhân viên</h4>
        <div>
            <button class="btn btn-outline-success">Excel operations <i class="fa fa-download"></i></button>
            <button type="button" class="btn btn-primary" onclick="LoadForm()">
                <i class="fas fa-plus"></i>
                Thêm mới
            </button>
        </div>
    </div>
    <div class="input-group mb-3" style="width: 100%;padding: 0 10px 0 260px;">
        <input type="text" class="form-control" id="searchInput" placeholder="Tìm kiếm...">
        <button class="btn btn-primary" type="button" id="searchBtn">
            <i class="fa fa-search"></i>
        </button>
        <div id="filter-box" style="border: 1px solid #ddd;border-radius: 8px;background-color: #f9f9f9;box-shadow: 0 0 5px rgba(0,0,0,0.05);display: flex;align-items: center;gap: 10px;min-width: 210px;">
            <select id="calam" class="form-select form-select-sm">
                <option value="">Ca làm</option>
            </select>
            <select id="chucvu" class="form-select form-select-sm">
                <option value="">Chức vụ</option>
            </select>
        </div>
    </div>
    <div class="main-content" style="flex:1; overflow: auto;">
        <div style=" overflow-x: auto;">
            <table class="table table-striped table-bordered" style="width: 100%; table-layout: auto; white-space: nowrap;" id="ds-nhanvien">
                <thead class="thead-light">
                    <tr>
                        <th><input type="checkbox" id="SelectAll" /></th>
                        <th>STT</th>
                        <th>Họ và tên</th>
                        <th>Giới tính</th>
                        <th>Số điện thoại</th>
                        <th>Chức vụ</th>
                        <th>Ca làm</th>
                        <th>Ngày bắt đầu</th>
                        <th>Hành động</th>
                    </tr>
                </thead>
                <tbody id="nhanvien-body">
                    @if (Model != null && Model.Any())
                    {
                        var i = 1;
                        foreach (var item in Model)
                        {
                            <tr id="trow_@item.Id" onclick="loadLichSuChucVu(@item.Id)" style="cursor:pointer;">
                                <td></td>
                                <td>@i</td>
                                <td>@item.FullName</td>
                                <td>@(item.Gender ? "Nam" : "Nữ")</td>
                                <td>@item.Phone</td>
                                <td>@item.PositionName</td>
                                @*<td>@string.Format("{0:N0} đ", item.Salary)</td>*@
                                <td>@item.ShiftName</td>
                                <td>@(item.StartDate != null ? item.StartDate.Value.ToString("dd/MM/yyyy") : "")</td>
                                <td>
                                    <button type="button" class="btn btn-outline-primary btn-sm" onclick="handleFormUpdateNhanVien('@item.Id'); event.stopPropagation();"><i class="fas fa-edit"></i></button>
                                    <button type="button" class="btn btn-outline-danger btn-sm" onclick="handleDelete('@item.Id'); event.stopPropagation();"><i class="fas fa-trash-alt"></i></button>
                                </td>
                            </tr>
                            i++;
                        }
                    }
                </tbody>
            </table>
        </div>
        <div id="pagination" class="d-flex justify-content-end mt-2"></div>
    </div>
    <!-- Tabs chi tiết -->
    <div class="history-fixed">
        <ul class="nav nav-tabs" id="tabNhanVien" role="tablist">
            <li class="nav-item">
                <a class="nav-link active" id="lichsu-tab" data-toggle="tab" href="#lichsu" role="tab">Lịch sử chức vụ</a>
            </li>
            @*<li class="nav-item">
                    <a class="nav-link active" id="lichsu-tab" data-toggle="tab" href="#chitiet" role="tab">Thông tin chi tiết</a>
                </li>*@
            <li class="nav-item">
                <a class="nav-link" id="khac-tab" data-toggle="tab" href="#khac" role="tab">Thông tin khác</a>
            </li>
        </ul>

        <div class="tab-content mt-3" id="tabContentNhanVien">
            <div class="tab-pane fade show active" id="lichsu" role="tabpanel">
                <table class="table table-striped table-bordered">
                    <thead class="thead-light">
                        <tr>
                            <th>STT</th>
                            <th>Chức vụ</th>
                            <th>Ngày bắt đầu</th>
                            <th>Ngày kết thúc</th>
                        </tr>
                    </thead>
                    <tbody id="lichSuBody">
                        <tr>
                            <td colspan="9" class="text-center">Vui lòng chọn nhân viên</td>
                        </tr>
                    </tbody>
                </table>
            </div>

            @*<div class="tab-pane fade show active" id="thongtin" role="tabpanel" onclick="showChiTiet()">
                    <table class="table table-bordered">
                        <thead >
                            <tr>

                            </tr>
                        </thead>
                        <tbody id="ThongTinBody">
                            <tr>
                                <td colspan="4" class="text-center">Vui lòng chọn nhân viên</td>
                            </tr>
                        </tbody>
                    </table>
                </div>*@

            <!-- Tab khác -->
            <div class="tab-pane fade" id="khac" role="tabpanel">
                <p>Thông tin khác...</p>
            </div>
        </div>
    </div>

    <!-- Modal -->
    <div class="modal" id="modalNhanVien" style="color:black">
        <div class="modal-dialog modal-lg modal-dialog-scrollable" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="modalNhanVienLabel">Thông tin Nhân Viên</h5>
                    <button type="button" onclick="closeModal()" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body" style="color: black"></div>
            </div>
        </div>
    </div>

</div>

@section Scripts {
    <script src="~/Content/assets/js/NhanVien.js?v=(@DateTime.Now.Ticks)"></script>
}

