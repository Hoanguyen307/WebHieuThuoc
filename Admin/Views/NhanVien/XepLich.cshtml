@model Models.LichLamViec
@{
    ViewBag.Title = "Xếp lịch làm việc";
    var caLams = ViewBag.CaLams as List<Models.CaLam>;
    var startDate = DateTime.Today;

}
<link href="~/Content/assets/css/XepLich.css" rel="stylesheet" />


<form id="form-XepLich" autocomplete="off">
    <input type="hidden" id="Id" name="Id" value="@Model.Id" />
    <div class="modal-body" style="color:black">
        <div class="form-group row mb-4">
            <label class="col-sm-12 col-form-label fw-bold fs-5">Lịch trong tuần</label>
            <div class="col-sm-12">
                <table class="table table-schedule">
                    <thead>
                        <tr>
                            <th style="width: 160px;">Ngày</th>
                            <th>Chọn ca làm</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (int i = 0; i < 7; i++)
                        {
                            var ngay = startDate.AddDays(i);
                            <tr>
                                <td>@ngay.ToString("dddd, dd/MM/yyyy", new System.Globalization.CultureInfo("vi-VN"))</td>
                                <td>
                                    @foreach (var ca in caLams)
                                    {
                                        var checkboxId = $"lich_{ngay:yyyyMMdd}_{ca.Id}";

                                        <div class="form-check form-check-inline">
                                            <input class="form-check-input" type="checkbox"
                                                   name="lichTrongTuan"
                                                   value="@($"{ngay:yyyy-MM-dd}|{ca.Id}")"
                                                   id="@checkboxId" />
                                            <label class="form-check-label" for="@checkboxId">
                                                @ca.Name
                                            </label>
                                        </div>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="modal-footer">
        <button type="button" class="btn btn-danger btn-sm" onclick="closeModal()" data-dismiss="modal">
            <i class="fas fa-times"></i> Đóng
        </button>
        <button type="button" onclick="SaveLichLamViec()" class="btn btn-primary btn-sm">
            <i class="fas fa-save"></i> Lưu
        </button>
    </div>
</form>
