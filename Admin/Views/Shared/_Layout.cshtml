    <style>
        :root {
            --primary-color: #0d6efd;
            --secondary-color: #6c757d;
            --success-color: #198754;
            --info-color: #0dcaf0;
            --warning-color: #ffc107;
            --danger-color: #dc3545;
            --light-bg: #f8f9fa;
            --dark-bg: #212529;
            --sidebar-width: 250px;
            --topbar-height: 60px;
        }
        /* ... (Phần CSS giữ nguyên) ... */
        body {
            font-family: 'Segoe UI', Arial, sans-serif;
            background-color: var(--light-bg);
            color: var(--dark-bg);
            margin: 0;
            padding-top: var(--topbar-height);
        }

        #layout-wrapper {
            display: flex;
            min-height: 100vh;
        }

        /* Topbar - Header */
        #page-topbar {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            height: var(--topbar-height);
            z-index: 1001;
            background-color: #fff;
            box-shadow: 0 2px 5px rgba(0,0,0,0.05);
            padding: 0 1rem;
            display: flex;
            align-items: center;
        }

        .navbar-header {
            width: 100%;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .navbar-brand-box {
            display: flex;
            align-items: center;
        }

        #navbarDropdown {
            color: #212529d4 !important;
        }

        #navbarDropdown :hover{
            color: dodgerblue !important;
        }

        /* Sidebar - Menu */
        #layoutSidenav {
            display: flex;
            flex-grow: 1;
        }

        #layoutSidenav_nav {
            position: fixed;
            top: var(--topbar-height);
            bottom: 0;
            left: 0;
            width: var(--sidebar-width);
            z-index: 1000;
            background-color: #2c3e50;
            color: #ecf0f1;
            transition: width 0.3s ease;
        }

        .sb-sidenav-menu {
            padding-top: 20px;
        }

        .nav-link {
            transition: all 0.3s ease;
            color: #ecf0f1;
            padding: 12px 15px;
            margin-bottom: 5px;
            display: flex;
            align-items: center;
        }

            .nav-link:hover {
                background-color: rgba(255, 255, 255, 0.1);
                color: #fff !important;
            }

            .nav-link.active {
                background-color: #1078e0;
                color: #fff !important;
                font-weight: bold;
            }

        .sb-nav-link-icon {
            margin-right: 12px;
            font-size: 1.2rem;
        }

        .sb-sidenav-menu-heading {
            font-size: 0.75rem;
            color: #bdc3c7;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            padding: 1rem 1.5rem;
        }

        /* Main Content */
        #layoutSidenav_content {
            flex-grow: 1;
            margin-left: var(--sidebar-width);
            padding: 2rem 1.5rem;
            transition: margin-left 0.3s ease;
        }

        /* Dashboard Cards */
        .card-dashboard {
            border-radius: 15px;
            color: #fff;
            font-weight: 500;
            transition: transform 0.3s ease, box-shadow 0.3s ease;
        }

            .card-dashboard:hover {
                transform: translateY(-5px);
                box-shadow: 0 8px 30px rgba(0,0,0,0.1);
            }

        /* Toggles */
        @@media (max-width: 768px) {
            #layoutSidenav_nav {
                width: 70px;
            }

                #layoutSidenav_nav .sb-sidenav-menu-heading,
                #layoutSidenav_nav .nav-link span,
                #layoutSidenav_nav .right-arrow {
                    display: none;
                }

                #layoutSidenav_nav .nav-link {
                    text-align: center;
                    padding: 10px 0;
                }

                    #layoutSidenav_nav .nav-link .sb-nav-link-icon {
                        margin-right: 0;
                    }

            #layoutSidenav_content {
                margin-left: 70px;
            }
        }
    </style>
</head>
<body class="sb-nav-fixed">
