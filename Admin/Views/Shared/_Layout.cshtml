<!doctype html>
<html lang="vi" data-layout="vertical" data-topbar="light" data-sidebar="dark" data-sidebar-size="lg">
<head>
    <meta charset="utf-8" />
    @if (HttpContext.Current.Request.Url.Host.Contains("localhost"))
    {
        <base href="/">
    }
    else
    {
        <base href="/admin/">
    }
    <title>QUẢN LÝ HIỆU THUỐC</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta content="Quản lý hiệu thuốc" name="description" />
    <meta content="Your Name" name="author" />

    <link rel="shortcut icon" href="~/Content/assets/images/Logo/Logo2.png">

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

    <link href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" rel="stylesheet" />

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/dayjs@1/dayjs.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.0/Sortable.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/popper.js@1.12.9/dist/umd/popper.min.js" integrity="sha384-ApNbgh9B+Y1QKtv3Rn7W3mgPxhU9K/ScQsAP7hUibX39j7fakFPskvXusvfa0b4Q" crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/dayjs@1/plugin/customParseFormat.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <link href="https://cdn.jsdelivr.net/npm/summernote@0.8.18/dist/summernote-lite.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/summernote@0.8.18/dist/summernote-lite.min.js"></script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css" />

    <script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>
    <style>
        :root {
            --primary-color: #0d6efd;
            --sidebar-width: 260px;
            --sidebar-collapsed-width: 70px;
            --topbar-height: 60px;
            --dark-sidebar-bg: #2c3e50;
            --light-bg: #f3f3f9;
        }

        html, body {
            height: 100%;
            margin: 0;
            padding: 0;
            overflow: hidden;
        }

        body {
            font-family: 'Segoe UI', Arial, sans-serif;
            background-color: var(--light-bg);
        }

        #layout-wrapper {
            display: flex;
            flex-direction: column;
            height: 100vh;
        }

        #page-topbar {
            height: var(--topbar-height);
            flex-shrink: 0;
            background-color: #fff;
            box-shadow: 0 2px 4px rgba(0,0,0,.08);
            z-index: 1001;
            display: flex;
            align-items: center;
            padding: 0 1.5rem;
        }

        .navbar-header {
            width: 100%;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        #main-container {
            display: flex;
            flex: 1;
            overflow: hidden;
        }

        #layoutSidenav_nav {
            width: var(--sidebar-width);
            background-color: var(--dark-sidebar-bg);
            color: #bdc3c7;
            flex-shrink: 0;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            overflow-y: auto;
            overflow-x: hidden;
            display: flex;
            flex-direction: column;
            z-index: 1000;
        }

        #layoutSidenav_content {
            flex: 1;
            overflow-y: auto;
            background-color: var(--light-bg);
        }

        #layoutSidenav_nav .nav-link:hover {
            color: #fff !important;
            background-color: rgba(255, 255, 255, 0.1) !important;
            border-left: 4px solid #1078e0;
            font-weight: bold;
        }

        #layoutSidenav_nav .nav-link.active {
            color: #fff !important;
            background-color: rgba(255, 255, 255, 0.1) !important;
            border-left: 4px solid #1078e0;
            font-weight: bold;
        }

        #layoutSidenav_nav .nav-link {
            color: #abb9e8;
            display: flex;
            align-items: center;
            padding: 12px 20px;
            text-decoration: none;
            white-space: nowrap;
            gap: 10px;
        }

            #layoutSidenav_nav .nav-link i {
                width: 24px;
                text-align: center;
                font-size: 1.1rem;
                flex-shrink: 0;
            }

            #layoutSidenav_nav .nav-link span,
            #layoutSidenav_nav .nav-link {
                display: flex;
                align-items: center;
            }

        .nav-sm .nav-link {
            padding-left: 3.5rem !important;
        }

        .menu-title {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 1.5rem 1.25rem 0.5rem !important;
        }

        .sidebar-collapsed #layoutSidenav_nav {
            width: var(--sidebar-collapsed-width);
        }

            .sidebar-collapsed #layoutSidenav_nav span,
            .sidebar-collapsed #layoutSidenav_nav .menu-title,
            .sidebar-collapsed #layoutSidenav_nav .nav-link::after,
            .sidebar-collapsed #layoutSidenav_nav .menu-text {
                display: none !important;
                opacity: 0 !important;
                visibility: hidden !important;
            }

            .sidebar-collapsed #layoutSidenav_nav .nav-link {
                justify-content: center !important;
                padding-left: 0 !important;
                padding-right: 0 !important;
                gap: 0 !important;
            }

                .sidebar-collapsed #layoutSidenav_nav .nav-link i {
                    margin: 0 !important;
                }

        .sidebar-collapsed #layoutSidenav_content {
            transition: all 0.3s ease;
        }

        .menu-title {
            padding: 1rem 1.5rem 0.5rem;
            font-size: 0.65rem;
            text-transform: uppercase;
            letter-spacing: .05em;
            color: #8391a2;
        }

        .collapse.menu-dropdown {
            background: rgba(0,0,0,0.15);
        }

        .nav-sm .nav-link {
            padding-left: 3.25rem;
            font-size: 0.85rem;
        }


        @@media (max-width: 992px) {
            #layoutSidenav_nav {
                width: var(--sidebar-collapsed-width);
            }

                #layoutSidenav_nav span, .menu-title {
                    display: none;
                }
        }
    </style>
</head>
<body class="m-0 p-0">
    @RenderSection("naviheader", required: false)
    @RenderSection("scripts", required: false)
    @RenderSection("Styles", required: false)

    <div id="layout-wrapper">
        <header id="page-topbar">
            <div class="navbar-header">
                <div class="d-flex align-items-center">
                    <button class="btn btn-link text-dark fs-4 px-3 shadow-none" id="sidebarToggleInternal">
                        <i class="fas fa-bars"></i>
                    </button>
                    <a class="navbar-brand fw-bold fs-4 text-success" href="@Url.Action("Index", "Admin")">
                        <i class="fa fa-prescription-bottle-alt me-2"></i>QUẢN LÝ HIỆU THUỐC
                    </a>
                </div>

                <div class="d-flex align-items-center">
                    <div class="input-group d-none d-lg-flex me-3 search-bar">
                        <input class="form-control" type="text" placeholder="Tìm kiếm..." aria-label="Tìm kiếm..." />
                        <button class="btn btn-primary" type="button"><i class="fas fa-search"></i></button>
                    </div>

                    <div class="dropdown ms-sm-3 topbar-user-dropdown">
                        <a class="nav-link dropdown-toggle d-flex align-items-center" id="navbarDropdown" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="fas fa-user-circle fa-2x header-avatar-icon me-2 d-none d-sm-inline-block"></i>
                            @*@if (User.Identity.IsAuthenticated)
                                {
                                    <span class="d-none d-md-inline-block">@User.Identity.Name</span>
                                }
                                else
                                {
                                    <span class="d-none d-md-inline-block">Khách</span>
                                }*@
                        </a>
                        <div class="dropdown-menu dropdown-menu-end">
                            @if (User.Identity.IsAuthenticated)
                            {
                                <h6 class="dropdown-header">Xin chào, @User.Identity.Name!</h6>
                                <a class="dropdown-item" href="#">
                                    <i class="fas fa-cog me-2"></i> Cài đặt
                                </a>
                                <a class="dropdown-item" href="#">
                                    <i class="fas fa-key me-2"></i> Thay đổi mật khẩu
                                </a>
                                <div class="dropdown-divider"></div>
                                <form action="@Url.Action("LogOff", "Account")" method="post" style="display:inline;">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="dropdown-item text-danger" style="background:none;border:none;">
                                        <i class="fas fa-sign-out-alt me-2"></i> Đăng xuất
                                    </button>
                                </form>
                            }
                            else
                            {
                                <h6 class="dropdown-header">Chào mừng bạn!</h6>
                                <a class="dropdown-item" href="@Url.Action("Login", "Account")">
                                    <i class="fas fa-sign-in-alt me-2"></i> Đăng nhập
                                </a>
                                <a class="dropdown-item" href="@Url.Action("Register", "Account")">
                                    <i class="fas fa-user-plus me-2"></i> Đăng ký
                                </a>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </header>
        <div id="main-container">
            <nav id="layoutSidenav_nav">
                @Html.Partial("_PartiaSideBar")
            </nav>
            <main id="layoutSidenav_content">
                @RenderBody()
            </main>
        </div>

    </div>

    <script src="~/Content/assets/libs/swiper/swiper-bundle.min.js"></script>
    <script>
        var rootPath = '@(HttpContext.Current.Request.Url.Host.Contains("localhost") ? "/" : "/admin/")';
        $(document).ready(function () {
            $('#sidebarToggleInternal').on('click', function () {
                $('body').toggleClass('sidebar-collapsed');
            });
        });

        let lastOrderIdGlobal = 0;

        function initLastOrderId() {
            $.ajax({
                url: rootPath + 'Order/GetLatestOrderId',
                type: 'GET',
                success: function (res) {
                    lastOrderIdGlobal = res.latestOrderId || 0;
                    checkNewOrdersGlobal();
                },
                error: function () {
                    console.error("Lỗi khi lấy ID đơn hàng mới nhất");
                }
            });
        }

        function checkNewOrdersGlobal() {
            $.ajax({
                url: rootPath + 'Order/GetNewOrders',
                type: 'GET',
                data: { lastOrderId: lastOrderIdGlobal },
                success: function (res) {
                    if (res.hasNew) {
                        const viewedOrderId = localStorage.getItem('lastViewedOrderId');
                        if (viewedOrderId && parseInt(viewedOrderId) >= res.newestOrderId) {
                            return;
                        }

                        lastOrderIdGlobal = res.newestOrderId;

                        Swal.fire({
                            title: 'Có đơn hàng mới!',
                            text: `Có ${res.newCount} đơn hàng mới cần xử lý`,
                            icon: 'info',
                            confirmButtonText: 'Xem ngay'
                        }).then((result) => {
                            if (result.isConfirmed) {
                                localStorage.setItem('lastViewedOrderId', res.newestOrderId);
                                window.location.href = rootPath + 'Order/Index';
                            }
                        });
                    }
                },
                error: function () {
                    console.error("Lỗi khi kiểm tra đơn hàng mới");
                }
            });
        }

        // Kiểm tra mỗi 10 giây
        setInterval(checkNewOrdersGlobal, 10000);

        $(document).ready(function () {
            initLastOrderId();
        });
    </script>
</body>
</html>