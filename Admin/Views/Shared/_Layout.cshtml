    <script src="~/Content/assets/js/pages/dashboard-ecommerce.init.js"></script>
    <script>
        // JavaScript logic goes here, after jQuery is loaded
        document.addEventListener("DOMContentLoaded", function () {
            const collapseToggles = document.querySelectorAll('[data-bs-toggle="collapse"]');

            collapseToggles.forEach(toggle => {
                const targetId = toggle.getAttribute("href");
                const target = document.querySelector(targetId);

                if (!target) return;

                const collapseInstance = new bootstrap.Collapse(target, {
                    toggle: false
                });

                toggle.addEventListener("click", function (e) {
                    e.preventDefault();

                    if (target.classList.contains("show")) {
                        collapseInstance.hide();
                    } else {
                        collapseInstance.show();
                    }
                });
            });
        });

        let lastOrderIdGlobal = 0; // lưu ID đơn hàng mới nhất đã biết

        function initLastOrderId() {
            $.ajax({
                url: '/Order/GetLatestOrderId', 
                type: 'GET',
                success: function (res) {
                    lastOrderIdGlobal = res.latestOrderId || 0;
                    checkNewOrdersGlobal();
                },
                error: function () {
                    console.error("Lỗi khi lấy ID đơn hàng mới nhất");
                }
            });
        }

        function checkNewOrdersGlobal() {
            $.ajax({
                url: '/Order/GetNewOrders',
                type: 'GET',
                data: { lastOrderId: lastOrderIdGlobal },
                success: function (res) {
                    if (res.hasNew) {
                        const viewedOrderId = localStorage.getItem('lastViewedOrderId');
                        if (viewedOrderId && parseInt(viewedOrderId) >= res.newestOrderId) {
                            return; // đã xem rồi
                        }

                        lastOrderIdGlobal = res.newestOrderId; // cập nhật ID mới nhất

                        Swal.fire({
                            title: 'Có đơn hàng mới!',
                            text: `Có ${res.newCount} đơn hàng mới cần xử lý`,
                            icon: 'info',
                            confirmButtonText: 'Xem ngay'
                        }).then((result) => {
                            if (result.isConfirmed) {
                                localStorage.setItem('lastViewedOrderId', res.newestOrderId);
                                window.location.href = '/Order/Index';
                            }
                        });
                    }
                },
                error: function () {
                    console.error("Lỗi khi kiểm tra đơn hàng mới");
                }
            });
        }

        // Kiểm tra mỗi 10 giây
        setInterval(checkNewOrdersGlobal, 10000);

        $(document).ready(function () {
            initLastOrderId();
        });
    </script>
</body>
