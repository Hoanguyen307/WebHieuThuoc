@model PagedList.IPagedList<Models.ProductCategory>
@{
    ViewBag.Title = "Danh mục sản phẩm";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section Styles {
    <link href="~/Content/assets/css/common.css" rel="stylesheet" />
}
<div class="container-wrapper" style=" display: flex; flex-direction: column;">
    <div class="d-flex justify-content-between mb-3" style="padding: 10px 10px 0 260px;">
        <h4>Danh sách danh mục sản phẩm</h4>
        <div>
            <button class="btn btn-outline-success">Excel operations <i class="fa fa-download"></i></button>
            <button type="button" class="btn btn-primary" onclick="LoadForm()">
                <i class="fas fa-plus"></i>
                Thêm mới
            </button>
        </div>
    </div>
    <div class="main-content" style="flex:1; overflow: auto;">
        <div style=" overflow-x: auto;">
            <table class="table table-striped table-bordered" style="width: 100%; table-layout: auto; white-space: nowrap;" id="ds-danhmuc">
                <thead class="thead-light">
                    <tr>
                        <th>STT</th>
                        <th>Tên danh mục</th>
                        <th>Mô tả</th>
                        <th>Danh mục</th>
                        <th>Hành động</th>
                    </tr>
                </thead>
                <tbody id="danhmuc-body">
                </tbody>
            </table>
        </div>
        <div id="pagination" class="d-flex justify-content-end mt-2"></div>
    </div>
    <div class="modal" id="modalDanhMuc" style="color:black">
        <div class="modal-dialog modal-lg modal-dialog-scrollable" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="modaldanhmucLabel">Thông tin Danh mục</h5>
                    <button type="button" onclick="closeModal()" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body" style="color: black">

                </div>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <script src="~/Content/assets/js/ProductCategory.js?v=(@DateTime.Now.Ticks)"></script>
}

