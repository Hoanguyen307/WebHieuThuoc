@model Models.ProductCategory
@{
    ViewBag.Title = "Thêm mới danh mục";
    bool isEdit = Model.DanhMucId > 0;
    string actionUrl = isEdit ? Url.Action("Update", "ProductCategory") : Url.Action("Add", "ProductCategory");
}

<form id="form-addDanhmuc" autocomplete="off" enctype="multipart/form-data">
    @Html.HiddenFor(m => m.DanhMucId)
    @*<input type="hidden" id="Id" value=" @Model.Id" />*@
    <div class="modal-body" style="color:black">
        <div class="form-group row">
            <label>Tên Danh Mục</label>
            <input type="text" class="form-control" id="TenDanhMuc" name="TenDanhMuc" placeholder="Tên danh mục" value="@Model.TenDanhMuc" autocomplete="off" />
        </div>
        <div class="form-group row">
            <label>Url</label>
            <input type="text" class="form-control" id="SeoSlug" name="SeoSlug" value="@Model.SeoSlug" placeholder="Đường dẫn" />
        </div>
        <div class="form-group row">
            <label>Mô tả</label>
            <input type="text" class="form-control" id="MoTa" name="MoTa" value="@Model.MoTa" placeholder="Mô tả" autocomplete="off" />
        </div>
        <div class="form-group row">
            <label>Danh mục</label>
            @Html.DropDownListFor(m => m.Category_ID, (SelectList)ViewBag.ProductCategories, "-- Chọn danh mục --", new { @class = "form-control" })
        </div>
        <div class="form-group row">
            <div class="form-check">
                <input type="hidden" name="KichHoat" value="false" />
                <input type="checkbox" class="form-check-input" id="KichHoat" name="KichHoat" value="true" @(Model.KichHoat ? "checked" : "") />
                <label class="form-check-label" for="IsActive">Hiển thị danh mục</label>
            </div>
        </div>

    </div>
    <div class="modal-footer">
        <button type="button" class="btn btn-danger btn-sm" onclick="closeModal()" data-dismiss="modaldanhmuc"><i class="fas fa-times"></i> Đóng</button>
        <button type="button" onclick="SaveDanhMuc()" class="btn btn-primary"> <i class="fas fa-save"></i> Lưu</button>
    </div>
</form>

