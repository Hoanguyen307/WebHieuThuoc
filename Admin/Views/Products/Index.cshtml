@model PagedList.IPagedList<Models.Product>
@using PagedList.Mvc;
@{
    ViewBag.Title = "Danh sách sản phẩm";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section Styles {
    <link href="~/Content/assets/css/common.css" rel="stylesheet" />
}

<div class="container-wrapper" style=" display: flex; flex-direction: column;">
    <input type="hidden" id="Id" name="Id" />
    <div class="d-flex justify-content-between mb-3" style="padding: 70px 10px 0 260px;">
        <h4>Danh sách sản phẩm</h4>
        <div>
            <button class="btn btn-outline-success">Excel operations <i class="fa fa-download"></i></button>
            <button type="button" class="btn btn-primary" onclick="LoadForm()">
                <i class="fas fa-plus"></i>
                Thêm mới
            </button>
        </div>
    </div>
    <div class="input-group mb-3" style="width: 100%;padding: 0 10px 0 260px;">
        <input type="text" class="form-control" id="searchInput" placeholder="Tìm kiếm...">
        <button class="btn btn-primary" type="button" id="searchBtn">
            <i class="fa fa-search"></i>
        </button>
    </div>
    <div class="main-content" style="flex:1; overflow: auto;">
        <div style=" overflow-x: auto;">
            <table id="ds-sanpham" class="table table-striped table-bordered" style="width: 100%; table-layout: auto; white-space: nowrap;">
                <thead class="thead-light">
                    <tr>
                        <th><input type="checkbox" id="SelectAll" /></th>
                        <th>STT</th>
                        <th>Hình ảnh</th>
                        <th>Tên sản phẩm</th>
                        <th>Danh mục</th>
                        <th>Số lượng hàng tồn</th>
                        <th>Số lượng đã bán</th>
                        <th>Giá</th>
                        <th>Giá KM</th>
                        <th>Hiển thị</th>
                        <th>Nổi bật</th>
                        <th>Hành động</th>
                    </tr>
                </thead>
                <tbody id="danhmuc-body">
                    @if (Model != null && Model.Any())
                    {
                        var i = 1;
                        foreach (var item in Model)
                        {
                            <tr id="trow_@item.Id">
                                <td></td>
                                <td>@i</td>
                                <td>
                                    <img src="@item.Image" alt="Ảnh" style="height:50px" />
                                </td>
                                <td>@item.Name</td>
                                <td>@item.CategoryName</td>
                                <td>@item.Quantity</td>
                                <td>@item.Sold</td>
                                <td>@string.Format("{0:N0} đ", item.Price)</td>
                                <td>@string.Format("{0:N0} đ", item.SalePrice)</td>
                                @*<td>
                                        @if (item.SalePrice.HasValue)
                                        {
                                            @string.Format("{0:N0} đ", item.SalePrice)
                                        }
                                    </td>*@
                                <td>
                                    <span class="badge badge-@(item.IsActive ? "success" : "secondary")">
                                        @(item.IsActive ? "Hiện" : "Ẩn")
                                    </span>
                                </td>
                                <td>
                                    <span class="badge badge-@(item.IsFeatured ? "warning" : "light")">
                                        @(item.IsFeatured ? "Nổi bật" : "-")
                                    </span>
                                </td>
                                <td>
                                    <button type="button" class="btn btn-outline-primary btn-sm" onclick="handleFormUpdateProduct('@item.Id')"><i class="fas fa-edit"></i></button>
                                    <button type="button" class="btn btn-outline-danger btn-sm" onclick="handleDelete('@item.Id')"><i class="fas fa-trash-alt"></i></button>
                                </td>
                            </tr>
                            i++;
                        }
                    }
                </tbody>
            </table>
        </div>

        <div id="pagination" class="d-flex justify-content-end mt-2"></div>
    </div>
    <div class="modal" id="modalProduct" style="color:black">
        <div class="modal-dialog modal-lg modal-dialog-scrollable" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="modalProductLabel">Thông tin Sản phẩm</h5>
                    <button type="button" onclick="closeModal()" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body" style="color: black">

                </div>
            </div>
        </div>
    </div>
</div>
@section Scripts {

    <script src="~/Content/assets/js/Product.js?v=(@DateTime.Now.Ticks)"></script>
}

