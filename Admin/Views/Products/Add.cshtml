@model Models.Product
@{
    ViewBag.Title = "Thêm mới thuốc";
    bool isEdit = Model.ThuocId > 0;
    string actionUrl = isEdit ? Url.Action("Update", "Product") : Url.Action("Add", "Product");
}

<form id="form-addProduct" autocomplete="off" enctype="multipart/form-data">
    @Html.HiddenFor(m => m.ThuocId)
    @*<input type="hidden" id="Id" value=" @Model.Id" />*@
    <div class="modal-body" style="color:black">
        <div class="form-group row">
            <label>Tên sản phẩm</label>
            <input type="text" class="form-control" id="TenThuoc" name="TenThuoc" placeholder="Tên sản phẩm" value="@Model.TenThuoc" autocomplete="off" />
        </div>
        <div class="form-group row">
            <label>Mô tả</label>
            <input type="text" class="form-control" id="QuyCach" name="QuyCach" placeholder="Mô tả" value="@Model.QuyCach" />
        </div>
        <div class="form-group row">
            <label>Công dụng</label>
            <input type="text" class="form-control" id="CongDung" name="CongDung" value="@Model.CongDung" />
        </div>
        <div class="form-group row">
            <label>Thành phần</label>
            <input type="text" class="form-control" id="ThanhPhan" name="ThanhPhan" value="@Model.ThanhPhan" />
        </div>
        <div class="form-group row">
            <label>Cách sử dụng</label>
            <textarea class="form-control" id="CachSuDung" name="CachSuDung">@Model.CachSuDung</textarea>
        </div>
        <div class="form-group row">
            <div class="col-4">
                <label>Đơn vị tính</label>
                <input type="text" class="form-control" id="DonViTinh" name="DonViTinh" value="@Model.DonViTinh" />
            </div>
            <div class="col-4">
                <label>Giá gốc</label>
                <input type="text" class="form-control" id="GiaGoc" name="GiaGoc" value="@Model.GiaGoc" autocomplete="off" />
            </div>
            <div class="col-4">
                <label>Giá bán</label>
                <input type="text" class="form-control" id="GiaBan" name="GiaBan" value="@Model.GiaBan" autocomplete="off" />
            </div>
        </div>
        <div class="form-group row">
            <label>Danh mục</label>
            @Html.DropDownListFor(m => m.DanhMucId, (SelectList)ViewBag.ProductCategories, "-- Chọn danh mục --", new { @class = "form-control" })
        </div>
        <div class="form-group row">
            <label>Nhà cung cấp</label>
            @Html.DropDownListFor(m => m.NhaCungCapId, (SelectList)ViewBag.NhaCungCaps, "-- Chọn nhà cung cấp --", new { @class = "form-control" })
        </div>
        <div class="form-group row">
            <label>Ảnh</label>
            <input type="file" class="form-control" id="ImageFile" name="ImageFile" accept="image/*" />
            @if (!string.IsNullOrEmpty(Model.HinhAnh))
            {
                <div class="mt-2">
                    <p>Ảnh hiện tại:</p>
                    <img src="@Url.Content(Model.HinhAnh)" style="max-height: 100px; border: 1px solid #ccc; padding: 4px;" />
                </div>
                <input type="hidden" name="HinhAnh" value="@Model.HinhAnh" />
            }
        </div>
        <div class="form-group row">
            <div class="col-6">
                <div class="form-check">
                    <input type="hidden" name="KichHoat" value="false" />
                    <input type="checkbox" class="form-check-input" id="KichHoat" name="KichHoat" value="true" @(Model.KichHoat ? "checked" : "") />
                    <label class="form-check-label" for="KichHoat">Hiển thị</label>
                </div>
            </div>
            <div class="col-6">
                <div class="form-check">
                    <input type="hidden" name="ThuocKeDon" value="false" />
                    <input type="checkbox" class="form-check-input" id="ThuocKeDon" name="ThuocKeDon" value="true" @(Model.ThuocKeDon ? "checked" : "") />
                    <label class="form-check-label" for="ThuocKeDon">Thuốc kê đơn</label>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-footer">
        <button type="button" class="btn btn-danger btn-sm" onclick="closeModal()" data-dismiss="modalproduct"><i class="fas fa-times"></i> Đóng</button>
        <button type="button" onclick="SaveProduct()" class="btn btn-primary"> <i class="fas fa-save"></i> Lưu</button>
    </div>
</form>

<script>
    $(document).ready(function () {
        $('#CachSuDung').summernote({
            placeholder: 'Nhập hướng dẫn sử dụng chi tiết tại đây...',
            tabsize: 2,
            height: 200,
            toolbar: [
                ['style', ['style']],
                ['font', ['bold', 'underline', 'clear']],
                ['color', ['color']],
                ['para', ['ul', 'ol', 'paragraph']],
                ['table', ['table']],
                ['insert', ['link', 'picture']],
                ['view', ['fullscreen', 'codeview']]
            ],
            callbacks: {
                onChange: function (contents, $editable) {
                    $('#CachSuDung').val(contents);
                }
            }
        });
    });
</script>