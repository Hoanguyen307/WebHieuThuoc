@model Models.LoginViewModel
@{
    ViewBag.Title = "Đăng Nhập Hiệu Thuốc";
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <title>Đăng nhập - Hiệu thuốc</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet">

    <style>
        body {
            background: #eafaf1;
            font-family: 'Segoe UI', sans-serif;
        }

        .login-container {
            max-width: 600px;
            margin: 70px auto;
            background: #fff;
            display: flex;
            border-radius: 12px;
            overflow: hidden;
            box-shadow: 0 6px 20px rgba(0,0,0,0.15);
        }

        .login-left {
            flex: 1;
            padding: 40px;
        }

            .login-left h2 {
                font-weight: bold;
                color: #1b7a3d;
                margin-bottom: 15px;
            }

            .login-left p {
                color: #666;
                margin-bottom: 25px;
            }

        .form-control {
            border-radius: 8px;
        }

        .btn-login {
            background-color: #1b7a3d;
            color: white;
            border-radius: 30px;
            font-weight: bold;
            width: 100%;
            padding: 10px;
            transition: 0.3s;
        }

            .btn-login:hover {
                background-color: #14652f;
            }

        .login-right {
            flex: 1;
            background: url('https://img.freepik.com/free-photo/pharmacist-arranging-medicines-pharmacy_23-2149353742.jpg') center center / cover no-repeat;
            position: relative;
            display: flex;
            align-items: center;
            justify-content: center;
            text-align: center;
        }

            .login-right .overlay {
                background-color: rgba(27, 122, 61, 0.75);
                padding: 30px;
                border-radius: 12px;
                color: #fff;
            }

            .login-right h4 {
                font-weight: bold;
                font-size: 20px;
                margin-bottom: 15px;
            }

        .btn-register {
            margin-top: 20px;
            border: 2px solid white;
            background-color: transparent;
            color: white;
            border-radius: 30px;
            padding: 8px 30px;
            font-weight: bold;
            transition: 0.3s;
        }

            .btn-register:hover {
                background: white;
                color: #1b7a3d;
            }

        a {
            color: #1b7a3d;
            text-decoration: none;
        }

            a:hover {
                text-decoration: underline;
            }
    </style>
</head>
<body>
    <div class="login-container">
        <!-- Left: Login Form -->
        <div class="login-left">
            <h2><i class="fas fa-prescription-bottle-medical"></i> Đăng nhập</h2>
            <p>Hệ thống quản lý hiệu thuốc - Vui lòng đăng nhập để tiếp tục</p>

            <form id="loginForm" method="post" action="@Url.Action("Login", "Account")">
                @Html.AntiForgeryToken()
                <div class="form-group">
                    <div class="input-group">
                        <div class="input-group-prepend">
                            <span class="input-group-text bg-white">
                                <i class="fas fa-user-md"></i>
                            </span>
                        </div>
                        <input type="text" id="tendangnhap" class="form-control" name="UserName" placeholder="Tài khoản" required />
                    </div>
                </div>

                <!-- Mật khẩu -->
                <div class="form-group">
                    <div class="input-group">
                        <div class="input-group-prepend">
                            <span class="input-group-text bg-white">
                                <i class="fas fa-lock"></i>
                            </span>
                        </div>
                        <input type="password" id="matkhau" class="form-control" name="Password" placeholder="Mật khẩu" required />
                    </div>
                </div>

                <div class="form-group text-right">
                    <a href="#">Quên mật khẩu?</a>
                </div>

                <button type="submit" class="btn btn-login" id="btnLogin">
                    <span id="btnText">Đăng nhập</span>
                    <i id="loadingIcon" class="fa fa-spinner fa-spin ml-2" style="display:none;"></i>
                </button>
            </form>

            <div class="text-center mt-4">
                Bạn chưa có tài khoản? <a href="@Url.Action("Register", "Account")">Đăng ký ngay</a>
            </div>
        </div>

        
    </div>
</body>
</html>

@section scripts {
    <script src="~/Content/assets/js/DangNhap.js?v=@DateTime.Now.Ticks"></script>
}
