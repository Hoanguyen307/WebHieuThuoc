@model Models.LoginViewModel
@{
    ViewBag.Title = "Đăng Nhập";
    Layout = null;

    var savedUserName = Request.Cookies["UserName"] != null ? Request.Cookies["UserName"].Value : "";
    var savedPassword = Request.Cookies["Password"] != null ? Common.EncryptionHelper.Decode(Request.Cookies["Password"].Value) : "";
    var rememberMeChecked = !string.IsNullOrEmpty(savedUserName) && !string.IsNullOrEmpty(savedPassword);
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <title>Đăng nhập</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet">

    <style>
        body {
            background-color: #f5f5f5;
            font-family: 'Segoe UI', sans-serif;
        }

        .login-container {
            max-width: 900px;
            margin: 60px auto;
            background: #fff;
            display: flex;
            border-radius: 12px;
            overflow: hidden;
            box-shadow: 0 5px 20px rgba(0,0,0,0.1);
        }

        .login-left, .login-right {
            flex: 1;
            padding: 40px;
        }

            .login-left h2 {
                font-weight: bold;
                margin-bottom: 10px;
            }

            .login-left p {
                color: #555;
                margin-bottom: 30px;
            }

        .form-control {
            border-radius: 8px;
        }

        .btn-login {
            background-color: black;
            color: white;
            border-radius: 30px;
            font-weight: bold;
            width: 100%;
            padding: 10px;
        }

        .login-right {
            background: url('https://file.hstatic.net/200000722513/file/abbw_cua_hang_002_209009d3b9ea42dcbef63c2b0e4108e2.jpg') center center / cover no-repeat;
            color: white;
            position: relative;
            display: flex;
            align-items: center;
            justify-content: center;
            text-align: center;
        }

            .login-right .overlay {
                background-color: rgba(0, 0, 0, 0.4);
                padding: 30px;
                border-radius: 12px;
            }

            .login-right h4 {
                font-weight: bold;
            }

        .btn-register {
            margin-top: 20px;
            border: 2px solid white;
            background-color: transparent;
            color: white;
            border-radius: 30px;
            padding: 8px 30px;
            font-weight: bold;
        }

        a {
            color: #007bff;
            text-decoration: none;
        }

            a:hover {
                text-decoration: underline;
            }
    </style>
</head>
<body>
    <div class="login-container">
        <!-- Left: Login Form -->
        <div class="login-left">
            <h2>Đăng nhập</h2>
            <p>Quý khách đăng nhập tài khoản để xem Điểm & hạng thành viên</p>

            <form method="post" action="@Url.Action("Login", "Account")">
                @Html.AntiForgeryToken()
                <div class="form-group">
                    <div class="input-group">
                        <div class="input-group-prepend">
                            <span class="input-group-text bg-white">
                                <i class="fas fa-user"></i>
                            </span>
                        </div>
                        <input type="text" class="form-control" name="PhoneNumber" placeholder="Tài khoản" required />
                    </div>
                </div>

                <!-- Mật khẩu -->
                <div class="form-group">
                    <div class="input-group">
                        <div class="input-group-prepend">
                            <span class="input-group-text bg-white">
                                <i class="fas fa-lock"></i>
                            </span>
                        </div>
                        <input type="password" class="form-control" name="Password" placeholder="Mật khẩu" required />
                    </div>
                </div>

                <div class="form-group text-right">
                    <a href="#">Quên mật khẩu?</a>
                </div>

                <button type="submit" class="btn btn-login">ĐĂNG NHẬP</button>
            </form>

            <div class="text-center mt-4">
                Bạn chưa có tài khoản? <a href="@Url.Action("Register", "Account")">Đăng ký ngay</a>
            </div>
        </div>

        <!-- Right: Register Prompt -->
        <div class="login-right">
            <div class="overlay">
                <h4>KHÁCH HÀNG MỚI</h4>
                <p>Tạo tài khoản của bạn và tận hưởng những lợi ích trực tuyến độc quyền từ chúng tôi!</p>
                <a href="@Url.Action("Register", "Account")" class="btn btn-register">ĐĂNG KÝ</a>
            </div>
        </div>
    </div>
</body>
</html>


@section scripts {
    <script src="~~/Content/assets/js/DangNhap.js?v=@DateTime.Now.Ticks"></script>
}
