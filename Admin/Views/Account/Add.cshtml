<form id="form-addNguoiDung" autocomplete="off">
    @Html.HiddenFor(m => m.Id)
    @*<input type="hidden" id="Id" value=" @Model.Id" />*@
    <div class="modal-body" style="color:black">
        <div class="form-group row">
            <label>Tên Đăng Nhập</label>
            <input type="text" class="form-control" id="UserName" name="UserName" placeholder="Tên đăng nhập" value="@Model.UserName" autocomplete="off" />
        </div>
        <div class="form-group row">
            <label>Họ và tên</label>
            <input type="text" class="form-control" id="FullName" name="FullName" value="@Model.FullName" placeholder="Họ và tên" />
        </div>
        <div class="form-group row">
            <label>Mật Khẩu</label>
            <input type="password" class="form-control" id="Password" name="Password" value="@Model.Password" placeholder="Mật khẩu" autocomplete="off" />
        </div>
        <div class="form-group row">
            <label>Email</label>
            <input type="email" class="form-control" id="Email" name="Email" value="@Model.Email" placeholder="Email" />
        </div>
        <div class="form-group row">
            <label>Số điện thoại</label>
            <input type="text" class="form-control" id="Phone" name="Phone" value="@Model.Phone" placeholder="Phone" />
        </div>@*
        <div class="form-group row">
            <label>Quyền</label>
            <select class="form-control" id="Role" name="Role">
                <option value="">-- Chọn quyền --</option>
                @if (ViewBag.Role != null)
                {
                    foreach (var item in ViewBag.Role as SelectList)
                    {
                        var selectedRole = ViewBag.RoleId != null ? ViewBag.RoleId.ToString() : "";
                        <option value="@item.Value" @(item.Value.ToString() == selectedRole ? "selected" : "")>@item.Text</option>
                    }
                }
            </select>
        </div>*@

        @*<div class="form-group row">
            <label>Quyền</label>
