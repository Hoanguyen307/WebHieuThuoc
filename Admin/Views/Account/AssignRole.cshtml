@model List<Models.AssignRoleViewModel>
@{
    ViewBag.Title = "Quản lý phân quyền";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var Stt = 1;
}

<div class="main-content">
    <div class="page-content">
        <div class="container-fluid">
            <div class="row">
                <div class="col">
                    <h3>Danh sách phân quyền</h3>
                    <div class="main_content form-row d-flex justify-content-center">
                        @using (Html.BeginForm())
                        {
                            @Html.AntiForgeryToken()
                            <table class="table table-bordered table-striped">
                                <thead>
                                    <tr>
                                        <th>Tên đăng nhập</th>
                                        <th>Họ và tên</th>
                                        <th>Quyền hiện tại</th>
                                        <th>Chọn quyền mới</th>
                                        <th>Thao tác</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var user in Model)
                                    {
                                        <tr>
                                            <td>@user.UserName</td>
                                            <td>@user.FullName</td>
                                            <td>@user.Role</td>
                                            <td>
                                                @Html.DropDownList("Role_" + user.UserId, ViewBag.AllRoles as SelectList, "-- Chọn quyền --", new { @class = "form-control" })
                                            </td>
                                            <td>
                                                <button class="btn btn-primary btn-update-role" data-userid="@user.UserId">Lưu</button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <script>
        $(document).ready(function () {
            $(".btn-update-role").click(function (e) {
                e.preventDefault();
                var userId = $(this).data("userid");
                var selectedRole = $("#Role_" + userId).val();

                if (!selectedRole) {
                    toastr.error("Vui lòng chọn quyền!");
                    return;
                }

                $.ajax({
                    url: '/Account/AssignRole',
                    type: 'POST',
                    data: {
                        UserId: userId,
                        role: selectedRole,
                        __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                    },
                    dataType: 'json', 
                    success: function (res) {
                        if (res.code === 200) {
                            toastr.success(res.msg || "Cập nhật thành công");
                            location.reload();
                        } else {
                            toastr.error(res.msg || "Cập nhật thất bại");
                        }
                    },
                    error: function (xhr) {
                        toastr.error("Lỗi kết nối server: " + xhr.status);
                    }
                });


            });
        });
    </script>
}

