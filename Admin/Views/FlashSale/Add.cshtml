@model Models.FlashSale
@{
    ViewBag.Title = Model.Id > 0 ? "Cập nhật Flash Sale" : "Thêm mới Flash Sale";
    bool isEdit = Model.Id > 0;
    string actionUrl = isEdit ? Url.Action("Update", "FlashSale") : Url.Action("Add", "FlashSale");

    // Gợi ý tự động tạo tiêu đề flash sale nếu thêm mới
    string autoTitle = !isEdit && string.IsNullOrEmpty(Model.Title)
        ? $"FlashSale-{DateTime.Now:yyyyMMddHHmmss}"
        : Model.Title;
}

<form id="form-addFlashSale" autocomplete="off">
    @Html.HiddenFor(m => m.Id)

    <div class="modal-body" style="color:black">
        <div class="form-group row">
            <label>Tiêu đề Flash Sale</label>
            <input type="text" class="form-control" id="Title" name="Title" value="@autoTitle" placeholder="Nhập tiêu đề Flash Sale" />
        </div>

        <div class="form-group row">
            <label>Thời gian bắt đầu</label>
            <input type="datetime-local" class="form-control" id="StartTime" name="StartTime"
                   value="@(Model.StartTime != DateTime.MinValue ? Model.StartTime.ToString("yyyy-MM-ddTHH:mm") : "")" />
        </div>

        <div class="form-group row">
            <label>Thời gian kết thúc</label>
            <input type="datetime-local" class="form-control" id="EndTime" name="EndTime"
                   value="@(Model.EndTime != DateTime.MinValue ? Model.EndTime.ToString("yyyy-MM-ddTHH:mm") : "")" />
        </div>

        <div class="form-group row">
            <label>% Giảm giá (áp dụng cho tất cả SP)</label>
            <input type="number" min="0" max="100" class="form-control" id="DiscountPercent" name="DiscountPercent"
                   value="@(Model.DiscountPercent ?? 0)" placeholder="Nhập % giảm (nếu có)" />
        </div>

        <div class="form-group row">
            <label>Số tiền giảm (áp dụng cho tất cả SP)</label>
            <input type="number" min="0" class="form-control" id="DiscountAmount" name="DiscountAmount"
                   value="@(Model.DiscountAmount ?? 0)" placeholder="Nhập số tiền giảm (nếu có)" />
        </div>

        <div class="form-group row">
            <div class="form-check">
                <input type="hidden" name="IsActive" value="false" />
                <input type="checkbox" class="form-check-input" id="IsActive" name="IsActive" value="true" @(Model.IsActive ? "checked" : "") />
                <label class="form-check-label" for="IsActive">Kích hoạt chương trình</label>
            </div>
        </div>
    </div>

    <div class="modal-footer">
        <button type="button" class="btn btn-danger btn-sm" onclick="closeModal()">
            <i class="fas fa-times"></i> Đóng
        </button>
        <button type="button" onclick="SaveFlashSale()" class="btn btn-primary">
            <i class="fas fa-save"></i> Lưu
        </button>
    </div>
</form>
