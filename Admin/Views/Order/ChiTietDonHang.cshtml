@model Models.OrderDetail
@functions {
    public string getStatusBadgeClass(string status)
    {
        switch (status)
        {
            case "Hoàn thành": return "bg-success text-white";
            case "Hủy": return "bg-danger text-white";
            case "Chờ xác nhận": return "bg-warning text-dark";
            case "Đã xác nhận": return "bg-primary text-white";
            default: return "bg-info text-dark";
        }
    }
}

<div class="modal-header border-0 pb-0">
    <h4 class="modal-title fw-bold text-primary">
        <i class="fas fa-file-invoice me-2"></i>Chi tiết đơn hàng: <span class="text-dark">@Model.OrderCode</span>
    </h4>
    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
</div>

<div class="modal-body pt-4">
    <div class="row g-4 mb-5">
        <div class="col-md-4">
            <div class="info-card p-3 rounded-3 bg-light h-100">
                <label class="text-muted small text-uppercase fw-bold d-block mb-2">Khách hàng</label>
                <div class="d-flex align-items-start justify-content-start">
                    <div class="d-flex flex-column gap-2">

                        <div class="d-flex align-items-center">
                            <div class="avatar-sm bg-primary-light rounded-circle me-2 d-flex align-items-center justify-content-center" style="width: 24px; height: 24px;">
                                <i class="fas fa-user text-primary" style="font-size: 12px;"></i>
                            </div>
                            <span class="fw-bold fs-5 text-dark">@Model.FullName</span>
                        </div>

                        <div class="d-flex align-items-center">
                            <div class="avatar-sm bg-primary-light rounded-circle me-2 d-flex align-items-center justify-content-center" style="width: 24px; height: 24px;">
                                <i class="fas fa-map-marker-alt text-danger" style="font-size: 12px;"></i>
                            </div>
                            <span class="text-muted fw-bold">@Model.Address</span>
                        </div>

                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="info-card p-3 rounded-3 bg-light h-100">
                <label class="text-muted small text-uppercase fw-bold d-block mb-1">Trạng thái & Thanh toán</label>
                <div class="mb-2">
                    <span class="badge @getStatusBadgeClass(Model.Status) px-3 py-2">@Model.Status</span>
                </div>
                <div class="fw-bold fs-5 text-success">
                    @string.Format("{0:N0} đ", Model.LineTotal > 0 ? Model.LineTotal : (Model.TotalAmount > 0 ? Model.TotalAmount : 0))
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="info-card p-3 rounded-3 bg-light h-100">
                <label class="text-muted small text-uppercase fw-bold d-block mb-1">Thời gian đặt hàng</label>
                <div class="d-flex align-items-center">
                    <i class="far fa-clock me-2 text-muted"></i>
                    <span>@Model.CreatedDate</span>
                </div>
            </div>
        </div>
    </div>

    <h6 class="fw-bold mb-3 d-flex align-items-center">
        <i class="fas fa-shopping-basket me-2 text-primary"></i>Sản phẩm đã mua
    </h6>
    <div class="table-responsive rounded-3 border">
        <table class="table table-hover align-middle mb-0">
            <thead class="bg-light">
                <tr>
                    <th class="ps-3" style="width: 80px">Ảnh</th>
                    <th>Tên sản phẩm</th>
                    <th class="text-center">Số lượng</th>
                    <th class="text-end pe-3">Đơn giá</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.listProduct != null)
                {
                    foreach (var item in Model.listProduct)
                    {
                        <tr>
                            <td class="ps-3">
                                @* Ảnh vẫn lấy từ thuộc tính HinhAnh của dòng đó *@
                                <img src="@item.HinhAnh" class="rounded-2 border" style="width: 100px; height: 60px;" />
                            </td>
                            <td>
                                <div class="fw-bold text-dark">@item.TenThuoc</div>
                            </td>
                            <td class="text-center fw-bold">x @item.Quantity</td>

                            <td class="text-end pe-3 fw-bold">
                                @string.Format("{0:N0} đ", item.UnitPrice)
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    @if (!string.IsNullOrEmpty(Model.Note))
    {
        <div class="mt-4 p-3 bg-warning-light rounded-3 border border-warning border-opacity-25">
            <i class="fas fa-sticky-note me-2 text-warning"></i>
            <strong>Ghi chú đơn hàng:</strong>
            <span class="ms-1 text-muted">@Model.Note</span>
        </div>
    }
</div>

<div class="modal-footer border-0">
    <button type="button" class="btn btn-light px-4" data-bs-dismiss="modal">Đóng</button>
    <button type="button" class="btn btn-primary px-4"><i class="fas fa-print me-2"></i>In đơn hàng</button>
</div>


