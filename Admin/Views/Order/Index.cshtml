@model PagedList.IPagedList<Models.Order>
@{
    ViewBag.Title = "Danh sách đơn hàng";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section Styles {
    <link href="~/Content/assets/css/common.css" rel="stylesheet" />
}

<div class="container-wrapper" style=" display: flex; flex-direction: column;">
    <input type="hidden" id="Id" name="Id" />
    <div class="d-flex justify-content-between mb-3" style="padding: 70px 10px 0 260px;">
        <h4>Danh sách đơn hàng</h4>
        <div>
            <button class="btn btn-outline-success">Excel operations <i class="fa fa-download"></i></button>
            @*<button type="button" class="btn btn-primary" onclick="LoadForm()">
                    <i class="fas fa-plus"></i>
                    Thêm mới
                </button>*@
        </div>
    </div>
    <form id="filterForm" class="filter-form">

        <input type="text" class="form-control form-control-sm search-input"
               id="searchString" name="searchString"
               placeholder="Tìm kiếm..." />

        <!-- Tháng -->
        <select id="month" name="Month" class="form-select form-select-sm" style=" width: 95px !important;">
            <option value="">Tháng</option>
            @foreach (var m in ViewBag.Months as SelectList)
            {
                <option value="@m.Value">@m.Text</option>
            }
        </select>

        <!-- Năm -->
        <select id="year" name="Year" class="form-select form-select-sm" style=" width: 75px !important;">
            <option value="">Năm</option>
            @foreach (var y in ViewBag.Years as SelectList)
            {
                <option value="@y.Value">@y.Text</option>
            }
        </select>
        <select id="Status" name="Status" class="form-select form-select-sm" style=" width: 170px !important;">
            <option value="">Trạng thái đơn hàng</option>
            <option value="Chờ xác nhận">Chờ xác nhận</option>
            <option value="Đã xác nhận">Đã xác nhận</option>
            <option value="Đang xử lý">Đang xử lý</option>
            <option value="Hoàn thành">Hoàn thành</option>
            <option value="Hủy">Hủy</option>
        </select>
        <!-- Nút lọc -->
        <button class="btn btn-primary" type="submit" id="searchBtn">
            <i class="fa fa-search"></i> Lọc
        </button>
    </form>
    <div class="main-content" style="flex:1; overflow: auto;">
        <div style=" overflow-x: auto;">
            <table class="table table-striped table-bordered" style="width: 100%; table-layout: auto; white-space: nowrap;" id="ds-donhang">
                <thead class="thead-light">
                    <tr>
                        <th><input type="checkbox" id="SelectAll" /></th>
                        <th>STT</th>
                        <th>Mã đơn hàng</th>
                        <th>Tên khách hàng</th>
                        <th>Tổng tiền</th>
                        <th>Trạng thái</th>
                        <th>Ghi chú</th>
                        <th>Ngày dặt</th>
                        <th>Hành động</th>
                    </tr>
                </thead>
                <tbody id="donhang-body">
                </tbody>
            </table>
        </div>
        <div id="pagination" class="d-flex justify-content-end mt-2"></div>
    </div>
    <!-- Tabs chi tiết -->
    <div class="history-fixed">
        <ul class="nav nav-tabs" id="tabDonHang" role="tablist">
            <li class="nav-item">
                <a class="nav-link active" id="lichsu-tab" data-toggle="tab" href="#lichsu" role="tab">Chi tiết đơn hàng</a>
            </li>
            <li class="nav-item">
                <a class="nav-link" id="khac-tab" data-toggle="tab" href="#khac" role="tab">Thông tin khác</a>
            </li>
        </ul>

        <div class="tab-content mt-3" id="tabContentDonHang">
            <div class="tab-pane fade show active" id="lichsu" role="tabpanel">
                <table class="table table-striped table-bordered">
                    <thead class="thead-light">
                        <tr>
                            <th>STT</th>
                            <th>Mã đơn hàng</th>
                            <th>Sản phẩm</th>
                            <th>Số lượng</th>
                            <th>Giá gốc</th>
                            <th>Giảm giá</th>
                        </tr>
                    </thead>
                    <tbody id="lichSuBody">
                        <tr>
                            <td colspan="6" class="text-center">Vui lòng chọn đơn hàng</td>
                        </tr>
                    </tbody>
                </table>
            </div>
            <!-- Tab khác -->
            <div class="tab-pane fade" id="khac" role="tabpanel">
                <p>Thông tin khác...</p>
            </div>
        </div>
    </div>

</div>

@section Scripts {
    <script src="~/Content/assets/js/DonHang.js?v=(@DateTime.Now.Ticks)"></script>
}

