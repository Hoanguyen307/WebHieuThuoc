@model PagedList.IPagedList<Models.Order>
@{
    ViewBag.Title = "Danh sách đơn hàng";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section Styles {
    <link href="~/Content/assets/css/common.css" rel="stylesheet" />
}

<div class="container-wrapper" style=" display: flex; flex-direction: column;">
    <input type="hidden" id="Id" name="Id" />
    <div class="d-flex justify-content-between mb-3" style="padding: 70px 10px 0 260px;">
        <h4>Danh sách đơn hàng</h4>
        <div>
            <button class="btn btn-outline-success">Excel operations <i class="fa fa-download"></i></button>
            @*<button type="button" class="btn btn-primary" onclick="LoadForm()">
                    <i class="fas fa-plus"></i>
                    Thêm mới
                </button>*@
        </div>
    </div>
    <div class="input-group mb-3" style="width: 100%;padding: 0 10px 0 260px;">
        <input type="text" class="form-control" id="searchInput" placeholder="Tìm kiếm...">
        <button class="btn btn-primary" type="button" id="searchBtn">
            <i class="fa fa-search"></i>
        </button>
        <div id="filter-box" style="border: 1px solid #ddd;border-radius: 8px;background-color: #f9f9f9;box-shadow: 0 0 5px rgba(0,0,0,0.05);display: flex;align-items: center;gap: 10px;min-width: 210px;">
            <select id="month" class="form-select form-select-sm">
                <option value="">Tháng</option>
            </select>

            <select id="year" class="form-select form-select-sm">
                <option value="">Năm</option>
            </select>

        </div>
    </div>
    <div class="main-content" style="flex:1; overflow: auto;">
        <div style=" overflow-x: auto;">
            <table class="table table-striped table-bordered" style="width: 100%; table-layout: auto; white-space: nowrap;" id="ds-donhang">
                <thead class="thead-light">
                    <tr>
                        <th><input type="checkbox" id="SelectAll" /></th>
                        <th>STT</th>
                        <th>Mã đơn hàng</th>
                        <th>Tên khách hàng</th>
                        <th>Tổng tiền</th>
                        <th>Trạng thái</th>
                        <th>Ghi chú</th>
                        <th>Ngày dặt</th>
                        <th>Hành động</th>
                    </tr>
                </thead>
                <tbody id="donhang-body">
                    @if (Model != null && Model.Any())
                    {
                        var i = 1;
                        foreach (var item in Model)
                        {
                            <tr id="trow_@item.ID" onclick="loadLichSuDonHang(@item.ID)" style="cursor:pointer;">
                                <td></td>
                                <td>@i</td>
                                <td>@item.OrderCode</td>
                                <td>@item.CustomerName</td>
                                <td>@string.Format("{0:N0} đ", item.TotalAmount)</td>
                                <td>@item.Status</td>
                                <td>@item.Note</td>
                                <td>@(item.CreatedDate != null ? item.CreatedDate.Value.ToString("dd/MM/yyyy") : "")</td>
                                <td>
                                    <button type="button" class="btn btn-outline-primary btn-sm" onclick="handleFormUpdateNhanVien('@item.ID'); event.stopPropagation();"><i class="fas fa-edit"></i></button>
                                    <button type="button" class="btn btn-outline-danger btn-sm" onclick="handleDelete('@item.ID'); event.stopPropagation();"><i class="fas fa-trash-alt"></i></button>
                                </td>
                            </tr>
                            i++;
                        }
                    }
                </tbody>
            </table>
        </div>
        <div id="pagination" class="d-flex justify-content-end mt-2"></div>
    </div>
    <!-- Tabs chi tiết -->
    <div class="history-fixed">
        <ul class="nav nav-tabs" id="tabDonHang" role="tablist">
            <li class="nav-item">
                <a class="nav-link active" id="lichsu-tab" data-toggle="tab" href="#lichsu" role="tab">Chi tiết đơn hàng</a>
            </li>
            <li class="nav-item">
                <a class="nav-link" id="khac-tab" data-toggle="tab" href="#khac" role="tab">Thông tin khác</a>
            </li>
        </ul>

        <div class="tab-content mt-3" id="tabContentDonHang">
            <div class="tab-pane fade show active" id="lichsu" role="tabpanel">
                <table class="table table-striped table-bordered">
                    <thead class="thead-light">
                        <tr>
                            <th>STT</th>
                            <th>Mã đơn hàng</th>
                            <th>Sản phẩm</th>
                            <th>Số lượng</th>
                            <th>Giá gốc</th>
                            <th>Giảm giá</th>
                        </tr>
                    </thead>
                    <tbody id="lichSuBody">
                        <tr>
                            <td colspan="6" class="text-center">Vui lòng chọn đơn hàng</td>
                        </tr>
                    </tbody>
                </table>
            </div>
            <!-- Tab khác -->
            <div class="tab-pane fade" id="khac" role="tabpanel">
                <p>Thông tin khác...</p>
            </div>
        </div>
    </div>

</div>

@section Scripts {
    <script src="~/Content/assets/js/DonHang.js?v=(@DateTime.Now.Ticks)"></script>
}

