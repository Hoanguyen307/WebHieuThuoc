@model Models.Category
@{
    ViewBag.Title = "Thêm mới danh mục";
    bool isEdit = Model.ID > 0;
    string actionUrl = isEdit ? Url.Action("Update", "Category") : Url.Action("Add", "Category");
}

<form id="form-addDanhmuc" autocomplete="off" enctype="multipart/form-data">
    @Html.HiddenFor(m => m.ID)
    @*<input type="hidden" id="Id" value=" @Model.Id" />*@
    <div class="modal-body" style="color:black">
        <div class="form-group row">
            <label>Tên Danh Mục</label>
            <input type="text" class="form-control" id="Name" name="Name" placeholder="Tên danh mục" value="@Model.Name" autocomplete="off" />
        </div>
        <div class="form-group row">
            <label>Url</label>
            <input type="text" class="form-control" id="Slug" name="Slug" value="@Model.Slug" placeholder="Đường dẫn" />
        </div>
        <div class="form-group row">
            <label>Mô tả</label>
            <input type="text" class="form-control" id="Description" name="Description" value="@Model.Description" placeholder="Mô tả" autocomplete="off" />
        </div>
        @*<div class="form-group row">
                <label>Ảnh</label>
                <input type="file" class="form-control" id="ImageFile" name="ImageFile" accept="image/*" />
                @if (!string.IsNullOrEmpty(Model.Image))
                {
                    <div class="mt-2">
                        <p>Ảnh hiện tại:</p>
                        <img src="@Url.Content(Model.Image)" style="max-height: 100px; border: 1px solid #ccc; padding: 4px;" />
                    </div>
                    <input type="hidden" name="Image" value="@Model.Image" />
                }
            </div>*@
        <div class="form-group row">
            <label>Thứ tự</label>
            <input type="number" class="form-control" id="DisplayOrder" name="DisplayOrder" value="@Model.DisplayOrder" placeholder="Thứ tự" min="1"
                   step="1" />
        </div>
        <div class="form-group row">
            <div class="form-check">
                <input type="hidden" name="IsActive" value="false" />
                <input type="checkbox" class="form-check-input" id="IsActive" name="IsActive" value="true" @(Model.IsActive ? "checked" : "") />
                <label class="form-check-label" for="IsActive">Hiển thị danh mục</label>
            </div>
        </div>

    </div>
    <div class="modal-footer">
        <button type="button" class="btn btn-danger btn-sm" onclick="closeModal()" data-dismiss="modaldanhmuc"><i class="fas fa-times"></i> Đóng</button>
        <button type="button" onclick="SaveDanhMuc()" class="btn btn-primary"> <i class="fas fa-save"></i> Lưu</button>
    </div>
</form>

