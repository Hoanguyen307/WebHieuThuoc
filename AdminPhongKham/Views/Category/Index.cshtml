@model IEnumerable<Models.DichVuPhongKham>
@{
    ViewBag.Title = "Danh mục";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="main-content">
    <div class="page-content">
        <div class="container-fluid">
            <div class="row">
                <div class="col">
                    <h3>Danh sách danh mục</h3>
                    <button type="button" class="btn btn-outline-primary btn-sm" onclick="LoadForm()">
                        <i class="fas fa-plus"></i>
                        Thêm mới
                    </button>
                    <div class="main_content form-row d-flex justify-content-center">

                        <table class="table table-hover" id="ds-danhmuc">
                            <thead class="bg-primary text-white">
                                <tr>
                                    <th>STT</th>
                                    <th>Tên danh mục</th>
                                    <th>Mô tả</th>
                                    <th>Thứ tự</th>
                                    <th>Hành động</th>
                                </tr>
                            </thead>
                            <tbody id="danhmuc-body">
                                @if (Model != null && Model.Any())
                                {
                                    var i = 1;
                                    foreach (var item in Model)
                                    {
                                        <tr id="trow_@item.ID">
                                            <td>@i</td>
                                            <td>@item.Name</td>
                                            <td>@item.Description</td>
                                            <td>@item.DisplayOrder</td>
                                            <td>
                                                <button type="button" class="btn btn-outline-primary btn-sm" onclick="handleFormUpdateDanhMuc('@item.ID')"><i class="fas fa-edit"></i></button>
                                                <button type="button" class="btn btn-outline-danger btn-sm" onclick="handleDelete('@item.ID')"><i class="fas fa-trash-alt"></i></button>
                                            </td>
                                        </tr>
                                        i++;
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                    <div class="modal" id="modalDanhMuc" style="color:black">
                        <div class="modal-dialog modal-lg modal-dialog-scrollable" role="document">
                            <div class="modal-content">
                                <div class="modal-header">
                                    <h5 class="modal-title" id="modaldanhmucLabel">Thông tin Danh mục</h5>
                                    <button type="button" onclick="closeModal()" class="close" data-dismiss="modal" aria-label="Close">
                                        <span aria-hidden="true">&times;</span>
                                    </button>
                                </div>
                                <div class="modal-body" style="color: black">

                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
@section Scripts {

    <script src="~/Content/assets/js/Category.js?v=(@DateTime.Now.Ticks)"></script>
}

