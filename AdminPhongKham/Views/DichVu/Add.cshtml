@model Models.DichVu
@{
    ViewBag.Title = "Thêm mới dịch vụ";
    bool isEdit = Model.Id > 0;
    string actionUrl = isEdit ? Url.Action("Update", "DichVu") : Url.Action("Add", "DichVu");
}

<form id="form-addDichVu" autocomplete="off" enctype="multipart/form-data">
    @Html.HiddenFor(m => m.Id)
    @*<input type="hidden" id="Id" value=" @Model.Id" />*@
    <div class="modal-body" style="color:black">
        <div class="form-group row">
            <label>Tên dịch vụ</label>
            <input type="text" class="form-control" id="TenDichVu" name="TenDichVu" placeholder="Tên dịch vụ" value="@Model.TenDichVu" autocomplete="off" />
        </div>
        <div class="form-group row">
            <label>Mô tả</label>
            <input type="text" class="form-control" id="MoTa" name="MoTa" value="@Model.MoTa" placeholder="Mô tả" autocomplete="off" />
        </div>
        <div class="form-group row">
            <label>Giá</label>
            <input type="text" class="form-control" id="Gia" name="Gia" value="@Model.Gia" placeholder="Giá" autocomplete="off" />
        </div>
        <div class="form-group row">
            <label>Thời gian</label>
            <input type="text" class="form-control" id="ThoiGian" name="ThoiGian" value="@Model.ThoiGian" placeholder="Thời gian" autocomplete="off" /> 
        </div>
        <div class="form-group row">
            <label>Danh mục</label>
            @Html.DropDownListFor(m => m.DanhMucId, (SelectList)ViewBag.DichVuPhongKhams, "-- Chọn danh mục --", new { @class = "form-control" })
        </div>
        <div class="form-group row">
            <label>Ảnh</label>
            <input type="file" class="form-control" id="ImageFile" name="ImageFile" accept="image/*" />
            @if (!string.IsNullOrEmpty(Model.HinhAnh))
            {
                <div class="mt-2">
                    <p>Ảnh hiện tại:</p>
                    <img src="@Url.Content(Model.HinhAnh)" style="max-height: 100px; border: 1px solid #ccc; padding: 4px;" />
                </div>
                <input type="hidden" name="HinhAnh" value="@Model.HinhAnh" />
            }
        </div>
        <div class="form-group row">
            <div class="col-6">
                <div class="form-check">
                    <input type="hidden" name="IsActive" value="false" />
                    <input type="checkbox" class="form-check-input" id="IsActive" name="IsActive" value="true" @(Model.IsActive ? "checked" : "") />
                    <label class="form-check-label" for="IsActive">Hiển thị danh mục</label>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-footer">
        <button type="button" class="btn btn-danger btn-sm" onclick="closeModal()" data-dismiss="modaldichvu"><i class="fas fa-times"></i> Đóng</button>
        <button type="button" onclick="SaveDichVu()" class="btn btn-primary"> <i class="fas fa-save"></i> Lưu</button>
    </div>
</form>

